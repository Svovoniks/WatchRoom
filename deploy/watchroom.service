[Unit]
Description=Watchroom room service
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/watchroom/watchroom.env
Environment=WATCHROOM_DATA=/var/lib/watchroom DOTNET_gcServer=0 DOTNET_GCHeapHardLimit=0xC000000
ExecStart=/usr/bin/dotnet /opt/watchroom/Watchroom.Server.dll --urls http://127.0.0.1:5080
DynamicUser=yes
StateDirectory=watchroom
Restart=on-failure
RestartSec=3s
MemoryMax=300M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
