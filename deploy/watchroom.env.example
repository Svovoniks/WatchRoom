# Copy to /etc/watchroom/watchroom.env (mode 600, owned by root). Never commit the real file.
# Cloudflare Realtime TURN key: Cloudflare dashboard > Realtime > TURN Server.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Set to true only to test relay-only connections.
WATCHROOM_FORCE_RELAY=false
