          <Border VerticalAlignment="Bottom" Padding="10,22,10,9" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#E0000000" Offset="0.55"/></LinearGradientBrush></Border.Background><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMovie}" Value="True"/><Condition Binding="{Binding HasPlaybackProgress}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding PlaybackLabel}" Foreground="#F4F4F7" FontSize="12" FontWeight="SemiBold"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Background="#40FFFFFF" Margin="0,6,0,0"/></StackPanel></Border>
           <!-- A selected card: dimmed artwork with an accent edge and a check. -->
           <Grid IsHitTestVisible="False"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Rectangle RadiusX="12" RadiusY="12" Fill="#66000000" Stroke="{DynamicResource Accent}" StrokeThickness="3"/><Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
         </Grid>
        </Border>
        <TextBlock x:Name="CardTitle" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="2,10,2,3"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="MaxHeight" Value="40"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
