   <!-- Title details -->
   <!-- The viewport reaches 8px left of the content so outlines pulled flush with the page edge are not clipped. -->
   <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="-8,0,0,0"><Grid Margin="8,0,0,0">
    <StackPanel MaxWidth="1100" Margin="0,0,8,0">
     <DockPanel Margin="-8,0,0,24"><Button DockPanel.Dock="Right" Content="{Binding Content, ElementName=BrowseWithGuestButton}" Visibility="{Binding Visibility, ElementName=BrowseWithGuestButton}" Click="BrowseWithGuest" Margin="12,0,0,0"/><ItemsControl x:Name="DetailBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Video location"/></DockPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- Layered translucent frames approximate CardShadow without re-running a blur effect while the page scrolls. -->
      <Grid VerticalAlignment="Top">
      <Border Margin="-9,-3,-9,-15" CornerRadius="21" Background="#0A000000" IsHitTestVisible="False"/>
      <Border Margin="-6,-1,-6,-11" CornerRadius="18" Background="#0F000000" IsHitTestVisible="False"/>
      <Border Margin="-3,1,-3,-7" CornerRadius="15" Background="#14000000" IsHitTestVisible="False"/>
      <Border Margin="-1,3,-1,-4" CornerRadius="13" Background="#1A000000" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource Elevated}" CornerRadius="12">
       <Border CornerRadius="12" local:RoundedClip.Radius="12">
        <Grid><Grid Width="230" Height="340"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=DetailPoster}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="190" Margin="16"><TextBlock Text="&#xE714;" Style="{StaticResource EmptyStateIcon}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Text, ElementName=DetailTitle}" FontSize="19" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/></StackPanel></Grid><Image x:Name="DetailPoster" Stretch="Uniform" MaxWidth="400" MaxHeight="345"/></Grid>
       </Border>
      </Border>
      </Grid>
      <StackPanel Grid.Column="1" Margin="32,6,0,0">
       <TextBlock x:Name="DetailContext" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <TextBlock x:Name="DetailMeta" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,24"/>
       <!-- The file's audio and subtitles, with languages identified for tracks the file doesn't tag. -->
       <Grid x:Name="DetailTracks" Visibility="Collapsed" Margin="0,-12,0,22" MaxWidth="720" HorizontalAlignment="Left" AutomationProperties.Name="Audio and subtitles">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Audio" Style="{StaticResource MutedText}" FontSize="14" FontWeight="SemiBold" Margin="0,0,14,4"/>
        <TextBlock x:Name="DetailAudio" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.Name="Audio tracks"/>
        <TextBlock Grid.Row="1" Text="Subtitles" Style="{StaticResource MutedText}" FontSize="14" FontWeight="SemiBold" Margin="0,0,14,0"/>
        <TextBlock x:Name="DetailSubtitles" Grid.Row="1" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" AutomationProperties.Name="Subtitle tracks"/>
       </Grid>
       <!-- One pill per release of this episode, such as a colour and a black-and-white version; the chosen one is highlighted. -->
       <WrapPanel x:Name="DetailVersions" Visibility="Collapsed" Margin="0,-10,0,16" AutomationProperties.Name="Versions"/>
       <WrapPanel><Button x:Name="DetailPlay" Content="Play locally" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="20,8" Click="PlayLocal"/><Button x:Name="RestartButton" Content="Start over" Click="RestartLocal" Visibility="Collapsed"/><Button x:Name="DetailHost" Content="Watch together" ContentTemplate="{StaticResource PeopleContent}" Click="HostClick"/><Button x:Name="DetailQueue" Content="Add to queue" ContentTemplate="{StaticResource AddContent}" Click="QueueClick"/><Button x:Name="DetailWatched" Click="ToggleDetailWatched" ToolTip="Mark as watched" AutomationProperties.Name="Mark as watched"><StackPanel Orientation="Horizontal"><TextBlock x:Name="DetailWatchedIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/><TextBlock x:Name="DetailWatchedText" Text="Mark as watched" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DetailRemove" Content="Remove from library" Click="RemoveUnavailableVideo" Visibility="Collapsed" ToolTip="Remove the saved entry for this unavailable video"/><Button x:Name="DetailAcquire" Content="Acquire" ContentTemplate="{StaticResource DownloadContent}" Click="AcquireDetailClick" Visibility="Collapsed" ToolTip="Ask an acquisition plugin to get this video" AutomationProperties.Name="Acquire"/></WrapPanel>
       <Border Visibility="{Binding Visibility, ElementName=DetailAvailability}" HorizontalAlignment="Left" CornerRadius="10" BorderBrush="{DynamicResource Danger}" BorderThickness="1" Margin="0,8,0,12"><Grid><Border Background="{DynamicResource Danger}" Opacity="0.14" CornerRadius="9"/><DockPanel Margin="12,9,14,9"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Danger}" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"/><TextBlock x:Name="DetailAvailability" Visibility="Collapsed" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></Grid></Border>
       <ContentControl x:Name="WantedDetailPanel" Visibility="Collapsed" Focusable="False" Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
       <TextBlock x:Name="DetailSummary" Margin="0,16,0,0" Style="{StaticResource MutedText}" FontSize="15" LineHeight="24" MaxWidth="720" HorizontalAlignment="Left"/>
       <ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      </StackPanel>
     </Grid>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,32,0,16" Padding="0,12,0,0">
      <StackPanel Margin="-6,0,0,0">
       <!-- The clips that came with a film, and from a clip the film and its other clips. -->
