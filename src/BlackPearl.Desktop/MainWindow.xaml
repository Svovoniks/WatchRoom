<Window x:Class="BlackPearl.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BlackPearl.Desktop" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Style="{StaticResource {x:Type Window}}" Title="BlackPearl" Icon="Assets/BlackPearl.ico" Width="1280" Height="850" MinWidth="900" MinHeight="640" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" Closing="WindowClosing" PreviewKeyDown="KeyPressed" PreviewKeyUp="KeyReleased">
 <!-- The app draws its own caption row; WindowChrome keeps native drag, resize and snap behaviour. -->
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Grid x:Name="WindowRoot" Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="40"/><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="30"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="212" x:Name="RailWidth"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <Border x:Name="Rail" Grid.RowSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="12">
    <!-- The sidebar toggle stays in one spot, open or folded: the top-left corner, as far from the top as from the side, over
         the column of icons and the size of one, in the caption area (so it takes clicks from the window frame). The logo sits
         beside it with the name while the sidebar is open, and slides under it as the sidebar folds (SideRail.cs). The header
         sits outside the scrolling part so scrolling never moves it. -->
    <Grid x:Name="RailHeader" DockPanel.Dock="Top" Margin="0,0,0,20">
     <Button x:Name="RailToggle" Style="{StaticResource QuietIcon}" Content="&#xE90C;" Click="ToggleRailClick" Width="40" Height="40" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Collapse sidebar (Ctrl+B)" AutomationProperties.Name="Collapse sidebar"/>
     <StackPanel x:Name="RailBrand" Orientation="Horizontal" Height="40" Margin="42,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Image x:Name="RailLogo" Source="Assets/BlackPearl.png" Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.Name="BlackPearl"/>
      <!-- The name is set in a serif, like a jeweller's mark, apart from the interface type around it. -->
      <TextBlock x:Name="RailBrandName" Text="BlackPearl" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Margin="9,0,0,2" VerticalAlignment="Center" Style="{StaticResource NavigationLabel}"/>
     </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
     <Button x:Name="NowPlayingButton" Tag="Room" Click="Navigate" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" HorizontalContentAlignment="Stretch" Padding="12,10" Margin="0,0,0,8" ToolTip="Return to the current video" AutomationProperties.Name="Return to player">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Accent}" VerticalAlignment="Center"><TextBlock Text="&#xF5B0;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" Margin="2,0,0,0"/></Border>
       <StackPanel x:Name="NowPlayingText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Return to player" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="NowPlayingLabel" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
      </Grid>
     </Button>
     <Button x:Name="SettingsNav" Tag="Settings" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Settings" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
    </StackPanel>
    <!-- The navigation scrolls when the window is too short for it, so Settings and the player stay in view. -->
    <!-- The scroll bar overlays the rail's 12 DIP right padding instead of taking a column, so the buttons keep their width when it appears. -->
    <ScrollViewer x:Name="RailScroll" Margin="0,0,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
     <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><Grid>
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>
      <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="12" MinWidth="0" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
     </Grid></ControlTemplate></ScrollViewer.Template>
     <StackPanel x:Name="RailNavigation" Margin="0,0,12,0">
       <Button x:Name="HomeNav" Tag="Home" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Home"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Home" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
       <Button x:Name="SearchNav" Tag="Search" Click="SearchNavClick" Style="{StaticResource Navigation}" ToolTip="Search and filter your library (Ctrl+F)" AutomationProperties.Name="Search"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Search" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
       <!-- The library's categories are the bar at the top of the Library page. -->
       <Button x:Name="LibraryNav" Tag="Library" Click="LibraryNavClick" Style="{StaticResource Navigation}" AutomationProperties.Name="Library"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Library" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
       <!-- Music sits beside the video library rather than in it; listed once a folder is a Music folder or the library holds music. -->
       <Button x:Name="MusicLibraryNav" Tag="6" Click="LibraryCategoryClick" Style="{StaticResource Navigation}" Visibility="Collapsed" AutomationProperties.Name="Music"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Music" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
       <!-- What you watch together sits apart from your own library. -->
       <Button x:Name="QueuesNav" Tag="Queues" Click="Navigate" Style="{StaticResource Navigation}" Margin="0,14,0,2" AutomationProperties.Name="Queues"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Queues" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
       <Button x:Name="RoomNav" Tag="Rooms" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Watch rooms"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Watch rooms" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <!-- Blurred artwork behind title details: spans the whole content column and fades downward. -->
  <!-- Pre-blurred artwork and a canvas-coloured fade keep this layer free of per-repaint effects and masks. -->
  <Grid Grid.Column="1" Grid.RowSpan="2" Height="600" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=Details}">
   <Image Source="{Binding Source, ElementName=DetailPoster, Converter={StaticResource DetailBackdrop}}" Stretch="UniformToFill" Margin="-90" RenderOptions.BitmapScalingMode="Linear"/>
   <Rectangle Fill="{DynamicResource BackdropFade}"/>
  </Grid>

  <!-- A black pearl, the app's logo, is strung on the sidebar's edge beside the current page and rolls along it to the next
       one (SideRail.cs). It overhangs the page, so it lies above the backdrop but below the page content. Its sheen and glow
       take the theme accent. -->
  <Canvas x:Name="RailPearlLayer" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=Rail}">
   <Grid x:Name="RailPearl" Width="15" Height="15" Visibility="Hidden">
    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <!-- The pearl's glow is a soft halo drawn as a gradient: a blur effect looked the same but slowed the library's first layout. -->
    <Ellipse Margin="-9" Opacity="0.5" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentColor}" Offset="0.3"/><GradientStop Color="{DynamicResource AccentClear}" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
    <ContentControl Style="{StaticResource Pearl}"/>
   </Grid>
  </Canvas>
  <Grid Grid.Column="1" Grid.Row="1" Margin="28,6,28,16" x:Name="ContentArea">

   <!-- Home -->
   <ScrollViewer x:Name="HomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <ScrollViewer.Resources>
     <!-- A plain clickable surface: hover lifts the artwork and outlines it in the accent colour. -->
     <Style x:Key="HomeTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,14,0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></ControlTemplate></Setter.Value></Setter>
     </Style>
     <Style x:Key="HomeArtwork" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Elevated}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="local:RoundedClip.Radius" Value="10"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <!-- Each frame declares its own TranslateTransform: a transform shared through a style setter is frozen and cannot animate. -->
      <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
       <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-6" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
       <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
      </DataTrigger></Style.Triggers>
     </Style>
     <!-- Accent outline that fades in over hovered artwork; drawn inside the frame so its corners match the clip. -->
     <Style x:Key="HoverRing" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/>
      <!-- Hidden while idle, so dozens of transparent outlines cost nothing to repaint while scrolling. -->
      <Setter Property="Visibility" Value="Hidden"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
       <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/></ObjectAnimationUsingKeyFrames><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
       <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/><ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0.28" Value="{x:Static Visibility.Hidden}"/></ObjectAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
      </DataTrigger></Style.Triggers>
     </Style>
     <Style x:Key="CardBack" TargetType="Border">
      <Setter Property="Width" Value="128"/><Setter Property="Height" Value="190"/><Setter Property="CornerRadius" Value="11"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentEdge}"/><Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
     </Style>
     <DataTemplate x:Key="HomePill">
      <Button Click="OpenHomeCard" Loaded="HomeItemLoaded" Style="{StaticResource HomeTile}" Margin="0,0,8,8" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}">
       <Border x:Name="PillFrame" Background="{DynamicResource Elevated}" CornerRadius="9" Padding="6">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="36" Height="52" CornerRadius="5" local:RoundedClip.Radius="5" Background="{DynamicResource Line}"><Image Source="{Binding Poster, NotifyOnTargetUpdated=True}" TargetUpdated="HomeArtworkUpdated" Stretch="UniformToFill" Loaded="HomeArtworkLoaded"/></Border>
         <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding HomeTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding HomeDetail}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          <ProgressBar Height="3" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,7,0,0" Style="{StaticResource CardProgress}"/>
         </StackPanel>
        </Grid>
       </Border>
      </Button>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter TargetName="PillFrame" Property="Background" Value="{DynamicResource Hover}"/></DataTrigger></DataTemplate.Triggers>
     </DataTemplate>
     <DataTemplate x:Key="HomeTilePoster">
      <Button Click="OpenHomeCard" Loaded="HomeItemLoaded" Style="{StaticResource HomeTile}" Width="140" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}">
       <StackPanel>
        <Border Height="210" Style="{StaticResource HomeArtwork}"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
         <Grid><TextBlock Text="{Binding DisplayTitle}" Margin="12" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><Image Source="{Binding Poster, NotifyOnTargetUpdated=True}" TargetUpdated="HomeArtworkUpdated" Stretch="UniformToFill" Loaded="HomeArtworkLoaded"/><Border Style="{StaticResource HoverRing}" CornerRadius="9"/></Grid>
        </Border>
        <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,9,2,1"/>
        <TextBlock Text="{Binding HomeDetail}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="2,0"/>
       </StackPanel>
      </Button>
     </DataTemplate>
     <!-- One category of recommendations: a wide spotlight title, then posters. -->
     <DataTemplate x:Key="HomeRowTemplate">
      <Grid Margin="0,0,0,30" Visibility="{Binding Visibility}">
       <!-- A brush, not an Image: an Image would size the row from its own aspect ratio. -->
       <!-- One pre-faded image whose edges melt into the next row; layered gradients would repaint on every scroll frame. -->
       <Canvas IsHitTestVisible="False"><Image Source="{Binding Spotlight.Poster, Converter={StaticResource RowBackdrop}}" Width="720" Height="380" Stretch="Fill" Canvas.Top="-40" RenderOptions.BitmapScalingMode="LowQuality"/></Canvas>
       <StackPanel>
        <DockPanel Margin="0,0,0,12">
         <Button DockPanel.Dock="Right" Click="OpenHomeCategory" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Accent}" Padding="8,4" MinHeight="0" Margin="10,0,0,0" AutomationProperties.Name="{Binding OpenLabel}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="Open in library" FontSize="12.5"/><TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Margin="6,1,0,0"/></StackPanel></Button>
         <Button DockPanel.Dock="Right" Click="ReshuffleHomeRow" Style="{StaticResource QuietButton}" Padding="8,4" MinHeight="0" Margin="0" AutomationProperties.Name="{Binding ReshuffleLabel}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,6,0"/><TextBlock Text="New suggestions" FontSize="12.5"/></StackPanel></Button>
         <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
         <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,0,0,3" VerticalAlignment="Bottom"/>
        </DockPanel>
        <local:HorizontalScroller Padding="0,6,0,4" ArrowCenter="111">
         <StackPanel Orientation="Horizontal">
          <Button Click="OpenHomeCard" DataContext="{Binding Spotlight}" DataContextChanged="HomeSpotlightChanged" Loaded="HomeItemLoaded" Style="{StaticResource HomeTile}" Width="400" Height="210" VerticalAlignment="Top" VerticalContentAlignment="Stretch" Margin="0,0,16,0" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}">
           <Border Style="{StaticResource HomeArtwork}" CornerRadius="12" local:RoundedClip.Radius="12"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Grid>
             <Image Source="{Binding Poster, Converter={StaticResource DetailBackdrop}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
             <Image Source="{Binding Poster, NotifyOnTargetUpdated=True}" TargetUpdated="HomeArtworkUpdated" Stretch="UniformToFill" Width="250" HorizontalAlignment="Right" Loaded="HomeArtworkLoaded"/>
             <Rectangle Fill="{DynamicResource HeroFade}"/>
             <Border Style="{StaticResource HoverRing}" CornerRadius="11"/>
             <DockPanel Margin="18,16,18,16">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
               <Button Content="Play" Click="PlayHomeCard" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="14,0" MinHeight="32" Height="32" Margin="0,0,6,0" AutomationProperties.Name="{Binding DisplayTitle, StringFormat=Play {0}}"/>
               <Button Content="&#xE946;" Click="OpenHomeCard" Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" Margin="0" ToolTip="Details" AutomationProperties.Name="{Binding DisplayTitle, StringFormat=Details for {0}}"/>
              </StackPanel>
              <StackPanel MaxWidth="250" HorizontalAlignment="Left">
               <Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding HomeTagVisibility}"><TextBlock Text="{Binding HomeTag}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></Border>
               <TextBlock Text="{Binding DisplayTitle}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
               <TextBlock Text="{Binding HomeDetail}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
               <TextBlock Text="{Binding Card.Media.DetailOverview}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
              </StackPanel>
             </DockPanel>
            </Grid>
           </Border>
          </Button>
          <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource HomeTilePoster}" AutomationProperties.Name="{Binding Label}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
         </StackPanel>
        </local:HorizontalScroller>
       </StackPanel>
      </Grid>
     </DataTemplate>
    </ScrollViewer.Resources>
    <StackPanel Margin="0,0,8,0">
     <TextBlock x:Name="HomeStatus" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>

     <!-- Hero: the title watched most recently, ready to resume. -->
     <Border x:Name="HomeHero" Height="340" CornerRadius="14" local:RoundedClip.Radius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,16" Visibility="Collapsed">
      <Grid>
       <Image Source="{Binding Poster, Converter={StaticResource DetailBackdrop}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
       <Image Source="{Binding Poster, NotifyOnTargetUpdated=True}" TargetUpdated="HomeArtworkUpdated" Stretch="UniformToFill" HorizontalAlignment="Right" Width="620" Loaded="HomeArtworkLoaded"/>
       <Rectangle Fill="{DynamicResource HeroFade}"/>
       <StackPanel Margin="34,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="500">
        <TextBlock x:Name="HomeHeroKicker" FontSize="13" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="HomeHeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis" LineHeight="50" LineStackingStrategy="BlockLineHeight"/>
        <TextBlock x:Name="HomeHeroOverview" Style="{StaticResource MutedText}" Margin="0,10,0,0" MaxHeight="63" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Height="4" Width="300" HorizontalAlignment="Left" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,16,0,18" Style="{StaticResource CardProgress}"/>
        <StackPanel Orientation="Horizontal">
         <Button x:Name="HomeHeroResume" Content="Resume" Click="PlayHomeCard" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="20,8"/>
         <Button Content="Details" Click="OpenHomeCard" AutomationProperties.Name="{Binding DisplayTitle, StringFormat=Details for {0}}"/>
        </StackPanel>
       </StackPanel>
      </Grid>
     </Border>
     <StackPanel x:Name="HomeIntro" Margin="0,0,0,22">
      <TextBlock Text="Home" Style="{StaticResource PageHeading}"/>
      <TextBlock x:Name="HomeContinueEmpty" Text="Your unfinished movies and shows will appear here once you start watching." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
     </StackPanel>

     <!-- Everything else in progress, newest first. -->
     <Border x:Name="HomeStrip" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="10,8,4,0" Margin="0,0,0,18" SizeChanged="HomeStripResized">
      <DockPanel>
       <StackPanel DockPanel.Dock="Left" Width="104" Margin="6,0,0,8" VerticalAlignment="Center"><TextBlock Text="Not finished" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="HomeStripCount" FontSize="11.5" Foreground="{DynamicResource Muted}"/></StackPanel>
       <Button x:Name="HomeStripMore" DockPanel.Dock="Right" Click="ToggleHomeStrip" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Accent}" Padding="10,4" MinHeight="0" Margin="4,0,4,8" VerticalAlignment="Center"/>
       <ItemsControl x:Name="HomeContinue" ItemTemplate="{StaticResource HomePill}" AutomationProperties.Name="Not finished"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, ElementName=HomeStrip}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      </DockPanel>
     </Border>

     <!-- Mystery deck: filter, then play the drawn card or draw another. -->
     <Border x:Name="HomeMysteryPanel" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource AccentEdge}" Background="{DynamicResource Surface}" Margin="0,0,0,34" ClipToBounds="True">
      <Grid>
       <Rectangle IsHitTestVisible="False"><Rectangle.Fill><RadialGradientBrush Center="0.82,0.5" GradientOrigin="0.82,0.5" RadiusX="0.4" RadiusY="0.8" Opacity="0.22"><GradientStop Color="{DynamicResource AccentColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentClear}" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
       <Grid Margin="30,26,40,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="Can't decide?" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"/>
         <TextBlock x:Name="HomeMysteryIntro" Text="Draw a random title you haven't started. Narrow it down by type and length." Style="{StaticResource MutedText}" Margin="0,6,0,14" MaxWidth="380" HorizontalAlignment="Left"/>
         <!-- Two choices on the app's thread selector (ThreadBar.cs): the type of title, then its length. -->
         <StackPanel x:Name="HomeMysteryFilters">
          <local:ThreadBar HorizontalAlignment="Left" Reach="5"><WrapPanel AutomationProperties.Name="Type of title">
           <RadioButton x:Name="MysteryAnything" GroupName="MysteryKind" Content="Anything" Tag="" IsChecked="True" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}"/>
           <RadioButton GroupName="MysteryKind" Content="Movie" Tag="Movie" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}"/>
           <RadioButton GroupName="MysteryKind" Content="Show" Tag="Show" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}"/>
           <RadioButton x:Name="MysteryAnime" GroupName="MysteryKind" Content="Anime" Tag="Anime" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}"/>
          </WrapPanel></local:ThreadBar>
          <local:ThreadBar HorizontalAlignment="Left" Reach="5"><WrapPanel AutomationProperties.Name="Length">
           <RadioButton GroupName="MysteryLength" Content="Any length" Tag="Any" IsChecked="True" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}"/>
           <RadioButton GroupName="MysteryLength" Content="Under 30 min" Tag="Short" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}"/>
           <RadioButton GroupName="MysteryLength" Content="Under 2 hours" Tag="Evening" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}"/>
           <RadioButton GroupName="MysteryLength" Content="Long night" Tag="LongNight" Checked="MysteryFilterChanged" Style="{StaticResource ThreadOptionChoice}" ToolTip="Movies over two hours, or series with six or more episodes"/>
          </WrapPanel></local:ThreadBar>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button x:Name="HomeMysteryPlay" Content="Play" Click="PlayHomeCard" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="20,8"/>
          <Button x:Name="HomeMysteryDraw" Content="Draw another" Click="DrawMystery" ContentTemplate="{StaticResource RefreshContent}"/>
         </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Height="262" VerticalAlignment="Center">
         <Grid Height="214" VerticalAlignment="Top" Margin="0,6,0,0">
          <Grid Width="128" Height="190" VerticalAlignment="Top" RenderTransformOrigin="0.5,1"><Grid.RenderTransform><TransformGroup><RotateTransform x:Name="MysteryLeftTilt" Angle="-11"/><TranslateTransform x:Name="MysteryLeftShift" X="-78" Y="8"/></TransformGroup></Grid.RenderTransform><Image Source="{x:Static local:SoftShadow.Card}" Margin="-30" IsHitTestVisible="False"/><Border Style="{StaticResource CardBack}"><Grid><Border CornerRadius="10" Background="{DynamicResource CardStripes}"/><TextBlock Text="?" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource Accent}" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid>
          <Grid Width="128" Height="190" VerticalAlignment="Top" RenderTransformOrigin="0.5,1"><Grid.RenderTransform><TransformGroup><RotateTransform x:Name="MysteryRightTilt" Angle="11"/><TranslateTransform x:Name="MysteryRightShift" X="78" Y="8"/></TransformGroup></Grid.RenderTransform><Image Source="{x:Static local:SoftShadow.Card}" Margin="-30" IsHitTestVisible="False"/><Border Style="{StaticResource CardBack}"><Grid><Border CornerRadius="10" Background="{DynamicResource CardStripes}"/><TextBlock Text="?" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource Accent}" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid>
          <Button x:Name="HomeMysteryCard" Click="OpenHomeCard" Style="{StaticResource HomeTile}" Width="128" Height="190" Margin="0" VerticalContentAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="{Binding DisplayTitle, StringFormat=Mystery pick: {0}}">
           <Border Style="{StaticResource HomeArtwork}" CornerRadius="11" local:RoundedClip.Radius="11"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Grid><TextBlock Text="{Binding DisplayTitle}" Margin="12" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><Image Source="{Binding Poster, NotifyOnTargetUpdated=True}" TargetUpdated="HomeArtworkUpdated" Stretch="UniformToFill" Loaded="HomeArtworkLoaded"/><Border Style="{StaticResource HoverRing}" CornerRadius="10"/></Grid>
           </Border>
          </Button>
         </Grid>
         <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <TextBlock x:Name="HomeMysteryTitle" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
          <TextBlock x:Name="HomeMysteryMeta" FontSize="12" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="0,2,0,0"/>
         </StackPanel>
        </Grid>
       </Grid>
      </Grid>
     </Border>

     <DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Right" Text="From your library, not started yet" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,3"/><TextBlock Text="Recommended for you" FontSize="22" FontWeight="SemiBold"/></DockPanel>
     <TextBlock x:Name="HomeSuggestionsEmpty" Text="Everything here has been started. Try a mystery pick or browse your library." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <ItemsControl x:Name="HomeRows" Panel.ZIndex="-1" ItemTemplate="{StaticResource HomeRowTemplate}" Focusable="False" AutomationProperties.Name="Recommended for you"/>
    </StackPanel>
   </ScrollViewer>

   <!-- Library -->
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="LocalLibraryHeader">
     <TextBlock x:Name="GuestLibraryStatus" Visibility="Collapsed" Style="{StaticResource MutedText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
     <Border x:Name="HostLibraryActivity" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,6" Margin="0,0,0,12">
      <DockPanel><Button x:Name="BrowseWithGuestButton" DockPanel.Dock="Right" Click="BrowseWithGuest" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed"/><Button DockPanel.Dock="Right" Content="Permissions" Click="OpenLibraryPermissions" Padding="12,0" Margin="8,0,0,0"/><TextBlock Text="&#xE716;" DockPanel.Dock="Left" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock x:Name="HostLibraryActivityText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel>
     </Border>
     <!-- Search: the library's grid under a search field and filters, in place of a category's breadcrumbs. -->
     <StackPanel x:Name="SearchHeader" Visibility="Collapsed" Margin="0,0,0,8">
      <TextBlock Text="Search" Style="{StaticResource PageHeading}" Margin="0,0,0,14"/>
      <Border x:Name="SearchFrame" Height="44" MouseLeftButtonDown="SearchFrameClick" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="10" Padding="14,0,8,0" HorizontalAlignment="Stretch" Cursor="IBeam">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" IsHitTestVisible="False"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" MinHeight="0" TextChanged="SearchChanged" ToolTip="Search your library (Ctrl+F)" AutomationProperties.Name="Search library" VerticalContentAlignment="Center" Margin="0" Padding="0" Background="Transparent" BorderThickness="0">
         <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></TextBox.Template>
        </TextBox>
        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search your library" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Elevated}" CornerRadius="5" Padding="6,2" Margin="0,0,2,0" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Muted}"/></Border>
        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="&#xE711;" Click="ClearSearch" ToolTip="Clear search" AutomationProperties.Name="Clear search" Style="{StaticResource QuietIcon}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" MinHeight="0" Margin="0" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <!-- The type of title is one choice among several, on the app's thread selector like the library's categories; green is
           kept for filters that are on. The count is set like the library's, level with the words above the thread. -->
      <DockPanel Margin="0,14,0,0">
       <!-- Search's count follows the library's, rolling and dimming with it (RollingText.cs). -->
       <local:RollingText x:Name="SearchResultCount" DockPanel.Dock="Right" Text="{Binding Text, ElementName=ResultCount}" Pending="{Binding Pending, ElementName=ResultCount}" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontFamily="{StaticResource DisplayFont}" TextElement.FontSize="15" Typography.NumeralStyle="OldStyle" VerticalAlignment="Center" Margin="12,0,8,12" AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="ClearSearchFiltersButton" DockPanel.Dock="Right" Content="Clear filters" Click="ClearSearchFiltersClick" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Accent}" Height="30" MinHeight="0" Padding="10,0" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,12" Visibility="Collapsed"/>
       <local:ThreadBar HorizontalAlignment="Left">
        <StackPanel x:Name="SearchKinds" Orientation="Horizontal" AutomationProperties.Name="Type of title">
         <RadioButton x:Name="SearchAllKinds" GroupName="SearchKind" Content="All videos" Tag="0" IsChecked="True" Checked="SearchFilterChanged" Style="{StaticResource ThreadWordChoice}"/>
         <RadioButton GroupName="SearchKind" Content="Movies" Tag="1" Checked="SearchFilterChanged" Style="{StaticResource ThreadWordChoice}"/>
         <RadioButton GroupName="SearchKind" Content="Shows" Tag="2" Checked="SearchFilterChanged" Style="{StaticResource ThreadWordChoice}"/>
         <RadioButton GroupName="SearchKind" Content="Anime" Tag="3" Checked="SearchFilterChanged" Style="{StaticResource ThreadWordChoice}"/>
         <RadioButton x:Name="SearchMusicKind" GroupName="SearchKind" Content="Music" Tag="6" Checked="SearchFilterChanged" Style="{StaticResource ThreadWordChoice}"/>
        </StackPanel>
       </local:ThreadBar>
      </DockPanel>
      <!-- Filters are pills: an icon and a name until something is chosen, then the choice with a button that clears it. -->
      <WrapPanel x:Name="SearchFilters" Margin="0,12,0,0">
       <WrapPanel.Resources>
        <!-- The keyboard focus ring follows the pill's round ends. -->
        <Style x:Key="PillFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border Margin="-3" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="20" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="FilterPill" TargetType="ComboBox">
         <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="FontSize" Value="13"/>
         <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
         <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocus}"/><Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
         <Setter Property="AlternationCount" Value="100000"/>
         <Setter Property="ItemContainerStyle"><Setter.Value>
          <Style TargetType="ComboBoxItem">
           <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
           <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <StackPanel>
             <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,1">
              <DockPanel><TextBlock x:Name="Check" DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Hidden"/><ContentPresenter VerticalAlignment="Center"/></DockPanel>
             </Border>
             <Border x:Name="Divider" Height="1" Background="{DynamicResource Line}" Margin="8,4,8,4" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers>
             <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Divider" Property="Visibility" Value="Visible"/></Trigger>
             <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate></Setter.Value></Setter>
          </Style>
         </Setter.Value></Setter>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
          <Grid>
           <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate></ToggleButton.Template>
            <Border x:Name="Pill" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentEdge}" BorderThickness="1" CornerRadius="17" Padding="13,0">
             <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="Glyph" Text="{TemplateBinding local:FilterPill.Icon}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="Label" Text="{TemplateBinding local:FilterPill.Label}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <ContentPresenter x:Name="Choice" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="7,0,0,0" MaxWidth="200" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Ink}" IsHitTestVisible="False"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></ContentPresenter.Resources></ContentPresenter>
              <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource Muted}" Margin="9,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Border x:Name="ClearSpace" Width="20"/>
             </StackPanel>
            </Border>
           </ToggleButton>
           <Button x:Name="ClearChoice" Command="{x:Static local:FilterPill.Clear}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Width="22" Height="22" Focusable="False" Cursor="Hand" ToolTip="Clear this filter" AutomationProperties.Name="{Binding (local:FilterPill.Label), RelativeSource={RelativeSource TemplatedParent}, StringFormat=Clear {0}}">
            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Disc" Background="Transparent" CornerRadius="11"><TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Background" Value="{DynamicResource AccentEdge}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
           </Button>
           <!-- The player's menu popup: it grows down out of the pill as it opens and folds back into it as it closes. -->
           <local:PlayerMenuPopup x:Name="PART_Popup" GrowsDown="True" TakesMouse="False" SoftwareSurface="False" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="-6" StaysOpen="True" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border>
             <ContentControl Margin="12" Focusable="False" IsTabStop="False" MinWidth="230">
              <ContentControl.Template><ControlTemplate TargetType="ContentControl"><Border Effect="{StaticResource PopupShadow}" Background="{DynamicResource Elevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="6,6,4,6"><ContentPresenter/></Border></ControlTemplate></ContentControl.Template>
              <DockPanel>
               <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding AutomationProperties.Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="10,6,10,4"/>
               <ScrollViewer Style="{StaticResource SlimScrollViewer}" MaxHeight="340" CanContentScroll="False" Padding="0,0,8,0"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </DockPanel>
             </ContentControl>
            </Border>
           </local:PlayerMenuPopup>
          </Grid>
          <ControlTemplate.Triggers>
           <!-- The first item is "any": the pill then names the filter instead of showing a choice. -->
           <Trigger Property="SelectedIndex" Value="0"><Setter TargetName="Pill" Property="Background" Value="Transparent"/><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Line}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="Choice" Property="Visibility" Value="Collapsed"/><Setter TargetName="Chevron" Property="Visibility" Value="Visible"/><Setter TargetName="ClearSpace" Property="Visibility" Value="Collapsed"/><Setter TargetName="ClearChoice" Property="Visibility" Value="Collapsed"/></Trigger>
           <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="Pill" Property="Background" Value="Transparent"/><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Line}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="Choice" Property="Visibility" Value="Collapsed"/><Setter TargetName="Chevron" Property="Visibility" Value="Visible"/><Setter TargetName="ClearSpace" Property="Visibility" Value="Collapsed"/><Setter TargetName="ClearChoice" Property="Visibility" Value="Collapsed"/></Trigger>
           <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="SelectedIndex" Value="0"/></MultiTrigger.Conditions><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Muted}"/><Setter TargetName="Pill" Property="Background" Value="{DynamicResource Hover}"/></MultiTrigger>
           <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
           <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style>
       </WrapPanel.Resources>
       <ComboBox x:Name="SearchAudio" Style="{StaticResource FilterPill}" local:FilterPill.Label="Audio" local:FilterPill.Icon="&#xE767;" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="SearchFilterChanged" DropDownClosed="SearchOptionsClosed" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Audio language" ToolTip="Videos with an audio track in this language"/>
       <ComboBox x:Name="SearchSubtitles" Style="{StaticResource FilterPill}" local:FilterPill.Label="Subtitles" local:FilterPill.Icon="&#xE7F0;" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="SearchFilterChanged" DropDownClosed="SearchOptionsClosed" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Subtitle language" ToolTip="Videos with subtitles in this language, in the file or in a subtitle file beside it"/>
       <ComboBox x:Name="SearchGenre" Style="{StaticResource FilterPill}" local:FilterPill.Label="Genre" local:FilterPill.Icon="&#xE8EC;" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="SearchFilterChanged" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Genre"/>
       <ComboBox x:Name="SearchDecade" Style="{StaticResource FilterPill}" local:FilterPill.Label="Released" local:FilterPill.Icon="&#xE787;" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="SearchFilterChanged" AutomationProperties.Name="Released"/>
       <ComboBox x:Name="SearchLengthFilter" Style="{StaticResource FilterPill}" local:FilterPill.Label="Length" local:FilterPill.Icon="&#xE916;" SelectedIndex="0" SelectionChanged="SearchFilterChanged" AutomationProperties.Name="Length" ToolTip="The length of a film, or of a show's episodes"><ComboBoxItem Content="Any length" Tag="Any"/><ComboBoxItem Content="Under 30 min" Tag="UpToHalfHour"/><ComboBoxItem Content="30 min to 1 hour" Tag="UpToHour"/><ComboBoxItem Content="1 to 2 hours" Tag="UpToTwoHours"/><ComboBoxItem Content="Over 2 hours" Tag="OverTwoHours"/></ComboBox>
       <ComboBox x:Name="SearchRating" Style="{StaticResource FilterPill}" local:FilterPill.Label="Rating" local:FilterPill.Icon="&#xE734;" SelectedIndex="0" SelectionChanged="SearchFilterChanged" AutomationProperties.Name="Rating" ToolTip="The rating from the title's metadata provider"><ComboBoxItem Content="Any rating" Tag=""/><ComboBoxItem Content="6 and up" Tag="6"/><ComboBoxItem Content="7 and up" Tag="7"/><ComboBoxItem Content="8 and up" Tag="8"/></ComboBox>
       <ComboBox x:Name="LibraryStatusFilter" Style="{StaticResource FilterPill}" local:FilterPill.Label="Status" local:FilterPill.Icon="&#xE7B3;" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Watch state" ToolTip="Filter by artwork or watch progress"><ComboBoxItem Content="All watch states"/><ComboBoxItem Content="Needs artwork"/><ComboBoxItem Content="Continue watching"/><ComboBoxItem Content="Unwatched"/><ComboBoxItem Content="Watched"/><ComboBoxItem Content="Missing"/><ComboBoxItem Content="Upcoming"/></ComboBox>
      </WrapPanel>
     </StackPanel>
     <!-- One row holds the categories on the left and the count and actions on the right. A window too narrow for both puts
          the actions on a row of their own; the location inside a category (a show, a season) goes under them
          (LibraryToolbar.cs). Search and Music have no categories, so their location or search note takes the categories' place. -->
     <Grid x:Name="LibraryToolbar" MinHeight="40" Margin="0,0,0,14" SizeChanged="LibraryToolbarSizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- The library's categories, on the app's thread selector (ThreadBar.cs). Search and Music have their own tabs, so the
           categories hide for them. -->
      <local:ThreadBar x:Name="LibraryCategoryBar" HorizontalAlignment="Left" VerticalAlignment="Top" SizeChanged="LibraryCategoryBarSizeChanged">
       <StackPanel x:Name="LibraryCategories" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Library category">
        <Button x:Name="AllLibraryNav" Content="All" Tag="0" Click="LibraryCategoryClick" Style="{StaticResource ThreadWord}"/>
        <Button x:Name="AnimeLibraryNav" Content="Anime" Tag="3" Click="LibraryCategoryClick" Style="{StaticResource ThreadWord}"/>
        <Button x:Name="ShowsLibraryNav" Content="Shows" Tag="2" Click="LibraryCategoryClick" Style="{StaticResource ThreadWord}"/>
        <Button x:Name="MoviesLibraryNav" Content="Movies" Tag="1" Click="LibraryCategoryClick" Style="{StaticResource ThreadWord}"/>
        <Button x:Name="UnavailableLibraryNav" Content="Unavailable" Tag="4" Click="LibraryCategoryClick" Style="{StaticResource ThreadWord}" Visibility="Collapsed"/>
        <!-- Shows and films with episodes or files still to come; listed only while there are some. Their number is part of the label. -->
        <Button x:Name="MissingLibraryNav" Tag="5" Click="LibraryCategoryClick" Style="{StaticResource ThreadWord}" Visibility="Collapsed" AutomationProperties.Name="Missing"><TextBlock>Missing<Run Text=" "/><Run x:Name="MissingLibraryCount" Style="{StaticResource CategoryCount}"/></TextBlock></Button>
        <!-- Shows and films no metadata provider could identify; listed only while there are some. -->
        <Button x:Name="UnmatchedLibraryNav" Tag="7" Click="LibraryCategoryClick" Style="{StaticResource ThreadWord}" Visibility="Collapsed" AutomationProperties.Name="Unmatched" ToolTip="Titles without a match yet. Open one and use Find artwork / fix match to identify it yourself."><TextBlock>Unmatched<Run Text=" "/><Run x:Name="UnmatchedLibraryCount" Style="{StaticResource CategoryCount}"/></TextBlock></Button>
       </StackPanel>
      </local:ThreadBar>
      <ItemsControl x:Name="LibraryBreadcrumbs" Margin="-8,0,0,0" VerticalAlignment="Center" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Library location"/>
      <!-- Search says here what it is still reading, or what a guest can search. -->
      <TextBlock x:Name="SearchNote" Visibility="Collapsed" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
      <!-- The count and actions sit level with the category words, above the thread; they stay quiet so the pearl leads. -->
      <!-- The count rolls to each new number, digit by digit (RollingText.cs). It is set like the category counts, in the categories' serif with old-style figures, so every number on the row speaks with one voice. -->
      <local:RollingText Grid.Column="1" x:Name="ResultCount" MinWidth="100" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontFamily="{StaticResource DisplayFont}" TextElement.FontSize="15" Typography.NumeralStyle="OldStyle" VerticalAlignment="Center" Margin="12,0,8,0" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="RescanButton" Grid.Column="2" Style="{StaticResource HeaderAction}" Content="Rescan" Click="ScanClick" Margin="0" ToolTip="Check your folders for new videos"/>
      <Button x:Name="AddTitleButton" Grid.Column="3" Style="{StaticResource HeaderCreate}" Padding="14,0" Margin="10,0,0,0" Content="Add title" ContentTemplate="{StaticResource AddContent}" Click="AddTitleClick" ToolTip="Add a show or film you don't have files for yet (Ctrl+N)" AutomationProperties.Name="Add title"/>
     </Grid>
     <Expander x:Name="SeasonInformation" Foreground="{DynamicResource Muted}" Header="Season details" Visibility="Collapsed" Margin="-6,0,0,10"><TextBlock x:Name="SeasonSummary" Style="{StaticResource MutedText}" Margin="0,8,0,8" MaxWidth="760" HorizontalAlignment="Left"/></Expander>
     <!-- Asks an acquisition plugin for the missing and upcoming episodes of the season being browsed. -->
     <WrapPanel>
      <Button x:Name="AcquireSeasonButton" Content="Acquire season" ContentTemplate="{StaticResource DownloadContent}" Click="AcquireSeasonClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,10,12" ToolTip="Ask an acquisition plugin to get this season's missing episodes" AutomationProperties.Name="Acquire season"/>
      <!-- Auto-download: finds the new episodes of the show being browsed as they air, and downloads them after the user's OK. -->
      <Button x:Name="FollowShowButton" Click="FollowShowClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="Auto-download new episodes"><StackPanel Orientation="Horizontal"><TextBlock x:Name="FollowShowIcon" Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/><TextBlock x:Name="FollowShowText" Text="Auto-download new episodes" VerticalAlignment="Center"/></StackPanel></Button>
     </WrapPanel>
     <!-- What a wanted show has and still needs, while browsing it. -->
     <ContentControl x:Name="WantedLibraryPanel" Visibility="Collapsed" Focusable="False" Margin="0,0,0,14"/>
    </StackPanel>
    <Grid x:Name="LocalLibraryContent" Grid.Row="1" Margin="-6,0,0,0"><ItemsControl x:Name="PosterGrid" MouseMove="LibraryPointerMove" MouseLeave="LibraryPointerLeave" PreviewMouseWheel="HostLibraryScrollInput" PreviewTouchDown="HostLibraryTouchInput" VirtualizingPanel.ScrollUnit="Pixel"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="LibraryScroll" Style="{StaticResource SlimScrollViewer}" Margin="0,0,-24,0" Padding="0,0,24,0" PreviewMouseLeftButtonDown="HostLibraryPointerInput" ScrollChanged="LibraryScrollChanged" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:VirtualizingLibraryPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid RequestBringIntoView="LibraryCardBringIntoView">
      <Border Panel.ZIndex="1" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="3" CornerRadius="12" Margin="0,0,14,18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGuestHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
