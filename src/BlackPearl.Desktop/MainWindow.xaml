     </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" Margin="0,0,0,22"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock Text="Your library starts here" FontWeight="SemiBold" FontSize="24" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Add a video folder to discover movies and shows. Your files stay where they are." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,24"/><WrapPanel HorizontalAlignment="Center"><Button Content="Add folder" Style="{StaticResource Primary}" ContentTemplate="{StaticResource AddContent}" Tag="Folders" Click="Navigate"/><Button Content="Join a friend" ContentTemplate="{StaticResource PeopleContent}" Click="JoinFromWelcome" Margin="0,0,8,8"/><Button Content="Add a title" ContentTemplate="{StaticResource AddContent}" Click="AddTitleClick" Margin="0,0,0,8" ToolTip="Add a show or film you don't have files for yet"/></WrapPanel></StackPanel>
     <StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}" Foreground="{DynamicResource Muted}"/><TextBlock Text="No titles found" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="NoResultsHint" Text="Try another search or clear your filters." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,22"/><Button x:Name="FindTitleButton" Style="{StaticResource Primary}" Click="FindTitleClick" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/><Button x:Name="ResetFiltersButton" Content="Clear search and filters" Click="ResetFilters" HorizontalAlignment="Center" Margin="0"/></StackPanel>
     <!-- The browsing guest's mouse, shown to the host while following them. -->
     <Canvas x:Name="GuestPointerLayer" IsHitTestVisible="False" ClipToBounds="True"><Grid x:Name="GuestPointer" Width="24" Height="24" Margin="-12,-12,0,0" Visibility="Collapsed" AutomationProperties.Name="Guest pointer"><Grid.RenderTransform><TranslateTransform x:Name="GuestPointerPosition"/></Grid.RenderTransform><Ellipse Fill="{DynamicResource Accent}" Opacity="0.3"/><Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2.5"/></Grid></Canvas></Grid>
    <!-- Several selected cards: what can be done to all of them at once. Ctrl+click or Shift+click selects, Esc clears. -->
    <Border x:Name="CardSelectionBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,6,8,6" Margin="0,10,8,0" AutomationProperties.Name="Selected titles">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource QuietIcon}" Click="ClearCardSelectionClick" ToolTip="Clear selection (Esc)" AutomationProperties.Name="Clear selection" Width="32" Height="32" MinHeight="0" VerticalAlignment="Center"/>
