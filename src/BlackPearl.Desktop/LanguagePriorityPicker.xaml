<UserControl x:Class="BlackPearl.Desktop.LanguagePriorityPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BlackPearl.Desktop">
 <!-- Chosen languages read left to right in priority order; the trailing dropdown adds one on selection. -->
 <WrapPanel>
  <TextBlock Text="{Binding EmptyText, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,10,6">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=Priorities}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <ItemsControl x:Name="Priorities" Focusable="False">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.Resources>
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource QuietIcon}"><Setter Property="FontSize" Value="9"/><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="MinHeight" Value="22"/><Setter Property="Margin" Value="0"/>
     <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
   </ItemsControl.Resources>
   <ItemsControl.ItemTemplate><DataTemplate>
    <!-- A chosen language is a chip: a small pebble with its place in the order stamped into it as a sunk coin. -->
    <local:Stone Depth="Chip" Background="{DynamicResource PebbleFill}" CornerRadius="16" Height="32" Margin="0,0,8,8" ToolTip="{Binding Name}">
     <Grid>
     <Border CornerRadius="16" Background="{DynamicResource PebbleDome}" IsHitTestVisible="False"/>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
      <Grid Width="22" Height="22" Margin="1,0,8,0" VerticalAlignment="Center"><Border CornerRadius="11" Background="{DynamicResource Well}"/><Border CornerRadius="11" Background="{DynamicResource WellShade}"/><Border CornerRadius="11" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WellLip}"/><TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <TextBlock Text="{Binding Name}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <Button Content="&#xE76B;" Tag="Up" Click="MoveLanguage" IsEnabled="{Binding CanMoveUp}" ToolTip="Move earlier" AutomationProperties.Name="Move language up" Style="{StaticResource ChipButton}"/>
      <Button Content="&#xE76C;" Tag="Down" Click="MoveLanguage" IsEnabled="{Binding CanMoveDown}" ToolTip="Move later" AutomationProperties.Name="Move language down" Style="{StaticResource ChipButton}"/>
      <Button Content="&#xE711;" Click="RemoveLanguage" ToolTip="Remove language" AutomationProperties.Name="Remove language" Style="{StaticResource ChipButton}"/>
     </StackPanel>
     </Grid>
    </local:Stone>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Grid Margin="0,0,0,8">
   <ComboBox x:Name="LanguageOptions" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="280" SelectionChanged="LanguageChosen" DropDownClosed="LanguageListClosed" KeyDown="LanguageKeyDown"
    AutomationProperties.Name="Add a language to the priority list" ToolTip="Add a language" Width="160" Height="32" MinHeight="32" MinWidth="0" Margin="0"/>
   <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=LanguageOptions}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBlock Text="Add language" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
 </WrapPanel>
</UserControl>
