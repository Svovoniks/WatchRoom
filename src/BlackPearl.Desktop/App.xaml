<Application x:Class="BlackPearl.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BlackPearl.Desktop" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <Application.Resources>
  <Style TargetType="ScrollViewer"><Setter Property="local:PrecisionScrolling.Enabled" Value="True"/></Style>
  <local:ArtworkCardWidthConverter x:Key="ArtworkCardWidth"/>
  <local:DetailBackdropConverter x:Key="DetailBackdrop"/>
  <local:RowBackdropConverter x:Key="RowBackdrop"/>
  <local:ProgressColumnConverter x:Key="ProgressColumn"/>
  <Thickness x:Key="ActionButtonPadding">16,8</Thickness>
  <Thickness x:Key="IconButtonPadding">8,12</Thickness>
  <!-- Fluent icons on Windows 11; MDL2 shares the code points on Windows 10. -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <!-- The app's display serif, the wordmark's: page headings, display titles and the thread selector's words. Everything else is
       set in the interface's sans. -->
  <FontFamily x:Key="DisplayFont">Sitka Heading, Georgia</FontFamily>

  <!-- Theme palette. MainWindow.ApplyTheme replaces these brushes with the chosen colour theme in light or dark mode. -->
  <SolidColorBrush x:Key="Canvas" Color="#0F1311"/><SolidColorBrush x:Key="Surface" Color="#151A17"/><SolidColorBrush x:Key="Elevated" Color="#1E2420"/><SolidColorBrush x:Key="Ink" Color="#EAF0EB"/><SolidColorBrush x:Key="Muted" Color="#9BA89F"/><SolidColorBrush x:Key="Line" Color="#28302B"/><SolidColorBrush x:Key="Accent" Color="#9FD4A8"/><SolidColorBrush x:Key="AccentInk" Color="#0E2A15"/>
  <SolidColorBrush x:Key="Hover" Color="#252C27"/><SolidColorBrush x:Key="AccentSoft" Color="#1F3324"/><SolidColorBrush x:Key="Success" Color="#6CC3D9"/><SolidColorBrush x:Key="Danger" Color="#F07A6E"/><SolidColorBrush x:Key="Scrim" Color="#C80F1015"/>
  <!-- Accent outlines, glows and the mystery card stripes; ApplyTheme rebuilds them from the theme accent. -->
  <SolidColorBrush x:Key="AccentEdge" Color="#599FD4A8"/><Color x:Key="AccentColor">#9FD4A8</Color><Color x:Key="AccentClear">#009FD4A8</Color><Color x:Key="ElevatedColor">#1E2420</Color><Color x:Key="AccentSoftColor">#1F3324</Color>
  <!-- The pebble material (Stone.cs; MainWindow.ApplyStoneTheme rebuilds these per theme): a stone's fill and dome, the sunk
       well that holds a value, and the accent light of focus. -->
  <SolidColorBrush x:Key="PebbleFill" Color="#1E2420"/><Color x:Key="PebbleColor">#1E2420</Color><SolidColorBrush x:Key="Raised" Color="#1E2420"/>
  <LinearGradientBrush x:Key="PebbleDome" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.55"/><GradientStop Color="#1F000000" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="PebbleDomePressed" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.5"/><GradientStop Color="#0AFFFFFF" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Well" Color="#0A0D0B"/><SolidColorBrush x:Key="TrayFill" Color="#121714"/><SolidColorBrush x:Key="WellLip" Color="#0DFFFFFF"/><SolidColorBrush x:Key="WellHover" Color="#1FEAF0EB"/>
  <LinearGradientBrush x:Key="WellShade" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,7"><GradientStop Color="#73000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="WellLit" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1F9FD4A8" Offset="0"/><GradientStop Color="#009FD4A8" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="AccentRing" Color="#A69FD4A8"/><SolidColorBrush x:Key="AccentHalo" Color="#299FD4A8"/>
  <local:CornerRadiusConverter x:Key="CornerRadius"/><local:FillVisibilityConverter x:Key="FillVisibility"/><sys:Boolean x:Key="StoneLight">False</sys:Boolean>
  <LinearGradientBrush x:Key="CardStripes" MappingMode="Absolute" StartPoint="0,0" EndPoint="13,13" SpreadMethod="Repeat"><GradientStop Color="#009FD4A8" Offset="0"/><GradientStop Color="#009FD4A8" Offset="0.5"/><GradientStop Color="#1F9FD4A8" Offset="0.5"/><GradientStop Color="#1F9FD4A8" Offset="1"/></LinearGradientBrush>
  <!-- Fades the details backdrop into Canvas; MainWindow.ApplyTheme rebuilds it with the theme's Canvas colour. -->
  <!-- Home artwork fades: hero and spotlight text sit on Surface; recommendation rows fade into Canvas. ApplyTheme rebuilds both. -->
  <LinearGradientBrush x:Key="HeroFade" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF16171E" Offset="0"/><GradientStop Color="#E616171E" Offset="0.38"/><GradientStop Color="#0016171E" Offset="0.8"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="EdgeFadeLeft" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0F1015" Offset="0"/><GradientStop Color="#000F1015" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="EdgeFadeRight" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#000F1015" Offset="0"/><GradientStop Color="#FF0F1015" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="BackdropFade" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000F1015" Offset="0"/><GradientStop Color="#4F0F1015" Offset="0.45"/><GradientStop Color="#FF0F1015" Offset="1"/></LinearGradientBrush>

  <!-- The player is always dark so video stays the brightest thing on screen; ApplyTheme sets its accent from the theme's dark colours. -->
  <SolidColorBrush x:Key="PlayerInk" Color="#F4F4F7"/><SolidColorBrush x:Key="PlayerMuted" Color="#B4B6C2"/><SolidColorBrush x:Key="PlayerSurface" Color="#17181F"/><SolidColorBrush x:Key="PlayerLine" Color="#2E303B"/><SolidColorBrush x:Key="PlayerAccent" Color="#9FD4A8"/><SolidColorBrush x:Key="PlayerAccentInk" Color="#0E2A15"/><SolidColorBrush x:Key="PlayerAccentSoft" Color="#1F3324"/><SolidColorBrush x:Key="PlayerAccentTint" Color="#389FD4A8"/><SolidColorBrush x:Key="PlayerAccentEdge" Color="#739FD4A8"/>
  <!-- The player bars float over the video; a light fade lifts the window buttons and the dock off bright pictures. -->
  <LinearGradientBrush x:Key="PlayerControlsFade" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000B0B0E" Offset="0"/><GradientStop Color="#4D0B0B0E" Offset="0.5"/><GradientStop Color="#990B0B0E" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="PlayerHeaderFade" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#990B0B0E" Offset="0"/><GradientStop Color="#400B0B0E" Offset="0.6"/><GradientStop Color="#000B0B0E" Offset="1"/></LinearGradientBrush>
  <local:QueueRowConverter x:Key="QueueRow"/>
  <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000"/>
  <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#000000"/>

  <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="8" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter></Style>  <Style TargetType="Window"><Setter Property="local:WindowTheme.Enabled" Value="True"/><Setter Property="Icon" Value="/BlackPearl;component/Assets/BlackPearl.ico"/><Setter Property="Background" Value="{DynamicResource Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <!-- Links are in the accent everywhere, rather than the system's blue. -->
  <Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="PageHeading" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,24,0,8"/></Style>
  <Style x:Key="RowHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Overline" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,2"/></Style>
  <!-- Icons inside a lit pebble, a main action such as Play, take the accent. -->
  <Style x:Key="Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/><Style.Triggers><Trigger Property="local:Pebble.Lit" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="NavigationIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="Width" Value="28"/><Style.Triggers><DataTrigger Binding="{Binding (AutomationProperties.ItemStatus), RelativeSource={RelativeSource AncestorType=Button}}" Value="Selected"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="EmptyStateIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="FontSize" Value="40"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
  <!-- A slab: a large stone that groups related content and settings. Its shadow raises it off the page; it has no outline. -->
  <Style x:Key="Card" TargetType="local:Stone"><Setter Property="Depth" Value="Slab"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="22,20"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
  <!-- A tray pressed into a slab, for a group within a group, such as one subtitle exception: a shallow well, not a box in a box. -->
  <Style x:Key="Tray" TargetType="Border"><Setter Property="Background" Value="{DynamicResource TrayFill}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <!-- A dome for stones over artwork or video, which are dark whatever the theme. -->
  <LinearGradientBrush x:Key="GlassDome" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.55"/><GradientStop Color="#29000000" Offset="1"/></LinearGradientBrush>
  <!-- Keyboard focus on a well: the ring and halo of a pebble's, at a well's corners. -->
  <Style x:Key="WellFocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Grid Margin="-3" SnapsToDevicePixels="True"><Border Margin="-3" BorderBrush="{DynamicResource AccentHalo}" BorderThickness="3" CornerRadius="18"/><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="15"/></Grid></ControlTemplate></Setter.Value></Setter></Style>

  <!-- Buttons are pebbles (Stone.cs): soft, slightly domed stones with a shadow below and no outline. They brighten a touch
       under the pointer and sink when pressed. A main action is a lit pebble (Primary) that glows all over; a pebble's Tag
       (0 to 100) lights how far a title has been watched. Quiet and icon buttons stay flat, so the pebbles keep meaning. -->
  <!-- Keyboard focus on a pebble or chip: an accent ring a few pixels outside its edge, in a soft halo of the same light. -->
  <Style x:Key="SoftFocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Grid Margin="-3" SnapsToDevicePixels="True"><Border Margin="-3" BorderBrush="{DynamicResource AccentHalo}" BorderThickness="3" CornerRadius="22"/><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="19"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ChipFocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Grid Margin="-3" SnapsToDevicePixels="True"><Border Margin="-3" BorderBrush="{DynamicResource AccentHalo}" BorderThickness="3" CornerRadius="19"/><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="16"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
   <Grid>
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
    <Border x:Name="Tint" Background="{DynamicResource Ink}" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.07"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.14"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <!-- The pebble. Its stone draws the shadow and the highlight on its top edge; the light inside it is the accent: all over
       when lit, or up to how far a title has been watched, fading out softly at that point rather than ending at a line. -->
  <ControlTemplate x:Key="PebbleTemplate" TargetType="Button">
   <local:StoneHost>
    <local:Stone x:Name="Body" Background="{TemplateBinding Background}" Depth="{Binding (local:Pebble.Depth), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="{Binding (local:Pebble.Radius), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CornerRadius}}" IsHitTestVisible="False"/>
    <Grid local:RoundedClip.Radius="{Binding (local:Pebble.Radius), RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False">
     <!-- Shown only while there is light to draw: an opacity mask makes software rendering draw through a layer. -->
     <Grid x:Name="Glow" Opacity="0.24" Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProgressColumn}}">
      <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF000000" Offset="0.2"/><GradientStop Color="#80000000" Offset="0.8"/></LinearGradientBrush></Grid.OpacityMask>
      <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProgressColumn}}"/><ColumnDefinition Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProgressColumn}, ConverterParameter=rest}"/></Grid.ColumnDefinitions>
      <Border x:Name="Watched" Background="{DynamicResource Accent}" Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProgressColumn}}"/>
      <Border x:Name="WatchedEnd" Grid.Column="1" Width="28" HorizontalAlignment="Left" Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProgressColumn}}">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{DynamicResource AccentColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentClear}" Offset="1"/></LinearGradientBrush></Border.Background>
      </Border>
      <Border x:Name="Lit" Grid.ColumnSpan="2" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
     </Grid>
     <Border x:Name="Dome" Background="{DynamicResource PebbleDome}"/>
     <Border x:Name="Tint" Background="{DynamicResource Ink}" Opacity="0"/>
    </Grid>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
   </local:StoneHost>
   <ControlTemplate.Triggers>
    <Trigger Property="local:Pebble.Lit" Value="True"><Setter TargetName="Glow" Property="Visibility" Value="Visible"/><Setter TargetName="Lit" Property="Visibility" Value="Visible"/><Setter TargetName="Watched" Property="Visibility" Value="Collapsed"/><Setter TargetName="WatchedEnd" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.06"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/><Setter TargetName="Dome" Property="Background" Value="{DynamicResource PebbleDomePressed}"/><Setter TargetName="Body" Property="Depth" Value="Pressed"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter TargetName="Body" Property="Depth" Value="None"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource PebbleFill}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="{StaticResource ActionButtonPadding}"/><Setter Property="MinHeight" Value="40"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusRing}"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template" Value="{StaticResource PebbleTemplate}"/>
  </Style>
  <!-- A main action, such as Play, Connect or Save: a lit pebble. -->
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="local:Pebble.Lit" Value="True"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,8"/></Style>
  <!-- An action in a page's or a section's header: quiet text beside the heading, so the heading leads. Filled buttons are for
       actions within the content, such as Resume or Connect. -->
  <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0"/></Style>
  <!-- The header's action that makes something new, in the accent. -->
  <Style x:Key="HeaderCreate" TargetType="Button" BasedOn="{StaticResource HeaderAction}"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="QuietIcon" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/></Style>
  <!-- Resume on Home: a pebble that shows how far the title has been watched. -->
  <Style x:Key="Pebble" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="20,0,22,0"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- A small pebble for a value or a filter, such as a chosen language: rounder for its size and lower than a button. -->
  <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,6,6"/>
   <Setter Property="local:Pebble.Radius" Value="13"/><Setter Property="local:Pebble.Depth" Value="Chip"/><Setter Property="FocusVisualStyle" Value="{StaticResource ChipFocusRing}"/>
  </Style>
  <!-- Prefixes button content with an icon given in Tag of the ContentTemplate; content stays plain text for code and automation. -->
  <DataTemplate x:Key="PlayContent"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF5B0;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,9,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="PeopleContent"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="AddContent"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,9,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="DownloadContent"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="RefreshContent"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="BackContent"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>

  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <StackPanel>
     <ToggleButton Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Disclosure" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="6,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disclosure" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="28,4,0,0"/>
    </StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Wells: a field you put a value into is sunk into the page, shaded inside its top edge with a faint lip below. Typing
       in it lights it from within, with an accent ring and a soft halo around it. -->
  <Style TargetType="TextBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><Border x:Name="Halo" Margin="-4" BorderBrush="{DynamicResource AccentHalo}" BorderThickness="3" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False"/><Border Background="{TemplateBinding Background}" CornerRadius="12"/><Border x:Name="Lit" Background="{DynamicResource WellLit}" CornerRadius="12" Visibility="Collapsed"/><Border Background="{DynamicResource WellShade}" CornerRadius="12" IsHitTestVisible="False"/><Border BorderBrush="{DynamicResource WellLip}" BorderThickness="0,0,0,1" CornerRadius="12" IsHitTestVisible="False"/><Border x:Name="InputFrame" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" IsHitTestVisible="False"/><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="{DynamicResource WellHover}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/><Setter TargetName="Halo" Property="Visibility" Value="Visible"/><Setter TargetName="Lit" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="{DynamicResource Well}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Grid><Border x:Name="Halo" Margin="-4" BorderBrush="{DynamicResource AccentHalo}" BorderThickness="3" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False"/><Border Background="{TemplateBinding Background}" CornerRadius="12"/><Border x:Name="Lit" Background="{DynamicResource WellLit}" CornerRadius="12" Visibility="Collapsed"/><Border Background="{DynamicResource WellShade}" CornerRadius="12" IsHitTestVisible="False"/><Border BorderBrush="{DynamicResource WellLip}" BorderThickness="0,0,0,1" CornerRadius="12" IsHitTestVisible="False"/><Border x:Name="InputFrame" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" IsHitTestVisible="False"/><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="{DynamicResource WellHover}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/><Setter TargetName="Halo" Property="Visibility" Value="Visible"/><Setter TargetName="Lit" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="{DynamicResource Well}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,6,0,12"/></Style>

  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemFrame" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Well}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Margin" Value="0,6,8,12"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinWidth" Value="120"/><Setter Property="FocusVisualStyle" Value="{StaticResource WellFocusRing}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="Halo" Margin="-4" BorderBrush="{DynamicResource AccentHalo}" BorderThickness="3" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False"/><Border Background="{TemplateBinding Background}" CornerRadius="12"/><Border x:Name="Lit" Background="{DynamicResource WellLit}" CornerRadius="12" Visibility="Collapsed"/><Border Background="{DynamicResource WellShade}" CornerRadius="12"/><Border BorderBrush="{DynamicResource WellLip}" BorderThickness="0,0,0,1" CornerRadius="12"/><Border x:Name="Field" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"/><ContentPresenter/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource WellHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentRing}"/><Setter TargetName="Lit" Property="Visibility" Value="Visible"/><Setter TargetName="Halo" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     <Grid Margin="12,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Ink}"/><TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </ToggleButton>
    <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-16" VerticalOffset="-6" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <local:Stone Margin="16,10,16,22" Depth="Popup" Background="{DynamicResource Raised}" CornerRadius="14" Padding="0,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></local:Stone>
    </Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource Well}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Grid><Border Background="{TemplateBinding Background}" CornerRadius="14"/><Border Background="{DynamicResource WellShade}" CornerRadius="14" IsHitTestVisible="False" Visibility="{TemplateBinding Background, Converter={StaticResource FillVisibility}}"/><Border BorderBrush="{DynamicResource WellLip}" BorderThickness="0,0,0,1" CornerRadius="14" IsHitTestVisible="False" Visibility="{TemplateBinding Background, Converter={StaticResource FillVisibility}}"/><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ScrollViewer Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"><ItemsPresenter/></ScrollViewer></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemFrame" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <!-- A switch: a small pebble that rolls along a well. Turned on, the well fills with the accent light. -->
  <Style x:Key="Switch" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
   <!-- No padding on the left, so the track lines up with the text above it whatever margin a switch is given. -->
   <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0,4,4,4"/><Setter Property="Margin" Value="0,2,0,2"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="SwitchFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="44" Height="24" VerticalAlignment="Center">
       <Border x:Name="SwitchTrack" CornerRadius="12" Background="{DynamicResource Well}"/>
       <Border CornerRadius="12" Background="{DynamicResource WellShade}"/>
       <Border CornerRadius="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WellLip}"/>
       <local:Stone x:Name="SwitchThumb" Depth="Disc" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="3,0"><Border CornerRadius="9" Background="{DynamicResource GlassDome}"/></local:Stone>
      </Grid>
      <ContentPresenter Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource Ink}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource AccentInk}"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Center"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="SwitchFrame" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource Switch}"/>

  <!-- Sidebar navigation. The current page is marked by the pearl on the sidebar's edge (SideRail.cs), a bright
       label and an accent icon, rather than a fill: pointing at an entry is the only thing that fills it. -->
  <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <!-- No padding on the right: a folded sidebar is narrower than the icon and its left padding, and padding there would cut the icons off. -->
   <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0,0,0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8"/>
     <Border x:Name="Tint" Background="{DynamicResource Ink}" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
     <!-- At least as tall as a label, so the folded sidebar taking its labels out leaves the icon's row the same height.
          A row that shrank to the icon was centred anew and, rounded at 125% scaling, moved every icon down a pixel. -->
     <ContentPresenter Margin="{TemplateBinding Padding}" MinHeight="20" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.05"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
     <!-- The entry the dragged pearl points at, which opens when the pearl is let go, looks pointed at. -->
     <Trigger Property="local:SideRail.Aimed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.05"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger>
     <Trigger Property="AutomationProperties.ItemStatus" Value="Selected"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <!-- A collapsed sidebar is a strip of icons. The icons keep the open layout, which already puts each glyph in the middle
        of the strip, so they don't shift a fraction of a pixel when the folding sidebar takes out its words. -->
  </Style>
  <!-- Sidebar text that a collapsed sidebar hides. -->
  <Style x:Key="NavigationLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Style.Triggers><Trigger Property="local:SideRail.Collapsed" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <!-- The app's black pearl: a dark body, the accent sheen low on the right, a violet one on the left and a bright highlight.
       Drawn at 15 DIP and scaled to the size it is given. It marks the current page on the sidebar, and only there. -->
  <Style x:Key="Pearl" TargetType="ContentControl">
   <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
    <Viewbox><Grid Width="15" Height="15">
     <Ellipse><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.74,0.82" Center="0.64,0.7" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="{DynamicResource AccentColor}" Offset="0"/><GradientStop Color="#FF262A36" Offset="0.55"/><GradientStop Color="#FF09090D" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
     <Ellipse><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.2,0.5" Center="0.25,0.5" RadiusX="0.55" RadiusY="0.6"><GradientStop Color="#B07A55D0" Offset="0"/><GradientStop Color="#007A55D0" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
     <Ellipse Width="4.5" Height="3.5" Margin="3.5,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#F2FFFFFF"/>
    </Grid></Viewbox>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The app's pick-one selector (ThreadBar.cs): words strung on a thread, the stretch under the chosen one lit in the pearl's
       colours, the accent fading into its violet, and gliding to the next choice. The threads are drawn in code; the light is
       here so its colours follow the theme. -->
  <Style TargetType="local:ThreadBar">
   <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:ThreadBar">
    <Grid>
     <ContentPresenter/>
     <Canvas x:Name="PART_Layer" IsHitTestVisible="False">
<!-- The light: a bright line with a soft halo around it. The halo is drawn as gradients, not a blur effect, which looked the
           same but slowed the library's first layout. -->
      <Grid x:Name="PART_Light" Height="10" Visibility="Hidden">
       <Border Opacity="0.45">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource AccentClear}" Offset="0"/><GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/><GradientStop Color="{DynamicResource AccentClear}" Offset="1"/></LinearGradientBrush></Border.Background>
        <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.2"/><GradientStop Color="#FF000000" Offset="0.8"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask>
       </Border>
       <Border Height="2" CornerRadius="1" VerticalAlignment="Center">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{DynamicResource AccentClear}" Offset="0"/><GradientStop Color="{DynamicResource AccentColor}" Offset="0.14"/><GradientStop Color="#FF9A7AE6" Offset="0.86"/><GradientStop Color="#009A7AE6" Offset="1"/></LinearGradientBrush></Border.Background>
       </Border>
      </Grid>
     </Canvas>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A choice on a thread at the head of a page, such as a library category or a settings section: a word in the wordmark's
       serif. The chosen one is in full ink with the thread lit under it; the rest are muted until pointed at. All share one
       weight, so choosing one never moves the others. The space after each word is its right padding, so the first word lines
       up with the page and the light centres on the word; the bottom margin is the room for the thread. -->
  <Style x:Key="ThreadWord" TargetType="ButtonBase">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="19"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0,0,26,0"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
    <Trigger Property="AutomationProperties.ItemStatus" Value="Selected"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ThreadWordChoice" TargetType="RadioButton" BasedOn="{StaticResource ThreadWord}">
   <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers>
  </Style>
  <!-- A choice on a thread within a page, such as a folder's category: the interface's own type, smaller, closer together. -->
  <Style x:Key="ThreadOption" TargetType="ButtonBase" BasedOn="{StaticResource ThreadWord}">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0,0,18,0"/><Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="ThreadOptionChoice" TargetType="RadioButton" BasedOn="{StaticResource ThreadOption}">
   <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers>
  </Style>
  <!-- How many titles a category holds, written after its word as part of the same label: the same serif, size and ink, so it
       brightens with the word. Old-style figures sit among the lowercase like letters rather than standing up like capitals. -->
  <Style x:Key="CategoryCount" TargetType="Run"><Setter Property="Typography.NumeralStyle" Value="OldStyle"/></Style>
  <Style x:Key="BreadcrumbButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="15"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="LibraryBreadcrumbs" TargetType="ItemsControl">
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="2,1,2,0" VerticalAlignment="Center"/><Button Tag="{Binding}" Style="{StaticResource BreadcrumbButton}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"><TextBlock Text="{Binding Label}" MaxWidth="300" TextTrimming="CharacterEllipsis"/></Button></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding Separator}" Value=""><Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Separator}" Value="{x:Null}"><Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardWatchedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/>
   <Setter Property="Margin" Value="0,14,24,0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/>
   <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="#B3101015"/>
   <Setter Property="Foreground" Value="#F4F4F7"/><Setter Property="BorderBrush" Value="#66FFFFFF"/>
   <Setter Property="Content" Value="&#xE73E;"/><Setter Property="Opacity" Value="0"/>
   <Setter Property="ToolTip" Value="Mark as watched"/><Setter Property="AutomationProperties.Name" Value="Mark as watched"/>
   <!-- A small round pebble over the artwork, lit in the Success colour once the title is watched. -->
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <local:StoneHost>
     <local:Stone x:Name="CheckFrame" Depth="Disc" Background="{TemplateBinding Background}" CornerRadius="14" IsHitTestVisible="False"/>
     <Ellipse Fill="{StaticResource GlassDome}" IsHitTestVisible="False"/><Ellipse x:Name="Tint" Fill="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </local:StoneHost>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.16"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <!-- Unwatched titles show the control only while the card is hovered or the control has focus. -->
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
    <DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="{DynamicResource Success}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{DynamicResource Success}"/><Setter Property="ToolTip" Value="Mark as unwatched"/><Setter Property="AutomationProperties.Name" Value="Mark as unwatched"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="PosterCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Width" Value="180"/><Setter Property="Height" Value="312"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,0,14,18"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12"/>
     <Border x:Name="HoverFill" Background="{DynamicResource Surface}" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Width" Value="300"/><Setter Property="Height" Value="278"/></DataTrigger></Style.Triggers>
  </Style>
  <!-- Artwork rests on the page as a stone: a soft shadow below and no frame. Pointing at its card lifts it a little higher. -->
  <Style x:Key="ArtworkFrame" TargetType="local:Stone">
   <Setter Property="Depth" Value="Poster"/><Setter Property="Background" Value="{DynamicResource Elevated}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="local:RoundedClip.Radius" Value="12"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Depth" Value="Lifted"/><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-3"/></Setter.Value></Setter></DataTrigger></Style.Triggers>
  </Style>
  <!-- Round arrow that pages a horizontal row; it floats over the artwork, so it carries its own shadow. -->
  <Style x:Key="PagerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="0"/>
   <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{DynamicResource PebbleFill}"/>
   <Setter Property="Panel.ZIndex" Value="2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <local:StoneHost><local:Stone Depth="Pebble" Background="{TemplateBinding Background}" CornerRadius="20" IsHitTestVisible="False"/><Ellipse Fill="{DynamicResource PebbleDome}" IsHitTestVisible="False"/><Ellipse x:Name="Tint" Fill="{DynamicResource Ink}" Opacity="0" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></local:StoneHost>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.08"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.16"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="local:HorizontalScroller">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:HorizontalScroller">
    <Grid>
     <ScrollViewer x:Name="PART_Scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"><ContentPresenter Margin="{TemplateBinding Padding}"/></ScrollViewer>
     <Rectangle x:Name="PART_FadeLeft" Width="64" HorizontalAlignment="Left" Fill="{DynamicResource EdgeFadeLeft}" IsHitTestVisible="False" Opacity="0"/>
     <Rectangle x:Name="PART_FadeRight" Width="64" HorizontalAlignment="Right" Fill="{DynamicResource EdgeFadeRight}" IsHitTestVisible="False" Opacity="0"/>
     <Button x:Name="PART_Left" Style="{StaticResource PagerButton}" Content="&#xE76B;" HorizontalAlignment="Left" Margin="8,0,0,0" Visibility="Collapsed" IsHitTestVisible="False" ToolTip="Scroll left" AutomationProperties.Name="Scroll left"/>
     <Button x:Name="PART_Right" Style="{StaticResource PagerButton}" Content="&#xE76C;" HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed" IsHitTestVisible="False" ToolTip="Scroll right" AutomationProperties.Name="Scroll right"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,8,12,12"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="SettingsPrimary" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Template" Value="{StaticResource PebbleTemplate}"/><Setter Property="local:Pebble.Lit" Value="True"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/><Setter Property="HasDropShadow" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" MaxWidth="360"><ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="HorizontalOffset" Value="-8"/><Setter Property="VerticalOffset" Value="-6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><local:Stone Margin="16,10,16,22" Depth="Popup" Background="{DynamicResource Raised}" CornerRadius="14" Padding="4" MinWidth="200"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></local:Stone></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid>
     <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,8"><DockPanel><TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"/><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></DockPanel></Border>
     <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-12" VerticalOffset="-14" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <local:Stone Margin="16,10,16,22" Depth="Popup" Background="{DynamicResource Raised}" CornerRadius="14" Padding="4" MinWidth="180"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></local:Stone>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,4" Background="{DynamicResource Line}"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="{DynamicResource Well}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="TemplateRoot" ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/><Border x:Name="Sweep" Background="{TemplateBinding Foreground}" CornerRadius="2" Width="40" HorizontalAlignment="Left" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform x:Name="SweepOffset" X="-40"/></Border.RenderTransform></Border></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Sweep" Property="Visibility" Value="Visible"/></Trigger>
     <!-- Sweep only while shown: a forever storyboard on a collapsed bar keeps producing frames for the rest of the session. -->
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsIndeterminate" Value="True"/><Condition Property="IsVisible" Value="True"/></MultiTrigger.Conditions>
      <MultiTrigger.EnterActions><BeginStoryboard x:Name="SweepMotion"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="SweepOffset" Storyboard.TargetProperty="X" From="-40" To="160" Duration="0:0:1.4"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
      <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SweepMotion"/></MultiTrigger.ExitActions></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <!-- Card progress keeps its space but stays invisible until playback has started. -->
  <Style x:Key="CardProgress" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="0"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource Line}" CornerRadius="3" Margin="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ScrollTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Horizontal"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollTrackButton}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollTrackButton}"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
  <!-- A slim scroll bar that floats over its content: a 4 px rounded thumb that widens and brightens under the pointer. -->
  <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent">
     <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Border Background="Transparent"><Border x:Name="Grip" Width="4" HorizontalAlignment="Center" CornerRadius="3" Background="{DynamicResource Muted}" Opacity="0.4" Margin="0,2"/></Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Width" Value="6"/><Setter TargetName="Grip" Property="Opacity" Value="0.75"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Width" Value="6"/><Setter TargetName="Grip" Property="Opacity" Value="0.9"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A vertical scroll view whose slim bar floats over the content's right edge (or, with a negative right margin, in the
       space beside it), so the content keeps its width whether or not the bar shows. Padding insets the content. -->
  <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SlimScrollBar}" HorizontalAlignment="Right" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Window caption buttons drawn by the app in place of the system title bar. -->
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent">
     <Border x:Name="Frame" Background="{TemplateBinding Background}"/>
     <Border x:Name="Tint" Background="{DynamicResource Ink}" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.08"/></Trigger>
     <!-- The maximize button is hit-tested natively for snap layouts, so code reports its hover state through Tag. -->
     <Trigger Property="Tag" Value="hover"><Setter TargetName="Tint" Property="Opacity" Value="0.08"/></Trigger>
     <Trigger Property="Tag" Value="pressed"><Setter TargetName="Tint" Property="Opacity" Value="0.14"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.14"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#B02718"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
   </Style.Triggers>
  </Style>

  <!-- Window buttons in the player's top bar, which replaces the caption row while the player is docked.
       The bar lives in LibVLC's overlay window, so these don't follow the main window's active state. -->
  <Style x:Key="PlayerCaptionButton" TargetType="Button">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalAlignment" Value="Top"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent">
     <Border x:Name="Frame" Background="{TemplateBinding Background}"/>
     <Border x:Name="Tint" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.16"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource PlayerCaptionButton}">
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#B02718"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
   </Style.Triggers>
  </Style>

  <!-- The player's stones are dark glass: a fill that is a little lighter at the top, an edge lit along the top that fades down
       its sides instead of a full outline, and the same dome as the pebbles. Play is a white pebble. -->
  <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E6202028" Offset="0"/><GradientStop Color="#D914141A" Offset="0.55"/><GradientStop Color="#DC0E0E12" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassLift" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#21FFFFFF" Offset="0"/><GradientStop Color="#12FFFFFF" Offset="0.55"/><GradientStop Color="#0AFFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#0FFFFFFF" Offset="0.5"/><GradientStop Color="#08FFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="InkDome" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.5"/><GradientStop Color="#33000000" Offset="1"/></LinearGradientBrush>
  <!-- Player controls: borderless icon buttons on a dark bar. -->
  <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,8"/>
   <Setter Property="Background" Value="#1AFFFFFF"/><Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="34"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/><Border x:Name="Tint" Background="#FFFFFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.18"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerIconButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="40"/><Setter Property="MinWidth" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="16"/></Style>
  <Style x:Key="PlayerPlayButton" TargetType="Button" BasedOn="{StaticResource PlayerIconButton}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="Background" Value="{StaticResource PlayerInk}"/><Setter Property="Foreground" Value="#111216"/><Setter Property="FontSize" Value="18"/><Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><local:StoneHost><local:Stone x:Name="Frame" Depth="Pebble" AlwaysDark="True" Background="{TemplateBinding Background}" CornerRadius="23" IsHitTestVisible="False"/><Ellipse Fill="{StaticResource InkDome}" IsHitTestVisible="False"/><Ellipse x:Name="Tint" Fill="#000000" Opacity="0" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></local:StoneHost><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PlayerOptionButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
   <Setter Property="MinHeight" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,8,8"/>
  </Style>
  <Style x:Key="PlayerOptionPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <!-- ComboBox only virtualizes when asked; long pickers realize just the visible rows. -->
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
   <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="MinHeight" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,12,8"/>
  </Style>
  <!-- Status pills in the control bar show the current choice; most open a menu above themselves. -->
  <Style x:Key="PlayerPill" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="Background" Value="{StaticResource GlassLift}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"/><Border x:Name="Lit" Background="{DynamicResource PlayerAccentTint}" CornerRadius="14" Visibility="Collapsed" IsHitTestVisible="False"/><Border Background="{StaticResource GlassDome}" CornerRadius="14" IsHitTestVisible="False"/><Border x:Name="Tint" Background="#FFFFFF" Opacity="0" CornerRadius="14" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.08"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Lit" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A pill bound to a StaysOpen=False menu ignores clicks while open, so clicking it again closes the menu instead of reopening it. -->
  <Style x:Key="PlayerMenuPill" TargetType="ToggleButton" BasedOn="{StaticResource PlayerPill}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="IsHitTestVisible" Value="False"/></Trigger></Style.Triggers></Style>
  <Style x:Key="PlayerPillText" TargetType="TextBlock"><Setter Property="MaxWidth" Value="130"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <!-- The muted detail after a pill's choice, such as "5.1" or "3 / 8"; it collapses when empty or when the bar is narrow. -->
  <Style x:Key="PlayerPillDetail" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PlayerMuted}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="MaxWidth" Value="96"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style x:Key="PlayerPillChevron" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="8"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource PlayerMuted}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,1,0,0"/>
   <!-- The chevron turns over while its menu is open. -->
   <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><RotateTransform/></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
    <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
    <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
   </DataTrigger></Style.Triggers></Style>
  <Style x:Key="PlayerPillIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource PlayerMuted}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
  <Style x:Key="PlayerMenuPopup" TargetType="Popup"><Setter Property="Placement" Value="Top"/><Setter Property="StaysOpen" Value="False"/><Setter Property="AllowsTransparency" Value="True"/><Setter Property="PopupAnimation" Value="None"/><Setter Property="HorizontalOffset" Value="-12"/><Setter Property="VerticalOffset" Value="4"/></Style>
  <!-- The menu's stone draws its shadow from a cached bitmap rather than an effect, so hovering and scrolling don't re-render the whole popup. -->
  <Style x:Key="PlayerMenu" TargetType="ContentControl"><Setter Property="Margin" Value="12"/><Setter Property="MinWidth" Value="240"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><local:Stone Depth="Chip" AlwaysDark="True" Background="#F717181F" CornerRadius="14" Padding="4,6"><ContentPresenter/></local:Stone></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerMenuCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PlayerMuted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="10,4,10,6"/></Style>
  <Style x:Key="PlayerMenuItem" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="Padding" Value="8,7,12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource PlayerAccent}" VerticalAlignment="Center" Visibility="Hidden"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1AFFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerQueueItem" TargetType="ListBoxItem" BasedOn="{StaticResource PlayerMenuItem}">
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1AFFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource PlayerAccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerMenuList" TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MaxWidth" Value="420"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ItemContainerStyle" Value="{StaticResource PlayerMenuItem}"/>
   <!-- Long episode lists only realize the rows in view; pixel scrolling keeps it smooth. -->
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerMenuButton" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="Padding" Value="8,7,12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1AFFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Translucent buttons and chips for the top bar over the video. -->
  <!-- Everything in the player is a pill. Over the video they are dark glass; inside the dock, which is already glass, a faint lift. -->
  <ControlTemplate x:Key="PlayerRoundTemplate" TargetType="Button"><Grid><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"/><Border Background="{StaticResource GlassDome}" CornerRadius="14" IsHitTestVisible="False"/><Border x:Name="Tint" Background="#FFFFFF" Opacity="0" CornerRadius="14" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.18"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
  <Style x:Key="PlayerGlassButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}"><Setter Property="Background" Value="{StaticResource GlassFill}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="28"/><Setter Property="Padding" Value="11,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Template" Value="{StaticResource PlayerRoundTemplate}"/></Style>
  <Style x:Key="PlayerChip" TargetType="Border"><Setter Property="Background" Value="{StaticResource GlassFill}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <Style x:Key="PlayerChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource PlayerPill}"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Background" Value="{StaticResource GlassFill}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <!-- A pill holding a row of buttons, such as previous, play and next, or volume, picture in picture and fullscreen. -->
  <Style x:Key="PlayerPillGroup" TargetType="Border"><Setter Property="Background" Value="{StaticResource GlassLift}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="1"/><Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="PlayerHeaderGroup" TargetType="Border" BasedOn="{StaticResource PlayerPillGroup}"><Setter Property="Background" Value="{StaticResource GlassFill}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <Style x:Key="PlayerSegmentButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="MinWidth" Value="28"/><Setter Property="Padding" Value="9,0"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border Background="{TemplateBinding Background}" CornerRadius="12"/><Border x:Name="Tint" Background="#FFFFFF" Opacity="0" CornerRadius="12" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.18"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PlayerSegmentIcon" TargetType="Button" BasedOn="{StaticResource PlayerSegmentButton}"><Setter Property="Width" Value="30"/><Setter Property="MinWidth" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="13"/></Style>
  <!-- Play is the one solid shape in the bar. -->
  <Style x:Key="PlayerSegmentPlay" TargetType="Button" BasedOn="{StaticResource PlayerSegmentIcon}"><Setter Property="Width" Value="38"/><Setter Property="Margin" Value="1,0"/><Setter Property="Background" Value="{StaticResource PlayerInk}"/><Setter Property="Foreground" Value="#111216"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border Background="{TemplateBinding Background}" CornerRadius="12"/><Border Background="{StaticResource InkDome}" CornerRadius="12" IsHitTestVisible="False"/><Border x:Name="Tint" Background="#000000" Opacity="0" CornerRadius="12" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- An on/off icon in a pill group, such as Loop: accent-tinted while on. -->
  <Style x:Key="PlayerSegmentToggle" TargetType="ToggleButton"><Setter Property="Foreground" Value="{StaticResource PlayerInk}"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12"/><Border x:Name="Tint" Background="#FFFFFF" Opacity="0" CornerRadius="12" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource PlayerAccentTint}"/><Setter Property="Foreground" Value="{DynamicResource PlayerAccent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.18"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- One half of a two-way switch, such as Episodes / Queue in the queue menu. -->
  <Style x:Key="PlayerSegment" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{StaticResource PlayerMuted}"/><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#14FFFFFF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource PlayerAccentTint}"/><Setter Property="Foreground" Value="{DynamicResource PlayerAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Track rows show the language, then muted details such as the channel layout or format. -->
  <DataTemplate x:Key="PlayerTrackRow"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Detail, FallbackValue={x:Null}}" Foreground="{StaticResource PlayerMuted}" FontWeight="Normal" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <!-- Queue and episode rows: position or a playing mark, title, runtime. Watched episodes and played queue items are dimmed. -->
  <DataTemplate x:Key="PlayerQueueRow"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Converter={StaticResource QueueRow}, ConverterParameter=number}" Foreground="#7D7F8C" FontSize="11.5" FontWeight="Normal" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
   <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource PlayerAccent}" VerticalAlignment="Center" Visibility="{Binding Converter={StaticResource QueueRow}, ConverterParameter=playing}"/>
   <TextBlock Grid.Column="1" Text="{Binding QueueTitle}" Foreground="{Binding Converter={StaticResource QueueRow}, ConverterParameter=foreground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource QueueRow}, ConverterParameter=runtime}" Foreground="#7D7F8C" FontSize="11" FontWeight="Normal" Margin="10,0,0,0" VerticalAlignment="Center"/>
  </Grid></DataTemplate>
  <Style x:Key="PlayerSlider" TargetType="Slider">
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid x:Name="Root" Background="Transparent"><Border x:Name="Rail" Height="3" Background="#40FFFFFF" CornerRadius="1.5" Margin="6,0"/><Track x:Name="PART_Track" Margin="0" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Margin="6,0,-6,0"><Border Height="9" Background="{DynamicResource PlayerAccent}" Opacity="0.2" CornerRadius="4.5"/><Border Height="3" Background="{DynamicResource PlayerAccent}" CornerRadius="1.5"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="KnobScale" ScaleX="0.75" ScaleY="0.75"/></Ellipse.RenderTransform></Ellipse><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Background" Value="#59FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A slider for pages in the theme's colours: an accent fill and a knob in the text colour with an accent centre that grows while it is pointed at,
       dragged or focused. Pressing anywhere on it moves the knob there and keeps following the pointer. -->
  <Style x:Key="AccentSlider" TargetType="Slider">
   <Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="local:SliderFollow.Enabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent">
     <Grid x:Name="Rail" Height="6" Margin="10,0"><Border CornerRadius="3" Background="{DynamicResource Well}"/><Border CornerRadius="3" Background="{DynamicResource WellShade}"/></Grid>
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
       <Grid Margin="10,0,-10,0"><Border Height="12" CornerRadius="6" Background="{DynamicResource Accent}" Opacity="0.16"/><Border Height="6" CornerRadius="3" Background="{DynamicResource Accent}"/></Grid>
      </ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="20" Height="20" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Grid>
        <Ellipse x:Name="Halo" Margin="-6" Fill="{DynamicResource Accent}" Opacity="0"/>
        <local:Stone Depth="Disc" Background="{DynamicResource Ink}" CornerRadius="10"/>
        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="DotScale"/></Ellipse.RenderTransform></Ellipse>
       </Grid>
       <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
         <Setter TargetName="Dot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></Setter.Value></Setter>
         <Setter TargetName="Halo" Property="Opacity" Value="0.14"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
         <Setter TargetName="Halo" Property="Opacity" Value="0.24"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
         <Setter TargetName="Dot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.4" ScaleY="1.4"/></Setter.Value></Setter>
         <Setter TargetName="Halo" Property="Opacity" Value="0.24"/>
        </DataTrigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
       <Border Background="Transparent"/>
      </ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The volume flyout's slider: PlayerSlider stood upright, filling from the bottom. -->
  <Style x:Key="PlayerVerticalSlider" TargetType="Slider">
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Width" Value="24"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid x:Name="Root" Background="Transparent"><Border x:Name="Rail" Width="4" Background="#40FFFFFF" CornerRadius="2" Margin="0,6"/><Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Margin="0,-6,0,6"><Border Width="10" Background="{DynamicResource PlayerAccent}" Opacity="0.2" CornerRadius="5"/><Border Width="4" Background="{DynamicResource PlayerAccent}" CornerRadius="2"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75"/></Ellipse.RenderTransform></Ellipse><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Background" Value="#59FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
