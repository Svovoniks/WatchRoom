     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="MetadataPreferences" Tag="Metadata" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Margin="0,0,18,12" HorizontalAlignment="Stretch">
      <TextBlock Text="Library metadata" Style="{StaticResource SectionHeading}"/>
