     <StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}" Foreground="{DynamicResource Muted}"/><TextBlock Text="No titles found" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Try another search or clear your filters." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,22"/><Button Content="Clear search and filters" Click="ResetFilters" HorizontalAlignment="Center" Margin="0"/></StackPanel></Grid>
    <Border Grid.Row="2" x:Name="NowPlayingStrip" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Return to player" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Tag="Room" Click="Navigate" Margin="12,0,0,0"/><TextBlock Text="&#xE714;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="2,0,12,0"/><TextBlock x:Name="NowPlayingLabel" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
