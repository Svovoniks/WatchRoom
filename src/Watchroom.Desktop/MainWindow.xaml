 <Border x:Name="UpdateCard" Grid.Column="1" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="440" Margin="24" Padding="22" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource Surface}"><StackPanel><TextBlock x:Name="UpdateCardTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="UpdateCardStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,16" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,14"/><WrapPanel><Button x:Name="InstallUpdateButton" Content="Update" Click="InstallUpdate" Style="{StaticResource Primary}"/><Button x:Name="DismissUpdateButton" Content="Later" Click="DismissUpdate"/></WrapPanel></StackPanel></Border></Grid>
