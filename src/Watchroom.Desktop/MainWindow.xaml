       <WrapPanel Margin="0,12,0,-8"><Button x:Name="ExcludeFolderButton" Content="Exclude folder" Click="ExcludeFolder"/><Button x:Name="RestoreFolderButton" Content="Remove exclusion" Style="{StaticResource QuietButton}" Click="RestoreFolder" IsEnabled="False"/></WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel></Grid>
   </ScrollViewer>

   <!-- Queues -->
   <Grid x:Name="QueuesPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Create queue" Click="CreateQueue" ContentTemplate="{StaticResource AddContent}" VerticalAlignment="Center" Style="{StaticResource Primary}" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Queues" Style="{StaticResource PageHeading}"/><TextBlock Text="Line up movies and episodes to play back to back." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ListBox Grid.Row="1" x:Name="QueuePicker" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="SavedQueueChanged" AutomationProperties.Name="Saved queues" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}, {1} videos"><Binding Path="Name"/><Binding Path="MediaIds.Length"/></MultiBinding></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,4"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaIds.Length, StringFormat={}{0} videos}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,20,22,10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="QueueDetailTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="QueueDetailCaption" Style="{StaticResource MutedText}" Margin="0,4,0,14"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,0,10"><WrapPanel><Button x:Name="PlaySavedQueueButton" Content="Play queue" Click="PlaySavedQueue" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="PlaySelectedSavedQueueButton" Content="Play selected" Click="PlaySelectedSavedQueue" IsEnabled="False"/><Button x:Name="AddQueueVideosButton" Content="Add videos" Click="AddQueueVideos"/></WrapPanel><TextBlock x:Name="SavedQueueFeedback" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
       <Grid Grid.Row="2">
        <ListBox x:Name="SavedQueueItems" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="SavedQueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" AutomationProperties.Name="Queue videos" AutomationProperties.HelpText="Select a video and choose Play selected, double-click it, or press Enter to play from that point in the queue." Background="Transparent" BorderThickness="0" Padding="0" AllowDrop="True" PreviewMouseMove="QueueDragMove" PreviewDragOver="QueueDragOver" DragLeave="QueueDragLeave" PreviewDrop="QueueDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder" PreviewMouseLeftButtonDown="QueueDragDown"><TextBlock Text="&#xE700;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}"/></Border>
          <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,2,12,2"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
          <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource QuietIcon}" FontSize="12" Width="36" Height="36" Margin="0" VerticalAlignment="Center" Tag="{Binding}" Click="RemoveSavedItem" ToolTip="Remove from queue" AutomationProperties.Name="Remove video from queue"/>
         </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="QueueEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Margin="16"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SavedQueueItems}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE8FD;" Style="{StaticResource EmptyStateIcon}"/><TextBlock Text="Nothing queued yet" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Add movies or episodes from your library, then arrange them in the order you want to watch." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel><Border x:Name="QueueDropMarker" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
       </Grid>
       <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0"><WrapPanel><Button x:Name="SavedQueueEarlier" Content="&#xE70E;" Style="{StaticResource IconButton}" FontSize="12" ToolTip="Move earlier" AutomationProperties.Name="Move earlier" Tag="Earlier" Click="EditQueueOrder" IsEnabled="False"/><Button x:Name="SavedQueueLater" Content="&#xE70D;" Style="{StaticResource IconButton}" FontSize="12" ToolTip="Move later" AutomationProperties.Name="Move later" Tag="Later" Click="EditQueueOrder" IsEnabled="False"/><Button Content="Rename" Style="{StaticResource QuietButton}" Click="RenameQueue"/><Button Content="Delete queue" Style="{StaticResource QuietButton}" Click="DeleteQueue"/></WrapPanel></Border>
      </Grid>
     </Border>
    </Grid>
   </Grid>

   <!-- Settings -->
   <Grid x:Name="SettingsPage" Visibility="Collapsed">
    <Grid.Resources>
     <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/><Setter Property="Margin" Value="0,0,0,8"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
     <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
     <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageHeading}" Margin="0,0,0,16"/>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,20">
      <WrapPanel x:Name="PreferenceSections">
       <Button Content="Profile" Tag="Profile" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Metadata" Tag="Metadata" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Playback" Tag="Playback" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Appearance" Tag="Appearance" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Updates &amp; about" Tag="Updates" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
      </WrapPanel>
     </Border>
    </StackPanel>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="ProfilePreferences" Tag="Profile" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Your display name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DisplayNameBox" AutomationProperties.Name="Your display name" MaxLength="40"/>
       <TextBlock x:Name="DisplayNameError" Style="{StaticResource FieldError}"/>
       <TextBlock Text="Shown to everyone in your watch rooms." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Watchroom server" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ServerBox" AutomationProperties.Name="Room server address"/>
       <TextBlock x:Name="ServerError" Style="{StaticResource FieldError}"/>
       <TextBlock Text="Change the server only if you host your own." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="MetadataPreferences" Tag="Metadata" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Sources" Style="{StaticResource CardTitle}"/>
       <CheckBox x:Name="AutoArtwork" Content="Automatically fetch artwork and metadata"/>
       <TextBlock Text="Providers · in priority order" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
       <ListBox x:Name="MetadataProviders" AutomationProperties.Name="Metadata provider order" Background="{DynamicResource Canvas}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Padding" Value="8,4"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="&#xE70E;" Tag="Up" Click="ProviderMoved" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}" Style="{StaticResource QuietIcon}" FontSize="11" Width="32" Height="32" MinHeight="32" Margin="4,0,0,0"/>
         <Button Content="&#xE70D;" Tag="Down" Click="ProviderMoved" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}" Style="{StaticResource QuietIcon}" FontSize="11" Width="32" Height="32" MinHeight="32" Margin="4,0,0,0"/>
        </StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="PreferencesChanged" Margin="0" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="Providers receive title searches, never video files. Disable all to use local metadata." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Region" Style="{StaticResource CardTitle}"/>
       <WrapPanel><StackPanel Width="270" Margin="0,0,16,0"><TextBlock Text="Language" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MetadataLanguage" AutomationProperties.Name="Metadata language" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Margin="0,6,0,8"/></StackPanel><StackPanel Width="270"><TextBlock Text="Country" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MetadataCountry" AutomationProperties.Name="Metadata country" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Margin="0,6,0,8"/></StackPanel></WrapPanel>
       <TextBlock x:Name="LocaleError" Style="{StaticResource FieldError}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Refresh and organization" Style="{StaticResource CardTitle}"/>
       <WrapPanel><CheckBox x:Name="NeverRefresh" Content="Never refresh automatically" Margin="-4,6,18,6"/><TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="RefreshLess" Content="&#xE738;" Style="{StaticResource IconButton}" FontSize="11" Click="ChangeRefreshDays" AutomationProperties.Name="Decrease refresh days" Margin="0,6,4,12" VerticalAlignment="Center"/>
        <TextBox x:Name="MetadataRefreshDays" Width="60" TextAlignment="Center" AutomationProperties.Name="Refresh interval in days" MaxLength="3" VerticalAlignment="Center"/>
        <Button x:Name="RefreshMore" Content="&#xE710;" Style="{StaticResource IconButton}" FontSize="11" Click="ChangeRefreshDays" AutomationProperties.Name="Increase refresh days" Margin="4,6,8,12" VerticalAlignment="Center"/>
        <TextBlock Text="days (1–365)" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
       </WrapPanel><TextBlock x:Name="RefreshDaysError" Style="{StaticResource FieldError}"/>
       <CheckBox x:Name="GroupShows" Content="Combine show folders when provider IDs match"/><CheckBox x:Name="ImportMissing" Content="Show missing episodes"/><CheckBox x:Name="ImportUpcoming" Content="Show upcoming episodes"/><CheckBox x:Name="DisplaySpecials" Content="Show specials within their aired seasons when placement is known"/><CheckBox x:Name="SaveNfo" Content="Save metadata beside videos as NFO files"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="TMDB key override" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Optional personal key; leave blank to use the bundled WatchRoom key." Style="{StaticResource Hint}"/><PasswordBox x:Name="MetadataToken" AutomationProperties.Name="TMDB API key or read access token" PasswordChanged="MetadataKeyChanged"/>
       <TextBlock x:Name="MetadataKeyStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
       <TextBlock Text="Save changes stores the key in Windows Credential Manager. Clear it and save to remove it." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Manual refresh" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="Uses saved preferences." Style="{StaticResource Hint}"/>
       <WrapPanel Margin="0,8,0,-8"><ComboBox x:Name="MetadataRefreshMode" SelectedIndex="0" MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="Metadata refresh action"><ComboBoxItem Content="Fill missing metadata"/><ComboBoxItem Content="Refresh text metadata"/><ComboBoxItem Content="Refresh text and replace downloaded artwork"/><ComboBoxItem Content="Retry missing artwork"/></ComboBox>
       <Button Content="Fetch artwork and metadata" Click="FetchArtworkClick" HorizontalAlignment="Left"/></WrapPanel>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="PlaybackPreferences" Tag="Playback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Languages" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Watchroom picks the first language each video has, in this order." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Audio" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0"/>
        <local:LanguagePriorityPicker Grid.Column="1" x:Name="PreferredAudioLanguages" AutomationProperties.Name="Preferred audio languages in priority order" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Subtitles" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0"/>
        <local:LanguagePriorityPicker Grid.Row="1" Grid.Column="1" x:Name="PreferredSubtitleLanguages" AllowOff="True" AutomationProperties.Name="Default subtitle languages in priority order"/>
       </Grid>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Subtitle exceptions" Style="{StaticResource FieldLabel}"/>
         <TextBlock Text="Override the subtitle list for specific audio languages — for example, when the audio is English, show no subtitles." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
         <ItemsControl x:Name="SubtitleLanguageRules" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate>
          <!-- Each exception reads as a sentence: when the audio is X, show subtitles in Y. -->
          <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10,8,6" Margin="0,0,0,8">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="When the audio is" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,7,0,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{x:Static local:LanguagePriorityPicker.AudioOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding AudioLanguage, UpdateSourceTrigger=PropertyChanged}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Audio language for subtitle rule" ToolTip="When the audio is in this language" Width="200" Height="32" MinHeight="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,8"/>
            <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource QuietIcon}" FontSize="12" Click="RemoveSubtitleRule" ToolTip="Remove exception" AutomationProperties.Name="Remove subtitle language rule" VerticalAlignment="Top" Width="32" Height="32" MinHeight="32" Margin="6,0,0,0"/>
            <TextBlock Grid.Row="1" Text="Show subtitles in" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,7,0,0"/>
            <local:LanguagePriorityPicker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SubtitleLanguages, UpdateSourceTrigger=PropertyChanged}" AllowOff="True" EmptyText="Nothing chosen yet" AutomationProperties.Name="Subtitle languages for audio language in priority order"/>
           </Grid>
          </Border>         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <Button x:Name="AddSubtitleRuleButton" Content="Add exception" Style="{StaticResource QuietButton}" ContentTemplate="{StaticResource AddContent}" Click="AddSubtitleRule" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
        </StackPanel>
       </Border>
       <Expander Header="How language preferences work" Foreground="{DynamicResource Muted}" Margin="-6,8,0,0"><TextBlock Text="Each list is tried in order until the video has a matching track; an empty list uses the video's own defaults. Exceptions follow the selected audio language, and adding Off last turns subtitles off when nothing matches. Manual subtitle choices last until the next video. Saved preferences apply to the next video; guests follow the host’s tracks." Style="{StaticResource Hint}" Margin="0,4,0,0"/></Expander>
       <TextBlock x:Name="TrackPreferencesError" Style="{StaticResource FieldError}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Streaming buffer" Style="{StaticResource CardTitle}"/>
       <TextBlock Text="Video to buffer ahead (seconds)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StreamingBufferSeconds" MaxLength="3" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Video buffer ahead in seconds" ToolTip="Choose from 2 to 60 seconds"/>
       <TextBlock x:Name="StreamingBufferError" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock Text="Default: 30 seconds. Playback starts as soon as a few seconds are ready; Watchroom then keeps downloading up to this much video ahead while you watch. Applies to the next streamed video. Larger buffers use more memory but do not delay starting or seeking. During a brief host connection interruption, playback continues from buffered video for up to this time, then pauses if recovery has not finished. Actual coverage depends on available bandwidth." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="FFmpeg executable (optional)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FfmpegBox" AutomationProperties.Name="FFmpeg executable path" ToolTip="Used to generate episode thumbnails" Margin="0,6,0,4"/>
       <TextBlock Text="Used to generate episode thumbnails from your videos." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="AppearancePreferences" Tag="Appearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,12">
      <Border Style="{StaticResource Card}"><DockPanel>
       <Button DockPanel.Dock="Right" Content="Switch light / dark" Click="ToggleTheme" VerticalAlignment="Center" Margin="16,0,0,0"/>
       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0"><TextBlock Text="&#xE790;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ThemeStatus" Style="{StaticResource Hint}"/><TextBlock Text="Saved immediately." Style="{StaticResource Hint}"/></StackPanel>
      </DockPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="UpdatePreferences" Tag="Updates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,18,12">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="App updates" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/><CheckBox x:Name="AutoCheckUpdates" Content="Automatically check for updates" Checked="AutoUpdatesChanged" Unchecked="AutoUpdatesChanged"/><TextBlock Text="Checks at startup and every six hours. Updates install only when you click Update. Update preferences save immediately." Style="{StaticResource Hint}" Margin="0,4,0,0"/><Button x:Name="CheckUpdatesButton" Content="Check for updates" ContentTemplate="{StaticResource RefreshContent}" Click="CheckUpdatesClick" HorizontalAlignment="Left" Margin="0,14,0,8"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="For connection or playback issues, share logs from both devices. Invitations, credentials and videos are excluded." Style="{StaticResource Hint}"/><Button x:Name="OpenLogsFolderButton" Content="Open logs folder" Click="OpenLogsFolder" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="About" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="Video playback by libVLC / LibVLCSharp. Peer connections by libdatachannel / DataChannelDotnet. Artwork by TVmaze (https://www.tvmaze.com, CC BY-SA), Wikipedia, and TMDB. Source pages appear in title details." Style="{StaticResource Hint}"/><Image Source="Assets/Tmdb.png" Width="200" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,16,0,6" AutomationProperties.Name="The Movie Database logo"/><TextBlock><Hyperlink NavigateUri="https://www.themoviedb.org" RequestNavigate="OpenTmdbAttribution" Foreground="{DynamicResource Accent}">The Movie Database</Hyperlink></TextBlock><TextBlock Text="This application uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB." Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="Streaming-provider data supplied by JustWatch via TMDB." Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock><Hyperlink NavigateUri="https://www.justwatch.com/" RequestNavigate="OpenTmdbAttribution" Foreground="{DynamicResource Accent}">JustWatch</Hyperlink></TextBlock>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Canvas}" Padding="0,12,0,0" Margin="0,4,0,0">
     <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="CancelPreferencesButton" Content="Cancel" Style="{StaticResource QuietButton}" Click="CancelPreferences" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="SavePreferencesButton" Content="Save changes" Click="SaveSettings" Style="{StaticResource Primary}" IsEnabled="False" Margin="0"/></WrapPanel><TextBlock x:Name="PreferencesStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,16,0"/></DockPanel>
    </Border>
   </Grid>

   <!-- Saved watch rooms -->
   <Grid x:Name="RoomsPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Watch rooms" Style="{StaticResource PageHeading}"/><TextBlock Text="Watch in sync with friends. Only the host needs the video." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ReturnToRoomButton" Content="Return to player" ContentTemplate="{StaticResource PlayContent}" Tag="Room" Click="Navigate" Margin="0,0,8,0"/><Button x:Name="AddSavedInvitationButton" Content="Join a room" Click="JoinClick" Margin="0,0,8,0" ToolTip="Paste an invitation link or room code to add it to your saved rooms"/><Button x:Name="CreateSavedRoomButton" Content="Create room" ContentTemplate="{StaticResource AddContent}" Click="CreatePersistentRoom" Style="{StaticResource Primary}" Margin="0"/></StackPanel></Grid>
    <Grid Grid.Row="1"><StackPanel x:Name="RoomsEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" Margin="0,0,0,22"><TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock Text="Watch together" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Create a room and invite friends, or paste an invitation to join theirs." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,24"/><WrapPanel HorizontalAlignment="Center"><Button Content="Create room" ContentTemplate="{StaticResource AddContent}" Click="CreatePersistentRoom" Style="{StaticResource Primary}"/><Button Content="Join a room" Click="JoinClick" Margin="0,0,0,8"/></WrapPanel></StackPanel><Grid x:Name="SavedRoomsContent" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel><ListBox x:Name="SavedRoomsList" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="SavedRoomSelectionChanged" AutomationProperties.Name="Saved watch rooms" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,4"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
     <Border x:Name="SavedRoomDetails" Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,20,10,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
       <TextBlock x:Name="SavedRoomHeading" Text="Choose a room" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="SavedRoomStatus" Text="Create a room or save an invitation to get started." Style="{StaticResource MutedText}" Margin="0,4,0,16"/>
       <WrapPanel><Button x:Name="ConnectSavedRoomButton" Content="Connect" Click="ConnectSavedRoom" Style="{StaticResource Primary}"/><Button x:Name="DisconnectSavedRoomButton" Content="Disconnect" Click="LeaveRoom" Visibility="Collapsed" AutomationProperties.Name="Disconnect from room"/><Button x:Name="CopySavedInviteButton" Content="Copy invitation" Click="CopySavedInvitation"/></WrapPanel>
       <StackPanel x:Name="SavedRoomHostControls"><TextBlock Text="Permissions" Style="{StaticResource SectionHeading}"/>
        <ToggleButton x:Name="SavedRoomSharedControls" Content="Guest playback controls" ToolTip="Guests can play, pause and seek. Changes save immediately." Click="SavedRoomControlsChanged" AutomationProperties.Name="Saved room shared controls" Style="{StaticResource Switch}"/>
        <CheckBox x:Name="SavedRoomLibraryBrowsing" Content="Allow guests to browse my library" ToolTip="One admitted guest can browse at a time. Turning this off ends the active session." Checked="SavedRoomLibraryChanged" Unchecked="SavedRoomLibraryChanged"/>
       </StackPanel><Button x:Name="SavedRoomLibraryButton" Content="Room library" Click="OpenRoomLibrary" HorizontalAlignment="Left" IsEnabled="False" Margin="0,12,0,0"/>
       <StackPanel x:Name="SavedRoomGuestManagement"><TextBlock Text="Guests" Style="{StaticResource SectionHeading}"/>
        <TextBlock x:Name="SavedRoomGuestHint" Text="Connect as the host to manage guests. Admitted guests are remembered when they reconnect." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
        <ItemsControl x:Name="SavedRoomGuests" AutomationProperties.Name="Saved room guests"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource Elevated}" CornerRadius="10" Padding="12,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><WrapPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="{Binding AdmitLabel}" Tag="{Binding Id}" Click="Admit" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Style="{StaticResource Primary}" Padding="10,0" MinHeight="32" Height="32" Margin="0,0,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" IsEnabled="{Binding CanRemove}" Style="{StaticResource QuietButton}" Padding="10,0" MinHeight="32" Height="32" Margin="0"/></WrapPanel></Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,12,0,0"><WrapPanel><Button x:Name="RenameSavedRoomButton" Content="Rename" Style="{StaticResource QuietButton}" Click="RenameSavedRoom"/><Button x:Name="ForgetSavedRoomButton" Content="Forget room" Style="{StaticResource QuietButton}" Click="ForgetSavedRoom"/></WrapPanel></Border>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid></Grid>
   </Grid>

   <!-- Player. Always dark: the app palette keys are remapped for everything inside it. -->
   <Grid x:Name="RoomPage" Visibility="Collapsed" Background="#0B0B0E" TextElement.Foreground="#F4F4F7">
    <Grid.Resources>
     <SolidColorBrush x:Key="Canvas" Color="#0B0B0E"/><SolidColorBrush x:Key="Surface" Color="#17181F"/><SolidColorBrush x:Key="Elevated" Color="#23242E"/><SolidColorBrush x:Key="Ink" Color="#F4F4F7"/><SolidColorBrush x:Key="Muted" Color="#B4B6C2"/><SolidColorBrush x:Key="Line" Color="#2E303B"/><SolidColorBrush x:Key="Accent" Color="#A991FF"/><SolidColorBrush x:Key="AccentInk" Color="#160E2E"/><SolidColorBrush x:Key="Hover" Color="#2A2C37"/><SolidColorBrush x:Key="AccentSoft" Color="#2A2442"/>
    </Grid.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="0" x:Name="RoomSplitterWidth"/><ColumnDefinition Width="0" x:Name="RoomSideWidth" MaxWidth="600"/></Grid.ColumnDefinitions>
     <Border x:Name="VideoFrame" Background="Black">
      <vlc:VideoView x:Name="Video">
       <!-- A nonzero alpha keeps the native overlay hit-testable over the video. -->
       <Grid x:Name="PlayerOverlay" Background="#01000000" Focusable="True" MouseMove="PlayerMouseMoved" MouseLeftButtonDown="VideoClicked" MouseWheel="VideoWheel" PreviewKeyDown="KeyPressed">
        <Border x:Name="PlayerEmpty" Background="#0B0B0E"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="76" Height="76" CornerRadius="38" Background="#2A2442" HorizontalAlignment="Center"><TextBlock Text="&#xF5B0;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="#A991FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/></Border><TextBlock Text="Choose a video to play" FontSize="21" FontWeight="SemiBold" Foreground="#F4F4F7" HorizontalAlignment="Center" Margin="0,20,0,20"/><Button Content="Browse library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" HorizontalAlignment="Center" Margin="0"/></StackPanel></Viewbox></Border>
        <StackPanel VerticalAlignment="Top">
         <!-- Top bar: back, title, room status and room actions. It hides and shows together with the bottom bar. -->
         <Border x:Name="RoomHeader" Background="{StaticResource PlayerHeaderFade}" Padding="14,12,14,30" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Button x:Name="PlayerBackButton" Content="&#xE72B;" Tag="Library" Click="Navigate" Style="{StaticResource PlayerGlassButton}" FontFamily="{StaticResource IconFont}" FontSize="13" Width="38" Height="38" MinHeight="38" Padding="0" Margin="0,0,12,0" VerticalAlignment="Top" ToolTip="Back to library" AutomationProperties.Name="Library"/>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="RoomHeading" Text="Watchroom player" Foreground="#F4F4F7" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <DockPanel Margin="0,5,0,0">
             <Border x:Name="RoomStatusChip" DockPanel.Dock="Left" Style="{StaticResource PlayerChip}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="RoomStatusDot" Width="7" Height="7" Fill="#6B6D7A" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionStatus" Text="Local playback" Foreground="#D9DAE2" FontSize="11.5" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
             <ToggleButton x:Name="SharedControls" DockPanel.Dock="Left" Click="ControlsChanged" Visibility="Collapsed" Style="{StaticResource PlayerChipToggle}" ToolTip="Let admitted guests play, pause and seek" AutomationProperties.Name="Allow shared controls"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SharedControlsIcon" Text="&#xE72E;" Style="{StaticResource PlayerPillIcon}" FontSize="11" Margin="0,0,6,0"/><TextBlock x:Name="SharedControlsText" Text="Host controls"/></StackPanel></ToggleButton>
             <TextBlock x:Name="RoomSubtitle" Text="Choose a video from your library to start watching." Foreground="#B4B6C2" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </DockPanel>
           </StackPanel>
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="RoomLibraryButton" Content="Room library" Click="OpenRoomLibrary" Style="{StaticResource PlayerGlassButton}" Visibility="Collapsed" ToolTip="Browse the host library, manage the room queue and guest access"/>
            <Button x:Name="RoomToggle" Click="ToggleRoomPanel" Style="{StaticResource PlayerGlassButton}" ToolTip="Show or hide participants and chat" AutomationProperties.Name="Room and chat"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource PlayerPillIcon}"/><TextBlock Text="Room &amp; chat" VerticalAlignment="Center"/><Border x:Name="RoomUnreadBadge" Visibility="Collapsed" Background="#A991FF" CornerRadius="8" MinWidth="16" Height="16" Padding="5,0" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="RoomUnreadText" Foreground="#160E2E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
            <Button x:Name="InviteButton" Content="&#xE71B;" Click="CopyInvite" Style="{StaticResource PlayerGlassButton}" FontFamily="{StaticResource IconFont}" FontSize="14" Width="34" Padding="0" ToolTip="Copy invite" AutomationProperties.Name="Copy invite"/>
            <Button x:Name="LeaveButton" Content="Leave" Click="LeaveRoom" Style="{StaticResource PlayerGlassButton}" Margin="0"/>
           </StackPanel>
          </Grid>
         </Border>
         <Border x:Name="FullscreenHint" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0" Background="#D917181F" CornerRadius="20" Padding="18,9"><TextBlock Text="Fullscreen · Esc to exit · Move the mouse for controls" Foreground="#F4F4F7" FontSize="13"/></Border>
         <!-- New room chat appears briefly over the video while the room panel is closed. -->
         <ItemsControl x:Name="ChatBubbles" HorizontalAlignment="Right" MaxWidth="340" Margin="0,8,18,0" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Recent chat">
          <ItemsControl.ItemTemplate><DataTemplate><Border Background="#D917181F" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14,14,4,14" Padding="12,7" Margin="0,0,0,7" HorizontalAlignment="Right" Opacity="{Binding Opacity}"><TextBlock TextWrapping="Wrap" Foreground="#F4F4F7" FontSize="13"><Run Text="{Binding Name, Mode=OneWay}" Foreground="#A991FF" FontWeight="SemiBold"/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock></Border></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
        <Border x:Name="RoomPlaybackNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,112,24,112" Background="#E617181F" BorderBrush="#2E303B" BorderThickness="1" CornerRadius="12" Padding="22,14" IsHitTestVisible="False">
         <TextBlock x:Name="RoomPlaybackNoticeText" Foreground="#F4F4F7" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.Name="Room playback status" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <!-- Offers the next episode in the player and plays it when the countdown ends.
             It stacks on the fullscreen controls host so the controls never cover it. -->
        <StackPanel VerticalAlignment="Bottom">
         <!-- The update card moves here while the player is open; native video draws over the main window. -->
         <Grid x:Name="PlayerUpdateHost"/>
         <Border x:Name="UpNextCard" Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,0,24,24" Width="360" Background="#F217181F" BorderBrush="#2E303B" BorderThickness="1" CornerRadius="12" Padding="18,16" Effect="{StaticResource PopupShadow}" MouseLeftButtonDown="UpNextCardClicked" AutomationProperties.Name="Up next">
          <StackPanel>
           <TextBlock Text="UP NEXT" Foreground="#A991FF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
           <TextBlock x:Name="UpNextSeries" Foreground="#F4F4F7" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock x:Name="UpNextEpisode" Foreground="#B4B6C2" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
           <!-- The fill shrinks with a render transform animation so it drains smoothly. -->
           <Border x:Name="UpNextProgress" Height="4" CornerRadius="2" Background="#2E303B" Margin="0,14,0,0" IsHitTestVisible="False"><Border x:Name="UpNextFill" CornerRadius="2" Background="#A991FF" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="UpNextFillScale"/></Border.RenderTransform></Border></Border>
           <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="UpNextCountdown" Foreground="#B4B6C2" FontSize="13" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="UpNextCancelClicked" Style="{StaticResource PlayerButton}" Background="Transparent" MinHeight="34" Height="34" Padding="12,0" ToolTip="Stay on this episode (Esc)"/><Button Content="Play now" Click="UpNextPlayClicked" Style="{StaticResource PlayerButton}" Background="#A991FF" Foreground="#160E2E" FontWeight="SemiBold" MinHeight="34" Height="34" Padding="14,0" Margin="0"/></StackPanel>
           </Grid>
          </StackPanel>
         </Border>
         <!-- Bottom bar: timeline, transport, track and queue pills, and output. Each pill opens its menu above itself, so the bar never changes height. -->
         <Border x:Name="PlaybackControls" Background="{StaticResource PlayerControlsFade}" Padding="18,34,18,12" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed" SizeChanged="PlaybackControlsSizeChanged">
          <StackPanel>
           <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="Timeline" PreviewMouseWheel="TimelineWheel" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewMouseMove="SeekMoved" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyStarted" PreviewKeyUp="SeekKeyFinished" AutomationProperties.Name="Playback position"/><Button x:Name="EpisodeEndButton" Grid.Column="1" Content="Next episode →" Click="EpisodeEndClicked" Visibility="Collapsed" Margin="12,0,0,0" Padding="12,0" MinHeight="30" Height="30" Style="{StaticResource PlayerButton}" AutomationProperties.Name="Next episode"/></Grid>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <Button x:Name="PlayButton" Content="&#xF5B0;" Click="TogglePlayback" Style="{StaticResource PlayerPlayButton}" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause"/>
             <Button x:Name="StopButton" Content="&#xEE95;" Click="StopPlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Stop (S)" AutomationProperties.Name="Stop playback"/>
             <Button x:Name="PreviousButton" Visibility="Collapsed" Content="&#xE892;" Click="PreviousQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Previous video (P)" AutomationProperties.Name="Previous video"/>
             <Button x:Name="NextButton" Visibility="Collapsed" Content="&#xE893;" Click="NextQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Next in queue (N)" AutomationProperties.Name="Next in queue"/>
             <TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="#D9DAE2" FontSize="12.5" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="6,0,12,0"/>
            </StackPanel>
            <StackPanel x:Name="PlayerPills" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
             <ToggleButton x:Name="AudioPill" Style="{StaticResource PlayerMenuPill}" ToolTip="Audio track" AutomationProperties.Name="Audio track"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F6;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="AudioPillText" Text="Audio" Style="{StaticResource PlayerPillText}"/><TextBlock x:Name="AudioPillDetail" Style="{StaticResource PlayerPillDetail}"/><TextBlock Text="&#xE70E;" Style="{StaticResource PlayerPillChevron}"/></StackPanel></ToggleButton>
             <Popup x:Name="AudioMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened">
              <ContentControl Style="{StaticResource PlayerMenu}" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel>
               <TextBlock Text="Audio" Style="{StaticResource PlayerMenuCaption}"/>
               <ListBox x:Name="AudioTracks" Style="{StaticResource PlayerMenuList}" ItemTemplate="{StaticResource PlayerTrackRow}" SelectionChanged="AudioChanged" PreviewMouseLeftButtonUp="TrackMenuClicked" AutomationProperties.Name="Audio track"/>
               <TextBlock x:Name="AudioPreferenceHint" Visibility="Collapsed" Foreground="#7D7F8C" FontSize="11" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" Margin="10,6,10,4"/>
              </StackPanel></ContentControl>
             </Popup>
             <ToggleButton x:Name="SubtitlePill" Style="{StaticResource PlayerMenuPill}" ToolTip="Subtitles" AutomationProperties.Name="Subtitles"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F0;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="SubtitlePillText" Text="Subtitles" Style="{StaticResource PlayerPillText}"/><TextBlock x:Name="SubtitlePillDetail" Style="{StaticResource PlayerPillDetail}"/><TextBlock Text="&#xE70E;" Style="{StaticResource PlayerPillChevron}"/></StackPanel></ToggleButton>
             <Popup x:Name="SubtitleMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened">
              <ContentControl Style="{StaticResource PlayerMenu}" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel>
               <TextBlock Text="Subtitles" Style="{StaticResource PlayerMenuCaption}"/>
               <ListBox x:Name="SubtitleTracks" Style="{StaticResource PlayerMenuList}" ItemTemplate="{StaticResource PlayerTrackRow}" SelectionChanged="SubtitlesChanged" PreviewMouseLeftButtonUp="TrackMenuClicked" AutomationProperties.Name="Subtitle track"/>
               <Border Height="1" Background="{StaticResource PlayerLine}" Margin="6,4"/>
               <Button x:Name="LoadSubtitlesButton" Click="LoadSubtitles" Style="{StaticResource PlayerMenuButton}" AutomationProperties.Name="Load subtitles from file"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource PlayerAccent}" Width="24" VerticalAlignment="Center"/><TextBlock Text="Load from file…"/></StackPanel></Button>
              </StackPanel></ContentControl>
             </Popup>
             <ToggleButton x:Name="QueuePill" Style="{StaticResource PlayerMenuPill}" Margin="0" ToolTip="Queue" AutomationProperties.Name="Queue"><StackPanel Orientation="Horizontal"><TextBlock x:Name="QueuePillIcon" Text="&#xE8FD;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="QueuePillText" Text="Queue" Style="{StaticResource PlayerPillText}"/><TextBlock x:Name="QueuePillDetail" Style="{StaticResource PlayerPillDetail}" Typography.NumeralAlignment="Tabular"/><TextBlock Text="&#xE70E;" Style="{StaticResource PlayerPillChevron}"/></StackPanel></ToggleButton>
             <Popup x:Name="PlayerQueueMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened">
              <ContentControl Style="{StaticResource PlayerMenu}" Width="380" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel Margin="6,2,6,2">
               <!-- Switching between the episode list (or no queue) and a queue never interrupts the playing video. -->
               <Border Background="#0F1015" BorderBrush="{StaticResource PlayerLine}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,8">
                <UniformGrid Rows="1">
                 <ToggleButton x:Name="QueueModeOff" Click="QueueModeOffClicked" Style="{StaticResource PlayerSegment}" AutomationProperties.Name="Turn the queue off"><StackPanel Orientation="Horizontal"><TextBlock x:Name="QueueModeOffIcon" Text="&#xE7F4;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="QueueModeOffText" Text="Episodes"/></StackPanel></ToggleButton>
                 <ToggleButton x:Name="QueueModeOn" Click="QueueModeOnClicked" Style="{StaticResource PlayerSegment}" AutomationProperties.Name="Use a queue"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource PlayerPillIcon}"/><TextBlock Text="Queue"/></StackPanel></ToggleButton>
                </UniformGrid>
               </Border>
               <Grid x:Name="QueuePickerRow" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="PlayerQueuePicker" DisplayMemberPath="Name" SelectionChanged="PlayerQueueChanged" AutomationProperties.Name="Player queue" Style="{StaticResource PlayerOptionPicker}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Tag="Queues" Click="Navigate" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" Margin="0" ToolTip="Manage queues" AutomationProperties.Name="Manage queues"/>
               </Grid>
               <TextBlock x:Name="QueueStatus" Text="Queue is empty." Foreground="{StaticResource PlayerMuted}" FontSize="12" TextWrapping="Wrap" Margin="4,2,4,8"/>
               <ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" MaxHeight="240" ItemTemplate="{StaticResource PlayerQueueRow}" ItemContainerStyle="{StaticResource PlayerQueueItem}" AutomationProperties.Name="Playback queue" AutomationProperties.HelpText="Select a video and choose Play selected, double-click it, or press Enter to play from that point in the queue." Margin="0,0,0,8">
                <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource PlayerMenuList}"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
               </ListBox>
               <WrapPanel x:Name="QueueEditActions" Visibility="Collapsed">
                <Button x:Name="PlaySelectedQueueButton" Content="Play selected" Click="PlaySelectedQueued" Style="{StaticResource PlayerOptionButton}" IsEnabled="False"/>
                <Button x:Name="QueueEarlier" Content="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11" Tag="Earlier" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" ToolTip="Move earlier" AutomationProperties.Name="Move earlier"/>
                <Button x:Name="QueueLater" Content="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Tag="Later" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" ToolTip="Move later" AutomationProperties.Name="Move later"/>
                <Button x:Name="RemoveQueueButton" Content="Remove" Click="RemoveQueued" Style="{StaticResource PlayerOptionButton}" ToolTip="Remove selected video from queue" AutomationProperties.Name="Remove selected video from queue"/>
                <Button x:Name="AddEpisodeToQueueButton" Content="Add to queue…" Click="AddEpisodeToQueue" Style="{StaticResource PlayerOptionButton}" Visibility="Collapsed" ToolTip="Add the selected episode to a queue"/>
               </WrapPanel>
               <WrapPanel>
                <Button x:Name="PlayPlayerQueueButton" Content="Play queue from start" Click="PlayPlayerQueue" Style="{StaticResource PlayerOptionButton}"/>
                <Button x:Name="AddCurrentToQueueButton" Content="Add current video" Click="AddCurrentToQueue" Style="{StaticResource PlayerOptionButton}" Visibility="Collapsed" ToolTip="Add the playing video to the end of this queue"/>
               </WrapPanel>
              </StackPanel></ContentControl>
             </Popup>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Button x:Name="MuteButton" Content="&#xE767;" Click="MutePlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Mute (M)" AutomationProperties.Name="Mute"/><Slider x:Name="Volume" PreviewMouseWheel="VolumeWheel" IsMoveToPointEnabled="True" Style="{StaticResource PlayerSlider}" Width="90" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume" Margin="2,0,8,0"/><TextBlock x:Name="VolumeText" Text="80%" Foreground="#D9DAE2" Width="38" VerticalAlignment="Center" FontSize="12" Typography.NumeralAlignment="Tabular"/><Button x:Name="FullscreenButton" Content="&#xE740;" Click="Fullscreen" Style="{StaticResource PlayerIconButton}" Margin="0" ToolTip="Fullscreen (F or double-click video)" AutomationProperties.Name="Fullscreen"/></StackPanel>
           </Grid>
          </StackPanel>
         </Border>
        </StackPanel>
       </Grid>
      </vlc:VideoView>
     </Border>
     <GridSplitter Grid.Column="1" x:Name="RoomSplitter" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource PlayerLine}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" KeyboardIncrement="16" ToolTip="Drag to resize participants and chat" AutomationProperties.Name="Resize room panel"/>
     <Grid Grid.Column="2" x:Name="RoomSide" Margin="14,14" SizeChanged="RoomPanelSizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl x:Name="RoomTabs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}">
       <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="3"><UniformGrid Rows="1" IsItemsHost="True"/></Border><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></TabControl.Template>
       <TabControl.Resources>
        <Style TargetType="TabItem">
         <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
           <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style>
       </TabControl.Resources>
       <TabItem Header="Participants">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="PeopleList" AutomationProperties.Name="Room participants" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
          <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Actions}"><Button Content="{Binding AdmitLabel}" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Tag="{Binding Id}" Click="Admit" Style="{StaticResource Primary}" Padding="10,0" Height="30" MinHeight="30" FontSize="12" Margin="0,0,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Style="{StaticResource QuietButton}" Padding="8,0" Height="30" MinHeight="30" FontSize="12" Margin="0"/></StackPanel>
          </Grid>
         </DataTemplate></ListBox.ItemTemplate></ListBox>
         <Button Grid.Row="1" Content="Join a room" Click="JoinClick" Margin="0,12,0,0"/>
        </Grid>
       </TabItem>
       <TabItem Header="Chat">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Room chat" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Arrow"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="12,8" Margin="0,2"><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
         <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" MaxLength="1000" KeyDown="ChatKey" ToolTip="Message the room" AutomationProperties.Name="Message the room" Margin="0,10,6,0"/><Button Grid.Column="1" x:Name="SendChatButton" Content="&#xE724;" Click="SendChat" Style="{StaticResource IconButton}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Width="40" Height="40" Margin="0,10,0,0" ToolTip="Send message" AutomationProperties.Name="Send"/></Grid>
        </Grid>
       </TabItem>
      </TabControl>
      <TextBlock Grid.Row="1" x:Name="RoomFeedback" Visibility="Collapsed" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
  <!-- Caption row: the sidebar and details backdrop extend behind it; empty space drags the window. -->
  <Grid x:Name="CaptionBar" Grid.Column="1" Panel.ZIndex="50">
   <StackPanel x:Name="CaptionIdentity" Orientation="Horizontal" Visibility="Collapsed" Margin="16,0,0,0" VerticalAlignment="Center"><Image Source="Assets/Watchroom.png" Width="16" Height="16"/><TextBlock Text="Watchroom" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
    <Button x:Name="MinimizeButton" Content="&#xE921;" Click="MinimizeWindow" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize"/>
    <Button x:Name="MaximizeButton" Content="&#xE922;" Click="ToggleMaximizeWindow" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize"/>
    <Button x:Name="CloseButton" Content="&#xE8BB;" Click="CloseWindow" Style="{StaticResource CaptionCloseButton}" AutomationProperties.Name="Close"/>
   </StackPanel>
  </Grid>
  <Border x:Name="AppStatusBar" Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel><ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="96" Height="3" Margin="18,0" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Welcome to Watchroom" Foreground="{DynamicResource Muted}" Margin="16,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
  <Border x:Name="UpdateCard" Grid.Column="1" Grid.Row="1" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="420" Margin="24" Padding="22" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Effect="{StaticResource CardShadow}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock x:Name="UpdateCardTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="320"/></StackPanel><TextBlock x:Name="UpdateCardStatus" Style="{StaticResource MutedText}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,14"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="DismissUpdateButton" Content="Later" Style="{StaticResource QuietButton}" Click="DismissUpdate" Margin="0,0,8,0"/><Button x:Name="InstallUpdateButton" Content="Update" Click="InstallUpdate" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></StackPanel></Border></Grid>
</Window>
