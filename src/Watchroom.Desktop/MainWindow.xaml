       </Grid>
      </Grid>
     </Border>

     <DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Right" Text="From your library, not started yet" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,3"/><TextBlock Text="Recommended for you" FontSize="22" FontWeight="SemiBold"/></DockPanel>
     <TextBlock x:Name="HomeSuggestionsEmpty" Text="Everything here has been started. Try a mystery pick or browse your library." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <ItemsControl x:Name="HomeRows" Panel.ZIndex="-1" ItemTemplate="{StaticResource HomeRowTemplate}" Focusable="False" AutomationProperties.Name="Recommended for you"/>
