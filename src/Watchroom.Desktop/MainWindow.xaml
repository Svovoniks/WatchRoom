<Window x:Class="Watchroom.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Watchroom.Desktop" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Style="{StaticResource {x:Type Window}}" Title="Watchroom" Icon="Assets/Watchroom.ico" Width="1280" Height="850" MinWidth="900" MinHeight="640" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" Closing="WindowClosing" PreviewKeyDown="KeyPressed">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="34"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="208" x:Name="RailWidth"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Rail" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,28,16,20" LastChildFill="False">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="6,0,0,8"><Image Source="Assets/Watchroom.png" Width="32" Height="32"/><TextBlock Text="watchroom" FontSize="21" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>


     <Button x:Name="LibraryNav" Tag="Library" Click="LibraryMenuClick" Style="{StaticResource Navigation}" AutomationProperties.Name="Library" AutomationProperties.HelpText="Expand or collapse library categories">
      <Grid Width="126"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▦   Library"/><TextBlock x:Name="LibraryChevron" Grid.Column="1" Text="▾"/></Grid>
     </Button>
     <StackPanel x:Name="LibraryCategories" Margin="18,0,0,8">
      <Button x:Name="AllLibraryNav" Content="All" Tag="0" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="AnimeLibraryNav" Content="Anime" Tag="3" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="ShowsLibraryNav" Content="Shows" Tag="2" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="MoviesLibraryNav" Content="Movies" Tag="1" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="UnavailableLibraryNav" Content="Unavailable" Tag="4" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}" Visibility="Collapsed"/>
     </StackPanel>
     <Button x:Name="QueuesNav" Content="☷   Queues" Tag="Queues" Click="Navigate" Style="{StaticResource Navigation}"/>
     <Button x:Name="RoomNav" Content="▷   Watch rooms" Tag="Rooms" Click="Navigate" Style="{StaticResource Navigation}"/>
     <Button x:Name="FoldersNav" Content="＋   Folders" Tag="Folders" Click="Navigate" Style="{StaticResource Navigation}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">

     <Button x:Name="SettingsNav" Content="⚙   Settings" Tag="Settings" Click="Navigate" Style="{StaticResource Navigation}"/>
     <TextBlock Text="WATCHROOM / WINDOWS PREVIEW" Style="{StaticResource MutedText}" FontSize="9" Margin="10,12,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,18" x:Name="ContentArea">
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="LocalLibraryHeader"><TextBlock x:Name="GuestLibraryStatus" Visibility="Collapsed" Style="{StaticResource MutedText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>

     <Border x:Name="HostLibraryActivity" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="8" Padding="12,6" Margin="0,0,0,10">
      <DockPanel><Button x:Name="BrowseWithGuestButton" DockPanel.Dock="Right" Click="BrowseWithGuest" Padding="12,5" Margin="8,0,0,0" Visibility="Collapsed"/><Button DockPanel.Dock="Right" Content="Permissions" Click="OpenLibraryPermissions" Padding="10,5" Margin="8,0,0,0"/><TextBlock x:Name="HostLibraryActivityText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel>
     </Border>
     <Grid x:Name="LibraryToolbar" Height="44" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="SearchFrame" MouseLeftButtonDown="SearchFrameClick" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="10" Padding="14,0,8,0" HorizontalAlignment="Stretch">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchChanged" ToolTip="Search your library (Ctrl+F)" AutomationProperties.Name="Search library" VerticalContentAlignment="Center" Margin="0" Padding="0" Background="Transparent" BorderThickness="0">
         <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></TextBox.Template>
        </TextBox>
        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search your library" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Grid.Column="2" Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="×" Click="ClearSearch" ToolTip="Clear search" AutomationProperties.Name="Clear search" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Padding="0" MinHeight="0" Margin="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <ComboBox x:Name="LibraryStatusFilter" Grid.Column="1" Width="152" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter artwork and availability" Margin="12,0,12,0"><ComboBoxItem Content="Any status"/><ComboBoxItem Content="Needs artwork"/></ComboBox>
      <Button x:Name="RescanButton" Grid.Column="2" Width="116" Height="44" MinHeight="0" Padding="12,0" Content="↻  Rescan" Click="ScanClick" Margin="0" ToolTip="Check your folders for new videos"/>
     </Grid>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ItemsControl x:Name="LibraryBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Library location"/><TextBlock Grid.Column="1" x:Name="ResultCount" Width="100" TextAlignment="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,8,0"/></Grid>
     <Expander x:Name="SeasonInformation" Header="Season details" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock x:Name="SeasonSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,8" MaxWidth="760" HorizontalAlignment="Left"/></Expander>
    </StackPanel>
    <Grid x:Name="LocalLibraryContent" Grid.Row="1"><ItemsControl x:Name="PosterGrid" PreviewMouseWheel="HostLibraryScrollInput" PreviewTouchDown="HostLibraryTouchInput" VirtualizingPanel.ScrollUnit="Pixel"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="LibraryScroll" PreviewMouseLeftButtonDown="HostLibraryPointerInput" ScrollChanged="LibraryScrollChanged" CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:VirtualizingLibraryPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid><Border Panel.ZIndex="1" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="3" CornerRadius="10" Margin="0,0,12,10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGuestHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border><Button Click="SelectMovie" MouseEnter="LibraryCardHoverEnter" MouseLeave="LibraryCardHoverLeave" Tag="{Binding Card}" Style="{StaticResource PosterCard}" VerticalAlignment="Top" ContextMenuOpening="CardContextMenu" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><StackPanel><Border Background="{DynamicResource Elevated}" CornerRadius="9" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Setter Property="Height" Value="248"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Height" Value="162"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=CardArtwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" Margin="0,12,0,0"/></StackPanel></Grid><Image x:Name="CardArtwork" Source="{Binding Poster, NotifyOnTargetUpdated=True}" ImageFailed="CardArtworkFailed" Loaded="CardArtworkLoaded" TargetUpdated="CardArtworkUpdated"><Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Stretch" Value="Uniform"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid></Border><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,10,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="Height" Value="40"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Caption}"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Text" Value="{Binding EpisodeMeta}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Margin="0,6,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><ProgressBar Height="3" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Background="{DynamicResource Elevated}" Foreground="{DynamicResource Accent}" BorderThickness="0"/><TextBlock Text="{Binding PlaybackLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></StackPanel></Button><Button Click="ToggleCardWatched"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CardWatchedButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRemote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"><TextBlock Text="Your library is ready for videos" FontSize="23" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Add a folder to watch locally or host. Joining a friend needs no local files." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,15,0,22"/><Button Content="Add your first folder" Style="{StaticResource Primary}" Tag="Folders" Click="Navigate" HorizontalAlignment="Center"/><Button Content="Join a friend" Click="JoinFromWelcome" HorizontalAlignment="Center"/></StackPanel><StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="No titles found" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Try a different title or clear your filters to see your collection." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,12,0,22"/><Button Content="Clear search and filters" Click="ResetFilters" HorizontalAlignment="Center"/></StackPanel></Grid>

<Border Grid.Row="2" x:Name="NowPlayingStrip" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Return to player →" Tag="Room" Click="Navigate" Margin="12,0,0,0"/><TextBlock x:Name="NowPlayingLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   </Grid>
   <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1100">
<DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="{Binding Content, ElementName=BrowseWithGuestButton}" Visibility="{Binding Visibility, ElementName=BrowseWithGuestButton}" Click="BrowseWithGuest" Margin="12,0,0,0"/><ItemsControl x:Name="DetailBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Video location"/></DockPanel>
<Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Elevated}" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top"><Grid><Grid Height="360"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=DetailPoster}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><TextBlock Text="WATCHROOM" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Image x:Name="DetailPoster" Stretch="Uniform"/></Grid></Border>
<StackPanel Grid.Column="1" Margin="30,8,0,0"><TextBlock x:Name="DetailContext" Foreground="{DynamicResource Accent}" FontSize="15" TextWrapping="Wrap"/><TextBlock x:Name="DetailTitle" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock x:Name="DetailMeta" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
<WrapPanel><Button x:Name="DetailPlay" Content="Play locally" Style="{StaticResource Primary}" Click="PlayLocal"/><Button x:Name="RestartButton" Content="Start over" Click="RestartLocal" Visibility="Collapsed"/><Button x:Name="DetailHost" Content="Watch together" Click="HostClick"/><Button x:Name="DetailQueue" Content="Add to queue" Click="QueueClick"/><Button x:Name="DetailRemove" Content="Remove from library" Click="RemoveUnavailableVideo" Visibility="Collapsed" ToolTip="Remove the saved entry for this unavailable video"/></WrapPanel>
<TextBlock Text="Overview" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,10"/><TextBlock x:Name="DetailSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
<ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed"/></StackPanel></Grid></Border>
<TextBlock Text="Media file" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/><TextBlock x:Name="DetailFile" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
<Expander Header="Artwork and matching" Foreground="{DynamicResource Muted}" Margin="0,24,0,16"><WrapPanel Margin="0,12,0,0"><Button Content="Correct title" Click="EditTitle"/><Button Content="Find artwork / fix match" Click="MatchClick"/><Button Content="Use local poster" Click="LocalPoster"/></WrapPanel></Expander>
</StackPanel></ScrollViewer>

   <ScrollViewer x:Name="WelcomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Margin="0,30,0,0" HorizontalAlignment="Stretch">
     <TextBlock Text="Watch your way" FontSize="34" FontWeight="SemiBold"/>
     <TextBlock Text="Bring your videos, or join a friend. Only the host needs the video file." Style="{StaticResource MutedText}" FontSize="17" Margin="0,14,0,28"/>
     <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="24" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="Start with your collection" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="Add folders to watch locally or host a movie night." Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
      <Button Content="Add my videos" Tag="Folders" Click="Navigate" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
     </StackPanel></Border>
     <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="24"><StackPanel>
      <TextBlock Text="Have an invitation?" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="Paste your friend's room invitation. No local videos required." Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
      <Button Content="Join a friend" Click="JoinFromWelcome" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="850" HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0">
     <TextBlock Text="Folders" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,12"/>
     <TextBlock Text="Subfolders are included automatically. New folders use Mixed; select a folder to change its category." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
     <DockPanel><Button x:Name="AddFolderButton" DockPanel.Dock="Right" Content="Add folder" Style="{StaticResource Primary}" Click="AddFolder" Margin="12,0,0,12"/><TextBlock Text="Library folders" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <Grid>
      <ListBox x:Name="FolderList" SelectionChanged="FolderSelectionChanged" MinHeight="120" MaxHeight="240" AutomationProperties.Name="Library folders" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5"><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="No folders yet. Add a folder to discover your videos." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=FolderList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <StackPanel x:Name="FolderEditor" Visibility="Collapsed" Margin="0,16,0,0">
      <TextBlock Text="Selected folder" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedItem.Path, ElementName=FolderList}" Style="{StaticResource MutedText}" Margin="0,5,0,10"/>
      <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Category"/><ComboBox x:Name="FolderKind" Width="150" AutomationProperties.Name="Folder category" SelectedIndex="0"><ComboBoxItem Content="Mixed"/><ComboBoxItem Content="Movie"/><ComboBoxItem Content="Show"/><ComboBoxItem Content="Anime"/></ComboBox></StackPanel>
       <Button x:Name="ChangeFolderButton" Content="Apply category" Click="ChangeFolderKind" IsEnabled="False" VerticalAlignment="Bottom"/>
       <Button x:Name="RemoveFolderButton" Content="Remove selected" Click="RemoveFolder" IsEnabled="False" VerticalAlignment="Bottom"/>
      </WrapPanel>
     </StackPanel>
     <WrapPanel Margin="0,16,0,0"><Button x:Name="ScanButton" Content="Scan library" Click="ScanClick"/><Button x:Name="CancelScanButton" Content="Cancel scan" Click="CancelScan" Visibility="Collapsed"/></WrapPanel>
     <TextBlock x:Name="ScanStatus" Style="{StaticResource MutedText}" Margin="0,4,0,16" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="Excluded folders" Style="{StaticResource SectionHeading}"/>
     <ListBox x:Name="ExcludedFolderList" MinHeight="80" MaxHeight="180" SelectionChanged="ExcludedSelectionChanged" AutomationProperties.Name="Excluded folders"/>
     <WrapPanel Margin="0,12,0,0"><Button x:Name="ExcludeFolderButton" Content="Exclude folder" Click="ExcludeFolder"/><Button x:Name="RestoreFolderButton" Content="Remove exclusion" Click="RestoreFolder" IsEnabled="False"/></WrapPanel>
    </StackPanel></Grid>
   </ScrollViewer>
   <Grid x:Name="QueuesPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="Queues" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Line up your next watch. Drag entries to change the order." Style="{StaticResource MutedText}" Margin="0,8,180,0"/></StackPanel><Button Content="Create queue" Click="CreateQueue" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Primary}" Margin="0"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Saved queues" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <ListBox Grid.Row="1" x:Name="QueuePicker" SelectionChanged="SavedQueueChanged" AutomationProperties.Name="Saved queues" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}, {1} videos"><Binding Path="Name"/><Binding Path="MediaIds.Length"/></MultiBinding></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaIds.Length, StringFormat={}{0} videos}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="QueueDetailTitle" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="QueueDetailCaption" Style="{StaticResource MutedText}" Margin="0,6,0,18"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,0,10"><WrapPanel><Button x:Name="PlaySavedQueueButton" Content="Play queue" Click="PlaySavedQueue" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="AddQueueVideosButton" Content="Add videos" Click="AddQueueVideos"/></WrapPanel><TextBlock x:Name="SavedQueueFeedback" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
       <Grid Grid.Row="2">
        <ListBox x:Name="SavedQueueItems" SelectionChanged="SavedQueueSelectionChanged" AutomationProperties.Name="Queue videos" Background="Transparent" BorderThickness="0" AllowDrop="True" PreviewMouseMove="QueueDragMove" PreviewDragOver="QueueDragOver" DragLeave="QueueDragLeave" PreviewDrop="QueueDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CardBorder" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Elevated}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder" PreviewMouseLeftButtonDown="QueueDragDown"><TextBlock Text="⠿" FontSize="23" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Border>
          <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,4,12,4"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
          <Button Grid.Column="3" Content="×" FontSize="22" Width="40" Height="40" Padding="0" Margin="0" VerticalAlignment="Center" Tag="{Binding}" Click="RemoveSavedItem" ToolTip="Remove from queue" AutomationProperties.Name="Remove video from queue"/>
         </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="QueueDropMarker" Height="3" CornerRadius="1" Background="{DynamicResource Accent}" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
       </Grid>
