    <Grid x:Name="LocalLibraryContent" Grid.Row="1" Margin="-6,0,0,0"><ItemsControl x:Name="PosterGrid" PreviewMouseWheel="HostLibraryScrollInput" PreviewTouchDown="HostLibraryTouchInput" VirtualizingPanel.ScrollUnit="Pixel"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="LibraryScroll" PreviewMouseLeftButtonDown="HostLibraryPointerInput" ScrollChanged="LibraryScrollChanged" CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:VirtualizingLibraryPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid>
      <Border Panel.ZIndex="1" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="3" CornerRadius="12" Margin="0,0,14,18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGuestHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
      <Button Click="SelectMovie" MouseEnter="LibraryCardHoverEnter" MouseLeave="LibraryCardHoverLeave" Tag="{Binding Card}" Style="{StaticResource PosterCard}" VerticalAlignment="Top" ContextMenuOpening="CardContextMenu" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu>
