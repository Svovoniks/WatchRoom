       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0"><TextBlock Text="&#xE790;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ThemeStatus" Style="{StaticResource Hint}"/><TextBlock Text="Saved immediately." Style="{StaticResource Hint}"/></StackPanel>
      </DockPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="UpdatePreferences" Tag="Updates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,18,12">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="App updates" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/><CheckBox x:Name="AutoCheckUpdates" Content="Automatically check for updates" Checked="AutoUpdatesChanged" Unchecked="AutoUpdatesChanged"/><TextBlock Text="Checks at startup and every six hours. Updates install only when you click Update. Update preferences save immediately." Style="{StaticResource Hint}" Margin="0,4,0,0"/><Button x:Name="CheckUpdatesButton" Content="Check for updates" ContentTemplate="{StaticResource RefreshContent}" Click="CheckUpdatesClick" HorizontalAlignment="Left" Margin="0,14,0,8"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="For connection or playback issues, share logs from both devices. Invitations, credentials and videos are excluded." Style="{StaticResource Hint}"/><Button x:Name="OpenLogsFolderButton" Content="Open logs folder" Click="OpenLogsFolder" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="About" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="Video playback by libVLC / LibVLCSharp. Peer connections by libdatachannel / DataChannelDotnet. Artwork by TVmaze (https://www.tvmaze.com, CC BY-SA), Wikipedia, and TMDB. Source pages appear in title details." Style="{StaticResource Hint}"/><Image Source="Assets/Tmdb.png" Width="200" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,16,0,6" AutomationProperties.Name="The Movie Database logo"/><TextBlock><Hyperlink NavigateUri="https://www.themoviedb.org" RequestNavigate="OpenTmdbAttribution" Foreground="{DynamicResource Accent}">The Movie Database</Hyperlink></TextBlock><TextBlock Text="This application uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB." Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="Streaming-provider data supplied by JustWatch via TMDB." Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock><Hyperlink NavigateUri="https://www.justwatch.com/" RequestNavigate="OpenTmdbAttribution" Foreground="{DynamicResource Accent}">JustWatch</Hyperlink></TextBlock>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Canvas}" Padding="0,12,0,0" Margin="0,4,0,0">
     <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="CancelPreferencesButton" Content="Cancel" Style="{StaticResource QuietButton}" Click="CancelPreferences" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="SavePreferencesButton" Content="Save changes" Click="SaveSettings" Style="{StaticResource Primary}" IsEnabled="False" Margin="0"/></WrapPanel><TextBlock x:Name="PreferencesStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,16,0"/></DockPanel>
    </Border>
   </Grid>

   <!-- Saved watch rooms -->
   <Grid x:Name="RoomsPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Watch rooms" Style="{StaticResource PageHeading}"/><TextBlock Text="Watch in sync with friends. Only the host needs the video." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ReturnToRoomButton" Content="Return to player" ContentTemplate="{StaticResource PlayContent}" Tag="Room" Click="Navigate" Margin="0,0,8,0"/><Button x:Name="AddSavedInvitationButton" Content="Join a room" Click="JoinClick" Margin="0,0,8,0" ToolTip="Paste an invitation link or room code to add it to your saved rooms"/><Button x:Name="CreateSavedRoomButton" Content="Create room" ContentTemplate="{StaticResource AddContent}" Click="CreatePersistentRoom" Style="{StaticResource Primary}" Margin="0"/></StackPanel></Grid>
    <Grid Grid.Row="1"><StackPanel x:Name="RoomsEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" Margin="0,0,0,22"><TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock Text="Watch together" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Create a room and invite friends, or paste an invitation to join theirs." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,24"/><WrapPanel HorizontalAlignment="Center"><Button Content="Create room" ContentTemplate="{StaticResource AddContent}" Click="CreatePersistentRoom" Style="{StaticResource Primary}"/><Button Content="Join a room" Click="JoinClick" Margin="0,0,0,8"/></WrapPanel></StackPanel><Grid x:Name="SavedRoomsContent" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel><ListBox x:Name="SavedRoomsList" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="SavedRoomSelectionChanged" AutomationProperties.Name="Saved watch rooms" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,4"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
     <Border x:Name="SavedRoomDetails" Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,20,10,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
       <TextBlock x:Name="SavedRoomHeading" Text="Choose a room" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="SavedRoomStatus" Text="Create a room or save an invitation to get started." Style="{StaticResource MutedText}" Margin="0,4,0,16"/>
       <WrapPanel><Button x:Name="ConnectSavedRoomButton" Content="Connect" Click="ConnectSavedRoom" Style="{StaticResource Primary}"/><Button x:Name="DisconnectSavedRoomButton" Content="Disconnect" Click="LeaveRoom" Visibility="Collapsed" AutomationProperties.Name="Disconnect from room"/><Button x:Name="CopySavedInviteButton" Content="Copy invitation" Click="CopySavedInvitation"/></WrapPanel>
       <StackPanel x:Name="SavedRoomHostControls"><TextBlock Text="Permissions" Style="{StaticResource SectionHeading}"/>
        <ToggleButton x:Name="SavedRoomSharedControls" Content="Guest playback controls" ToolTip="Guests can play, pause and seek. Changes save immediately." Click="SavedRoomControlsChanged" AutomationProperties.Name="Saved room shared controls" Style="{StaticResource Switch}"/>
        <CheckBox x:Name="SavedRoomLibraryBrowsing" Content="Allow guests to browse my library" ToolTip="One admitted guest can browse at a time. Turning this off ends the active session." Checked="SavedRoomLibraryChanged" Unchecked="SavedRoomLibraryChanged"/>
       </StackPanel><Button x:Name="SavedRoomLibraryButton" Content="Room library" Click="OpenRoomLibrary" HorizontalAlignment="Left" IsEnabled="False" Margin="0,12,0,0"/>
       <StackPanel x:Name="SavedRoomGuestManagement"><TextBlock Text="Guests" Style="{StaticResource SectionHeading}"/>
        <TextBlock x:Name="SavedRoomGuestHint" Text="Connect as the host to manage guests. Admitted guests are remembered when they reconnect." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
        <ItemsControl x:Name="SavedRoomGuests" AutomationProperties.Name="Saved room guests"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource Elevated}" CornerRadius="10" Padding="12,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><WrapPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="{Binding AdmitLabel}" Tag="{Binding Id}" Click="Admit" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Style="{StaticResource Primary}" Padding="10,0" MinHeight="32" Height="32" Margin="0,0,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" IsEnabled="{Binding CanRemove}" Style="{StaticResource QuietButton}" Padding="10,0" MinHeight="32" Height="32" Margin="0"/></WrapPanel></Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,12,0,0"><WrapPanel><Button x:Name="RenameSavedRoomButton" Content="Rename" Style="{StaticResource QuietButton}" Click="RenameSavedRoom"/><Button x:Name="ForgetSavedRoomButton" Content="Forget room" Style="{StaticResource QuietButton}" Click="ForgetSavedRoom"/></WrapPanel></Border>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid></Grid>
   </Grid>

   <!-- Player. Always dark: the app palette keys are remapped for everything inside it. -->
   <Grid x:Name="RoomPage" Visibility="Collapsed" Background="#0B0B0E" TextElement.Foreground="#F4F4F7">
    <Grid.Resources>
     <SolidColorBrush x:Key="Canvas" Color="#0B0B0E"/><SolidColorBrush x:Key="Surface" Color="#17181F"/><SolidColorBrush x:Key="Elevated" Color="#23242E"/><SolidColorBrush x:Key="Ink" Color="#F4F4F7"/><SolidColorBrush x:Key="Muted" Color="#B4B6C2"/><SolidColorBrush x:Key="Line" Color="#2E303B"/><SolidColorBrush x:Key="Accent" Color="#A991FF"/><SolidColorBrush x:Key="AccentInk" Color="#160E2E"/><SolidColorBrush x:Key="Hover" Color="#2A2C37"/><SolidColorBrush x:Key="AccentSoft" Color="#2A2442"/>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="DockedHeaderHost">
    <Border x:Name="RoomHeader" Visibility="{Binding Visibility, ElementName=PlaybackControls}" Background="{StaticResource PlayerSurface}" BorderBrush="{StaticResource PlayerLine}" BorderThickness="0,0,0,1" Padding="10,8" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="Library" ContentTemplate="{StaticResource BackContent}" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" Background="Transparent" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RoomHeading" Text="Watchroom player" Foreground="#F4F4F7" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RoomSubtitle" Text="Choose a video from your library to start watching." Foreground="#B4B6C2" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="RoomLibraryButton" Content="Room library" Click="OpenRoomLibrary" Style="{StaticResource PlayerButton}" Background="Transparent" Visibility="Collapsed" ToolTip="Browse the host library, manage the room queue and guest access"/><Button x:Name="RoomToggle" Content="Room &amp; chat" Click="ToggleRoomPanel" Style="{StaticResource PlayerButton}" Background="Transparent" ToolTip="Show or hide participants and chat"/><Button x:Name="InviteButton" Content="Copy invite" Click="CopyInvite" Style="{StaticResource PlayerButton}" Background="Transparent"/><Button x:Name="LeaveButton" Content="Leave" Click="LeaveRoom" Style="{StaticResource PlayerButton}" Margin="0"/></StackPanel>
     </Grid>
    </Border>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="0" x:Name="RoomSplitterWidth"/><ColumnDefinition Width="0" x:Name="RoomSideWidth" MaxWidth="600"/></Grid.ColumnDefinitions>
     <Border x:Name="VideoFrame" Background="Black">
      <vlc:VideoView x:Name="Video">
       <!-- A nonzero alpha keeps the native overlay hit-testable over the video. -->
       <Grid x:Name="PlayerOverlay" Background="#01000000" Focusable="True" MouseMove="PlayerMouseMoved" MouseLeftButtonDown="VideoClicked" MouseWheel="VideoWheel" PreviewKeyDown="KeyPressed">
        <Border x:Name="PlayerEmpty" Background="#0B0B0E"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="76" Height="76" CornerRadius="38" Background="#2A2442" HorizontalAlignment="Center"><TextBlock Text="&#xF5B0;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="#A991FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/></Border><TextBlock Text="Choose a video to play" FontSize="21" FontWeight="SemiBold" Foreground="#F4F4F7" HorizontalAlignment="Center" Margin="0,20,0,20"/><Button Content="Browse library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" HorizontalAlignment="Center" Margin="0"/></StackPanel></Viewbox></Border>
        <StackPanel VerticalAlignment="Top">
         <Grid x:Name="FullscreenHeaderHost"/>
         <Border x:Name="FullscreenHint" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0" Background="#D917181F" CornerRadius="20" Padding="18,9"><TextBlock Text="Fullscreen · Esc to exit · Move the mouse for controls" Foreground="#F4F4F7" FontSize="13"/></Border>
        </StackPanel>
        <Border x:Name="RoomPlaybackNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,112,24,112" Background="#E617181F" BorderBrush="#2E303B" BorderThickness="1" CornerRadius="12" Padding="22,14" IsHitTestVisible="False">
         <TextBlock x:Name="RoomPlaybackNoticeText" Foreground="#F4F4F7" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.Name="Room playback status" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Grid x:Name="FullscreenControlsHost" VerticalAlignment="Bottom"/>
       </Grid>
      </vlc:VideoView>
     </Border>
     <GridSplitter Grid.Column="1" x:Name="RoomSplitter" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource PlayerLine}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" KeyboardIncrement="16" ToolTip="Drag to resize participants and chat" AutomationProperties.Name="Resize room panel"/>
     <Grid Grid.Column="2" x:Name="RoomSide" Margin="14,14" SizeChanged="RoomPanelSizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl x:Name="RoomTabs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}">
       <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="3"><UniformGrid Rows="1" IsItemsHost="True"/></Border><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></TabControl.Template>
       <TabControl.Resources>
        <Style TargetType="TabItem">
         <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
           <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style>
       </TabControl.Resources>
       <TabItem Header="Participants">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="PeopleList" AutomationProperties.Name="Room participants" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
          <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Actions}"><Button Content="{Binding AdmitLabel}" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Tag="{Binding Id}" Click="Admit" Style="{StaticResource Primary}" Padding="10,0" Height="30" MinHeight="30" FontSize="12" Margin="0,0,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Style="{StaticResource QuietButton}" Padding="8,0" Height="30" MinHeight="30" FontSize="12" Margin="0"/></StackPanel>
          </Grid>
         </DataTemplate></ListBox.ItemTemplate></ListBox>
         <Button Grid.Row="1" Content="Join a room" Click="JoinClick" Margin="0,12,0,0"/>
        </Grid>
       </TabItem>
       <TabItem Header="Chat">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Room chat" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Arrow"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="12,8" Margin="0,2"><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
         <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" MaxLength="1000" KeyDown="ChatKey" ToolTip="Message the room" AutomationProperties.Name="Message the room" Margin="0,10,6,0"/><Button Grid.Column="1" x:Name="SendChatButton" Content="&#xE724;" Click="SendChat" Style="{StaticResource IconButton}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Width="40" Height="40" Margin="0,10,0,0" ToolTip="Send message" AutomationProperties.Name="Send"/></Grid>
        </Grid>
       </TabItem>
      </TabControl>
      <TextBlock Grid.Row="1" x:Name="RoomFeedback" Visibility="Collapsed" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </Grid>
    </Grid>
    <Grid x:Name="DockedControlsHost" Grid.Row="2">
     <Border x:Name="PlaybackControls" Background="{StaticResource PlayerControlsFade}" BorderBrush="{StaticResource PlayerLine}" BorderThickness="0,1,0,0" Padding="16,8,16,10" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed">
      <StackPanel>
       <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="Timeline" PreviewMouseWheel="TimelineWheel" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewMouseMove="SeekMoved" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyStarted" PreviewKeyUp="SeekKeyFinished" AutomationProperties.Name="Playback position"/><TextBlock Grid.Column="1" x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="#D9DAE2" FontSize="12" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="14,0,0,0"/><Button x:Name="EpisodeEndButton" Grid.Column="2" Content="Next episode →" Click="EpisodeEndClicked" Visibility="Collapsed" Margin="12,0,0,0" Padding="12,0" MinHeight="32" Height="32" Style="{StaticResource PlayerButton}" AutomationProperties.Name="Next episode"/></Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="&#xF5B0;" Click="TogglePlayback" Style="{StaticResource PlayerPlayButton}" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause"/><Button x:Name="StopButton" Content="&#xEE95;" Click="StopPlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Stop (S)" AutomationProperties.Name="Stop playback"/><Border Width="1" Background="#2E303B" Margin="6,10,10,10"/><Button x:Name="BackwardButton" Content="−10" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Click="SkipBackward" Style="{StaticResource PlayerIconButton}" ToolTip="Back 10 seconds (Left)" AutomationProperties.Name="Back 10 seconds"/><Button x:Name="ForwardButton" Content="+10" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Click="SkipForward" Style="{StaticResource PlayerIconButton}" ToolTip="Forward 10 seconds (Right)" AutomationProperties.Name="Forward 10 seconds"/><Button x:Name="PreviousButton" Visibility="Collapsed" Content="&#xE892;" Click="PreviousQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Previous video (P)" AutomationProperties.Name="Previous video"/><Button x:Name="NextButton" Visibility="Collapsed" Content="&#xE893;" Click="NextQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Next in queue (N)" AutomationProperties.Name="Next in queue"/></StackPanel>
        <TextBlock Grid.Column="1" x:Name="ConnectionStatus" Text="Local playback" Foreground="#B4B6C2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="14,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="OptionsButton" Click="TogglePlayerOptions" Style="{StaticResource PlayerButton}" Background="Transparent" Padding="12,0" Height="40" ToolTip="Audio, subtitles, quality and queue" AutomationProperties.Name="Playback options"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Options" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="MuteButton" Content="&#xE767;" Click="MutePlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Mute (M)" AutomationProperties.Name="Mute"/><Slider x:Name="Volume" PreviewMouseWheel="VolumeWheel" IsMoveToPointEnabled="True" Style="{StaticResource PlayerSlider}" Width="96" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume" Margin="2,0,8,0"/><TextBlock x:Name="VolumeText" Text="80%" Foreground="#D9DAE2" Width="42" VerticalAlignment="Center" FontSize="12" Typography.NumeralAlignment="Tabular"/><Button x:Name="FullscreenButton" Content="&#xE740;" Click="Fullscreen" Style="{StaticResource PlayerIconButton}" Margin="0" ToolTip="Fullscreen (F or double-click video)" AutomationProperties.Name="Fullscreen"/></StackPanel>
       </Grid>
       <Border x:Name="PlayerOptions" Visibility="Collapsed" BorderBrush="#2E303B" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0"><ScrollViewer x:Name="PlayerOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260"><StackPanel>
        <ToggleButton x:Name="SharedControls" Content="Allow shared controls" Click="ControlsChanged" Visibility="Collapsed" HorizontalAlignment="Left" Margin="-4,0,0,12" Style="{StaticResource Switch}" AutomationProperties.Name="Allow shared controls" ToolTip="Let admitted guests control room playback"/>
        <WrapPanel>
         <StackPanel Orientation="Horizontal"><TextBlock Text="Audio" Foreground="#B4B6C2" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox x:Name="AudioTracks" Width="200" DisplayMemberPath="Name" SelectionChanged="AudioChanged" ToolTip="Audio track" AutomationProperties.Name="Audio track" Style="{StaticResource PlayerOptionPicker}"/></StackPanel>
         <StackPanel Orientation="Horizontal"><TextBlock Text="Subtitles" Foreground="#B4B6C2" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox x:Name="SubtitleTracks" Width="200" DisplayMemberPath="Name" SelectionChanged="SubtitlesChanged" ToolTip="Subtitle track" AutomationProperties.Name="Subtitle track" Style="{StaticResource PlayerOptionPicker}"/></StackPanel>
         <Button x:Name="LoadSubtitlesButton" Content="Load subtitles…" Click="LoadSubtitles" Style="{StaticResource PlayerOptionButton}"/>
         <Button x:Name="PrepareButton" Content="Prepare 720p copy" Click="PrepareCopy" Style="{StaticResource PlayerOptionButton}"/>
        </WrapPanel>
        <Border BorderBrush="#2E303B" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,12,0,0">
         <StackPanel>
          <WrapPanel>
           <StackPanel Orientation="Horizontal"><TextBlock Text="Queue" Foreground="#B4B6C2" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox x:Name="PlayerQueuePicker" Width="200" DisplayMemberPath="Name" SelectionChanged="PlayerQueueChanged" AutomationProperties.Name="Player queue" Style="{StaticResource PlayerOptionPicker}"/></StackPanel>
           <Button x:Name="PlayPlayerQueueButton" Content="Play queue" Click="PlayPlayerQueue"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlayerOptionButton}"><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=QueueList}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
           <Button Content="Manage queues" Tag="Queues" Click="Navigate" Style="{StaticResource PlayerOptionButton}"/>
          </WrapPanel>
          <ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" MaxHeight="120" DisplayMemberPath="QueueTitle" AutomationProperties.Name="Playback queue" AutomationProperties.HelpText="Select a video and choose Play selected, double-click it, or press Enter to play from that point in the queue." Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
           <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
          </ListBox>
          <WrapPanel x:Name="QueueEditActions" Visibility="Collapsed">
           <Button x:Name="PlaySelectedQueueButton" Content="Play selected" Click="PlaySelectedQueued" Style="{StaticResource PlayerOptionButton}" IsEnabled="False"/>
           <Button x:Name="QueueEarlier" Content="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11" Tag="Earlier" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" ToolTip="Move earlier" AutomationProperties.Name="Move earlier"/>
           <Button x:Name="QueueLater" Content="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Tag="Later" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" ToolTip="Move later" AutomationProperties.Name="Move later"/>
           <Button x:Name="RemoveQueueButton" Content="Remove" Click="RemoveQueued" Style="{StaticResource PlayerOptionButton}" ToolTip="Remove selected video from queue" AutomationProperties.Name="Remove selected video from queue"/>
          </WrapPanel>
          <TextBlock x:Name="QueueStatus" Text="Queue is empty." Foreground="#B4B6C2" FontSize="12" TextWrapping="Wrap"/>
         </StackPanel>
        </Border></StackPanel></ScrollViewer></Border>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="AppStatusBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel><ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="96" Height="3" Margin="18,0" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Welcome to Watchroom" Foreground="{DynamicResource Muted}" Margin="16,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
  <Border x:Name="UpdateCard" Grid.Column="1" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="420" Margin="24" Padding="22" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Effect="{StaticResource CardShadow}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock x:Name="UpdateCardTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="320"/></StackPanel><TextBlock x:Name="UpdateCardStatus" Style="{StaticResource MutedText}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,14"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="DismissUpdateButton" Content="Later" Style="{StaticResource QuietButton}" Click="DismissUpdate" Margin="0,0,8,0"/><Button x:Name="InstallUpdateButton" Content="Update" Click="InstallUpdate" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></StackPanel></Border></Grid>
</Window>
