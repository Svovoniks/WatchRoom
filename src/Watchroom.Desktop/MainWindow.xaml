       <Button x:Name="RefreshLess" Content="−" Click="ChangeRefreshDays" AutomationProperties.Name="Decrease refresh days" Padding="10,4" Margin="0,6,4,14"/>
       <TextBox x:Name="MetadataRefreshDays" Width="64" AutomationProperties.Name="Refresh interval in days" MaxLength="3"/>
       <Button x:Name="RefreshMore" Content="+" Click="ChangeRefreshDays" AutomationProperties.Name="Increase refresh days" Padding="10,4" Margin="4,6,8,14"/>
       <TextBlock Text="days (1–365)" VerticalAlignment="Center"/>
      </WrapPanel><TextBlock x:Name="RefreshDaysError" Style="{StaticResource FieldError}"/>
      <CheckBox x:Name="GroupShows" Content="Combine show folders when provider IDs match"/><CheckBox x:Name="ImportMissing" Content="Show missing episodes"/><CheckBox x:Name="ImportUpcoming" Content="Show upcoming episodes"/><CheckBox x:Name="DisplaySpecials" Content="Show specials within their aired seasons when placement is known"/><CheckBox x:Name="SaveNfo" Content="Save metadata beside videos as NFO files"/>
      <TextBlock Text="TMDB credential · saved separately" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Optional API key or read access token"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="MetadataToken" AutomationProperties.Name="TMDB API key or read access token" PasswordChanged="MetadataKeyChanged"/><Button x:Name="SaveMetadataKeyButton" Grid.Column="1" Content="Save key" Click="SaveMetadataKey" Style="{StaticResource SettingsPrimary}" Margin="12,6,0,14" AutomationProperties.Name="Save TMDB key"/></Grid>
      <TextBlock x:Name="MetadataKeyStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
      <TextBlock Text="Save key stores the credential in Windows Credential Manager. Clear the field and choose Save key to remove it. The Save changes and Cancel buttons below do not change this credential." Style="{StaticResource MutedText}"/>
      <TextBlock Text="Refresh now" Style="{StaticResource SectionHeading}"/><TextBlock Text="Uses your saved settings. Save changes first to use new preferences." Style="{StaticResource MutedText}"/>
      <ComboBox x:Name="MetadataRefreshMode" SelectedIndex="0" AutomationProperties.Name="Metadata refresh action"><ComboBoxItem Content="Fill missing metadata"/><ComboBoxItem Content="Refresh text metadata"/><ComboBoxItem Content="Refresh text and replace downloaded artwork"/></ComboBox>
      <Button Content="Fetch artwork and metadata" Click="FetchArtworkClick" HorizontalAlignment="Left"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="PlaybackPreferences" Tag="Playback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Margin="0,0,18,12" HorizontalAlignment="Stretch">
      <TextBlock Text="Playback" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="Preferred audio languages (most preferred first)" Margin="0,12,0,0"/>
      <TextBox x:Name="PreferredAudioLanguages" AutomationProperties.Name="Preferred audio languages in priority order" ToolTip="en, ja or English, Japanese"/>
      <TextBlock Text="Preferred subtitle languages (most preferred first)"/>
      <TextBox x:Name="PreferredSubtitleLanguages" AutomationProperties.Name="Preferred subtitle languages in priority order" ToolTip="en, ja, off or English, Japanese, off"/>
      <TextBlock Text="Use language codes or names separated by commas: en, ja or English, Japanese. Order sets priority: English first, then Japanese if English is unavailable. English Japanese without a separator won't work. Leave blank to keep the video's defaults." Style="{StaticResource MutedText}"/>
      <TextBlock Text="Tracks are matched by their embedded language tags, or by language names and codes in their labels when tags are missing or unrecognized. Watchroom does not analyze the spoken audio; incorrect track labels can produce incorrect selections." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
      <TextBlock Text="Click Save changes; preferences apply to the next video. For subtitles, en, ja, off disables them if neither language is available. In watch rooms, guests follow the host's track selection." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
      <TextBlock x:Name="TrackPreferencesError" Style="{StaticResource FieldError}"/>
      <TextBlock Text="FFmpeg executable (optional)"/><TextBox x:Name="FfmpegBox" AutomationProperties.Name="FFmpeg executable path"/><TextBlock Text="Used to prepare smaller copies of your videos." Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="AppearancePreferences" Tag="Appearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="ThemeStatus" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
      <Button Content="Switch light / dark" Click="ToggleTheme" HorizontalAlignment="Left"/><TextBlock Text="Theme changes apply and save immediately." Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="UpdatePreferences" Tag="Updates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,0,18,12">
      <TextBlock Text="Update preferences apply and save immediately." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
      <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeading}" Margin="0,24,0,10"/><TextBlock Text="Connection and playback logs are saved automatically on this computer. Logs rotate to keep about 20 MB, and exclude invitations, credentials and movie contents. After a failed attempt, share the logs folder from both devices." Style="{StaticResource MutedText}"/><Button x:Name="OpenLogsFolderButton" Content="Open logs folder" Click="OpenLogsFolder" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left"/><TextBlock Text="App updates" Style="{StaticResource SectionHeading}" Margin="0,24,0,10"/><CheckBox x:Name="AutoCheckUpdates" Content="Automatically check for updates" Checked="AutoUpdatesChanged" Unchecked="AutoUpdatesChanged"/><TextBlock Text="Checks at startup and every six hours. Updates install only when you click Update." Style="{StaticResource MutedText}"/><Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdatesClick" HorizontalAlignment="Left" Margin="0,12,0,8"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="About Watchroom" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="Video playback by libVLC / LibVLCSharp. Peer connections by libdatachannel / DataChannelDotnet. Artwork by TVmaze (https://www.tvmaze.com, CC BY-SA), Wikipedia, and optional TMDB. Source pages appear in title details." Style="{StaticResource MutedText}"/><TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Preview build. Public-server deployment and two-network playback validation are required before release." Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Canvas}" Padding="0,14,0,0" Margin="0,14,0,0">
     <StackPanel><TextBlock x:Name="PreferencesStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
      <WrapPanel><Button x:Name="SavePreferencesButton" Content="Save changes" Click="SaveSettings" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="CancelPreferencesButton" Content="Cancel" Click="CancelPreferences" IsEnabled="False"/></WrapPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Grid x:Name="RoomsPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="Watch rooms" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="A place to watch together. Manage your rooms, controls and guests." Style="{StaticResource MutedText}" Margin="0,8,0,14"/><WrapPanel><Button x:Name="CreateSavedRoomButton" Content="Create room" Click="CreatePersistentRoom" Style="{StaticResource Primary}"/><Button x:Name="AddSavedInvitationButton" Content="Add room by invitation" Click="SaveRoomInvitation" ToolTip="Paste an invitation link or room code to add it to your saved rooms"/><Button x:Name="ReturnToRoomButton" Content="Return to player" Tag="Room" Click="Navigate"/></WrapPanel></StackPanel>
    <Grid Grid.Row="1"><StackPanel x:Name="RoomsEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><TextBlock Text="No saved rooms yet" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Create a room to host, or add an invitation from a friend. Only the host needs the video file." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,14,0,22"/><WrapPanel HorizontalAlignment="Center"><Button Content="Create room" Click="CreatePersistentRoom" Style="{StaticResource Primary}"/><Button Content="Add invitation" Click="SaveRoomInvitation"/></WrapPanel></StackPanel><Grid x:Name="SavedRoomsContent" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel><TextBlock DockPanel.Dock="Top" Text="Saved rooms" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="SavedRoomsList" SelectionChanged="SavedRoomSelectionChanged" AutomationProperties.Name="Saved watch rooms" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
     <Border x:Name="SavedRoomDetails" Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <TextBlock x:Name="SavedRoomHeading" Text="Choose a room" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="SavedRoomStatus" Text="Create a room or save an invitation to get started." Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
       <WrapPanel><Button x:Name="ConnectSavedRoomButton" Content="Connect" Click="ConnectSavedRoom" Style="{StaticResource Primary}"/><Button x:Name="CopySavedInviteButton" Content="Copy invitation" Click="CopySavedInvitation"/></WrapPanel>
       <StackPanel x:Name="SavedRoomHostControls"><TextBlock Text="Playback controls" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
       <ToggleButton x:Name="SavedRoomSharedControls" Content="Allow guests to control playback" Click="SavedRoomControlsChanged" AutomationProperties.Name="Saved room shared controls" HorizontalAlignment="Left" Cursor="Hand" Foreground="{DynamicResource Ink}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
         <Border x:Name="ToggleFrame" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="6,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/><Border x:Name="SwitchTrack" Grid.Column="1" Width="42" Height="24" Background="{DynamicResource Line}" CornerRadius="12"><Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="{DynamicResource Ink}" HorizontalAlignment="Left" Margin="3"/></Border></Grid>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource Canvas}"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleFrame" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></ToggleButton.Template>
       </ToggleButton>
       <TextBlock x:Name="SavedRoomControlHint" Text="Only the room host can change this setting." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
       <TextBlock Text="Library permissions" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,8"/>
       <CheckBox x:Name="SavedRoomLibraryBrowsing" Content="Allow admitted guests to browse my library" Checked="SavedRoomLibraryChanged" Unchecked="SavedRoomLibraryChanged"/>
       <TextBlock Text="One guest can browse at a time. You can see their activity in Library and end their session there. Turning this off ends the active session." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
       </StackPanel><Button x:Name="SavedRoomLibraryButton" Content="Shared collections, guest queue &amp; playback tools" Click="OpenRoomLibrary" HorizontalAlignment="Left" IsEnabled="False" Margin="0,12,0,0"/>
       <TextBlock Text="Optional collection sharing and room queue tools." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
       <StackPanel x:Name="SavedRoomGuestManagement"><TextBlock Text="Guests and access" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,8"/>
       <TextBlock x:Name="SavedRoomGuestHint" Text="Connect as the host to manage guests. Admitted guests are remembered when they reconnect." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
       <ItemsControl x:Name="SavedRoomGuests" AutomationProperties.Name="Saved room guests"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{Binding AdmitLabel}" Tag="{Binding Id}" Click="Admit" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Padding="8,6" MinHeight="32"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" IsEnabled="{Binding CanRemove}" Padding="8,6" MinHeight="32"/></WrapPanel></Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,14,0,0"><WrapPanel><Button x:Name="RenameSavedRoomButton" Content="Rename" Click="RenameSavedRoom"/><Button x:Name="ForgetSavedRoomButton" Content="Forget room" Click="ForgetSavedRoom"/></WrapPanel></Border>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid></Grid>
   </Grid>
   <Grid x:Name="RoomPage" Visibility="Collapsed" Background="#101112">
    <Grid.Resources>
     <SolidColorBrush x:Key="Surface" Color="#222426"/><SolidColorBrush x:Key="Elevated" Color="#303236"/><SolidColorBrush x:Key="Ink" Color="#F3F3F3"/><SolidColorBrush x:Key="Muted" Color="#AFB2B8"/><SolidColorBrush x:Key="Line" Color="#42454A"/><SolidColorBrush x:Key="Accent" Color="#F3A44B"/>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="RoomHeader" Background="#222426" BorderBrush="#3C3E42" BorderThickness="0,0,0,1" Padding="12,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="←  Library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RoomHeading" Text="Watchroom player" Foreground="#F3F3F3" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RoomSubtitle" Text="Choose a video from your library to start watching." Foreground="#AFB2B8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"><Button x:Name="RoomLibraryButton" Content="Room library" Click="OpenRoomLibrary" Style="{StaticResource PlayerButton}" Visibility="Collapsed" ToolTip="Browse the host library, manage the room queue and guest access"/><Button x:Name="RoomToggle" Content="Room &amp; chat" Click="ToggleRoomPanel" Style="{StaticResource PlayerButton}" ToolTip="Show or hide participants and chat"/><Button x:Name="InviteButton" Content="Copy invite" Click="CopyInvite" Style="{StaticResource PlayerButton}"/><Button x:Name="LeaveButton" Content="Leave" Click="LeaveRoom" Style="{StaticResource PlayerButton}"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="0" x:Name="RoomSplitterWidth"/><ColumnDefinition Width="0" x:Name="RoomSideWidth" MaxWidth="600"/></Grid.ColumnDefinitions>
     <Border x:Name="VideoFrame" Background="Black">
      <vlc:VideoView x:Name="Video">
       <!-- A nonzero alpha keeps the native overlay hit-testable over the video. -->
       <Grid x:Name="PlayerOverlay" Background="#01000000" Focusable="True" MouseMove="PlayerMouseMoved" MouseLeftButtonDown="VideoClicked" MouseWheel="VideoWheel" PreviewKeyDown="KeyPressed">
        <Border x:Name="PlayerEmpty" Background="Black"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▶" FontSize="52" Foreground="#F3A44B" HorizontalAlignment="Center"/><TextBlock Text="Ready when you are" FontSize="24" Foreground="#EEEEEE" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="Choose a video, or join a friend’s room." Foreground="#AFB2B8" HorizontalAlignment="Center" Margin="0,0,0,20"/><Button Content="Browse library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" HorizontalAlignment="Center"/></StackPanel></Viewbox></Border>
        <Border x:Name="FullscreenHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0" Background="#DC222426" CornerRadius="6" Padding="18,10"><TextBlock Text="Fullscreen · Esc to exit · Move the mouse for controls" Foreground="#EEEEEE" FontSize="13"/></Border>
        <Grid x:Name="FullscreenControlsHost" VerticalAlignment="Bottom"/>
       </Grid>
      </vlc:VideoView>
     </Border>
     <GridSplitter Grid.Column="1" x:Name="RoomSplitter" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" KeyboardIncrement="16" ToolTip="Drag to resize participants and chat" AutomationProperties.Name="Resize room panel"/>
     <Grid Grid.Column="2" x:Name="RoomSide" Margin="12,16" SizeChanged="RoomPanelSizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl x:Name="RoomTabs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}">
       <TabControl.Resources>
        <Style TargetType="TabItem">
         <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,10"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style>
       </TabControl.Resources>
       <TabItem Header="Participants">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="PeopleList" AutomationProperties.Name="Room participants" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
          <Grid Margin="2,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Actions}"><Button Content="{Binding AdmitLabel}" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Tag="{Binding Id}" Click="Admit" Padding="8,6" MinHeight="32" FontSize="12" Margin="0,0,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Padding="8,6" MinHeight="32" FontSize="12" Margin="0"/></StackPanel>
          </Grid>
         </DataTemplate></ListBox.ItemTemplate></ListBox>
         <Button Grid.Row="1" Content="Join a room" Click="JoinClick" Margin="0,12,0,0"/>
        </Grid>
       </TabItem>
       <TabItem Header="Chat">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="ChatList" BorderThickness="0" AutomationProperties.Name="Room chat" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ListBox.ItemTemplate></ListBox>
         <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" MaxLength="1000" KeyDown="ChatKey" ToolTip="Message the room" AutomationProperties.Name="Message the room" Margin="0,8,6,0"/><Button Grid.Column="1" x:Name="SendChatButton" Content="Send" Click="SendChat" Padding="12,8" Margin="0,8,0,0"/></Grid>
        </Grid>
       </TabItem>
      </TabControl>
      <TextBlock Grid.Row="1" x:Name="RoomFeedback" Visibility="Collapsed" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </Grid>
    </Grid>
    <Grid x:Name="DockedControlsHost" Grid.Row="2">
     <Border x:Name="PlaybackControls" Background="#F5222426" BorderBrush="#42454A" BorderThickness="0,1,0,0" Padding="14,8,14,10" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed">
      <Border.Resources><SolidColorBrush x:Key="Surface" Color="#222426"/><SolidColorBrush x:Key="Elevated" Color="#303236"/><SolidColorBrush x:Key="Ink" Color="#F3F3F3"/><SolidColorBrush x:Key="Muted" Color="#AFB2B8"/><SolidColorBrush x:Key="Line" Color="#42454A"/><SolidColorBrush x:Key="Accent" Color="#F3A44B"/></Border.Resources>
      <StackPanel>
       <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="Timeline" PreviewMouseWheel="TimelineWheel" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewMouseMove="SeekMoved" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyStarted" PreviewKeyUp="SeekKeyFinished" AutomationProperties.Name="Playback position"/><TextBlock Grid.Column="1" x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="#D7D9DC" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" Margin="16,0,0,0"/><Button x:Name="EpisodeEndButton" Grid.Column="2" Content="Next episode →" Click="EpisodeEndClicked" Visibility="Collapsed" Margin="12,0,0,0" Padding="12,5" Style="{StaticResource PlayerButton}" AutomationProperties.Name="Next episode"/></Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶" Click="TogglePlayback" Style="{StaticResource PlayerIconButton}" FontSize="22"  BorderBrush="#F3A44B" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause"/><Button x:Name="StopButton" Content="■" Click="StopPlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Stop (S)" AutomationProperties.Name="Stop playback"/><Border Width="1" Background="#42454A" Margin="6,5,12,5"/><Button x:Name="BackwardButton" Content="−10" Click="SkipBackward" Style="{StaticResource PlayerIconButton}" ToolTip="Back 10 seconds (Left)" AutomationProperties.Name="Back 10 seconds"/><Button x:Name="ForwardButton" Content="+10" Click="SkipForward" Style="{StaticResource PlayerIconButton}" ToolTip="Forward 10 seconds (Right)" AutomationProperties.Name="Forward 10 seconds"/><Button x:Name="PreviousButton" Visibility="Collapsed" Content="|◀" Click="PreviousQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Previous video (P)" AutomationProperties.Name="Previous video"/><Button x:Name="NextButton" Visibility="Collapsed" Content="▶|" Click="NextQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Next in queue (N)" AutomationProperties.Name="Next in queue"/></StackPanel>
        <TextBlock Grid.Column="1" x:Name="ConnectionStatus" Text="Local playback" Foreground="#AFB2B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="14,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="OptionsButton" Content="Playback options" Click="TogglePlayerOptions" Style="{StaticResource PlayerButton}" ToolTip="Audio, subtitles, quality and queue"/><Button x:Name="MuteButton" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Click="MutePlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Mute (M)" AutomationProperties.Name="Mute"/><Slider x:Name="Volume" PreviewMouseWheel="VolumeWheel" IsMoveToPointEnabled="True" Style="{StaticResource PlayerSlider}" Width="90" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume" Margin="4,0,8,0"/><TextBlock x:Name="VolumeText" Text="80%" Foreground="#D7D9DC" Width="38" VerticalAlignment="Center" FontSize="12"/><Button x:Name="FullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="18" Click="Fullscreen" Style="{StaticResource PlayerIconButton}" ToolTip="Fullscreen (F or double-click video)" AutomationProperties.Name="Fullscreen"/></StackPanel>
       </Grid>
       <Border x:Name="PlayerOptions" Visibility="Collapsed" BorderBrush="#42454A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0"><ScrollViewer x:Name="PlayerOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260"><StackPanel>
<ToggleButton x:Name="SharedControls" Content="Allow shared controls" Click="ControlsChanged" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12" Foreground="#F3F3F3" Cursor="Hand" AutomationProperties.Name="Allow shared controls" ToolTip="Let admitted guests control room playback">
 <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
  <Border x:Name="ToggleFrame" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="6">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/><Border x:Name="SwitchTrack" Grid.Column="1" Width="38" Height="22" Background="#555960" CornerRadius="11"><Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="#F3F3F3" HorizontalAlignment="Left" Margin="3"/></Border></Grid>
  </Border>
  <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#F3A44B"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleFrame" Property="BorderBrush" Value="#F3A44B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleFrame" Property="Background" Value="#303236"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></ToggleButton.Template>
</ToggleButton>
<WrapPanel><TextBlock Text="Audio" Foreground="#D7D9DC" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="AudioTracks" MaxWidth="260" DisplayMemberPath="Name" SelectionChanged="AudioChanged" ToolTip="Audio track" AutomationProperties.Name="Audio track"/><TextBlock Text="Subtitles" Foreground="#D7D9DC" VerticalAlignment="Center" Margin="8,0,8,6"/><ComboBox x:Name="SubtitleTracks" MaxWidth="260" DisplayMemberPath="Name" SelectionChanged="SubtitlesChanged" ToolTip="Subtitle track" AutomationProperties.Name="Subtitle track"/><Button x:Name="LoadSubtitlesButton" Content="Load subtitles…" Click="LoadSubtitles" Style="{StaticResource PlayerButton}"/><Button x:Name="PrepareButton" Content="Prepare 720p copy" Click="PrepareCopy" Style="{StaticResource PlayerButton}"/></WrapPanel><TextBlock x:Name="TrackSummary" Foreground="#AFB2B8" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8"/><WrapPanel><ComboBox x:Name="PlayerQueuePicker" Width="220" DisplayMemberPath="Name" SelectionChanged="PlayerQueueChanged" AutomationProperties.Name="Player queue"/><Button Content="Play queue" Click="PlayPlayerQueue" Style="{StaticResource PlayerButton}"/><Button Content="Manage queues" Tag="Queues" Click="Navigate" Style="{StaticResource PlayerButton}"/></WrapPanel><TextBlock Text="Queue" Foreground="#D7D9DC" FontWeight="SemiBold" Margin="0,0,0,6"/><ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" MaxHeight="120" DisplayMemberPath="QueueTitle" AutomationProperties.Name="Playback queue"/><WrapPanel><Button x:Name="QueueEarlier" Content="Move earlier" Tag="Earlier" Click="MoveQueued" Style="{StaticResource PlayerButton}"/><Button x:Name="QueueLater" Content="Move later" Tag="Later" Click="MoveQueued" Style="{StaticResource PlayerButton}"/><Button x:Name="RemoveQueueButton" Content="Remove selected from queue" Click="RemoveQueued" Style="{StaticResource PlayerButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/></WrapPanel><TextBlock x:Name="QueueStatus" Text="Queue is empty. Add titles from the library." Foreground="#AFB2B8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></ScrollViewer></Border>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="AppStatusBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel><ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="90" Height="3" Margin="18,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="StatusText" Text="Welcome to Watchroom" Foreground="{DynamicResource Muted}" Margin="18,7" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
 <Border x:Name="UpdateCard" Grid.Column="1" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="440" Margin="24" Padding="22" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource Surface}"><StackPanel><TextBlock x:Name="UpdateCardTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="UpdateCardStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,16" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,14"/><WrapPanel><Button x:Name="InstallUpdateButton" Content="Update" Click="InstallUpdate" Style="{StaticResource Primary}"/><Button x:Name="DismissUpdateButton" Content="Later" Click="DismissUpdate"/></WrapPanel></StackPanel></Border></Grid>
</Window>
