     </Grid>
     <Grid Margin="-8,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ItemsControl x:Name="LibraryBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Library location"/><TextBlock Grid.Column="1" x:Name="ResultCount" Width="100" TextAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0"/></Grid>
     <Expander x:Name="SeasonInformation" Foreground="{DynamicResource Muted}" Header="Season details" Visibility="Collapsed" Margin="-6,0,0,10"><TextBlock x:Name="SeasonSummary" Style="{StaticResource MutedText}" Margin="0,8,0,8" MaxWidth="760" HorizontalAlignment="Left"/></Expander>
     <!-- Asks an acquisition plugin for the missing and upcoming episodes of the season being browsed. -->
     <Button x:Name="AcquireSeasonButton" Content="Acquire season" ContentTemplate="{StaticResource DownloadContent}" Click="AcquireSeasonClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12" ToolTip="Ask an acquisition plugin to get this season's missing episodes" AutomationProperties.Name="Acquire season"/>
     <!-- What a wanted show has and still needs, while browsing it. -->
     <ContentControl x:Name="WantedLibraryPanel" Visibility="Collapsed" Focusable="False" Margin="0,0,0,14"/>
    </StackPanel>
    <Grid x:Name="LocalLibraryContent" Grid.Row="1" Margin="-6,0,0,0"><ItemsControl x:Name="PosterGrid" PreviewMouseWheel="HostLibraryScrollInput" PreviewTouchDown="HostLibraryTouchInput" VirtualizingPanel.ScrollUnit="Pixel"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="LibraryScroll" PreviewMouseLeftButtonDown="HostLibraryPointerInput" ScrollChanged="LibraryScrollChanged" CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:VirtualizingLibraryPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid RequestBringIntoView="LibraryCardBringIntoView">
      <Border Panel.ZIndex="1" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="3" CornerRadius="12" Margin="0,0,14,18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGuestHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
      <Button Click="SelectMovie" MouseEnter="LibraryCardHoverEnter" MouseLeave="LibraryCardHoverLeave" Tag="{Binding Card}" Style="{StaticResource PosterCard}" VerticalAlignment="Top" ContextMenuOpening="CardContextMenu" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu>
       <StackPanel>
        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ArtworkFrame}"><Setter Property="Height" Value="248"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Height" Value="162"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <Grid>
          <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=CardArtwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel VerticalAlignment="Center" Margin="14,0"><TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Grid>
          <Image x:Name="CardArtwork" Source="{Binding Poster, NotifyOnTargetUpdated=True}" ImageFailed="CardArtworkFailed" Loaded="CardArtworkLoaded" TargetUpdated="CardArtworkUpdated"><Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEpisode}" Value="True"/><Condition Binding="{Binding PosterFills}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Stretch" Value="Uniform"/></MultiDataTrigger><DataTrigger Binding="{Binding DimArtwork}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger><DataTrigger Binding="{Binding HasNoFiles}" Value="True"><Setter Property="Opacity" Value="0.4"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
          <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeDashArray="4 3" Margin="1" IsHitTestVisible="False"><Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasNoFiles}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3" CornerRadius="6" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="{DynamicResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding HasEpisodeStatus}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsUpcoming}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EpisodeStatus}" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFFFF"/><Style.Triggers><DataTrigger Binding="{Binding IsUpcoming}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
          <Border VerticalAlignment="Bottom" Padding="10,22,10,9" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#E0000000" Offset="0.55"/></LinearGradientBrush></Border.Background><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMovie}" Value="True"/><Condition Binding="{Binding HasPlaybackProgress}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding PlaybackLabel}" Foreground="#F4F4F7" FontSize="12" FontWeight="SemiBold"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Background="#40FFFFFF" Margin="0,6,0,0"/></StackPanel></Border>
         </Grid>
        </Border>
        <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="2,10,2,3"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="MaxHeight" Value="40"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="{Binding EpisodeMeta, Mode=OneWay}"/><Run Text="{Binding EpisodeStatusSuffix, Mode=OneWay}" Foreground="{DynamicResource Danger}" FontWeight="SemiBold"/></TextBlock>
        <StackPanel Margin="2,7,2,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><ProgressBar Height="3" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource CardProgress}"/><TextBlock Text="{Binding PlaybackLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
       </StackPanel>
      </Button>
      <Button Click="ToggleCardWatched"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CardWatchedButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRemote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HasNoFiles}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" Margin="0,0,0,22"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock Text="Your library starts here" FontWeight="SemiBold" FontSize="24" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Add a video folder to discover movies and shows. Your files stay where they are." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,24"/><WrapPanel HorizontalAlignment="Center"><Button Content="Add folder" Style="{StaticResource Primary}" ContentTemplate="{StaticResource AddContent}" Tag="Folders" Click="Navigate"/><Button Content="Join a friend" ContentTemplate="{StaticResource PeopleContent}" Click="JoinFromWelcome" Margin="0,0,8,8"/><Button Content="Add a title" ContentTemplate="{StaticResource AddContent}" Click="AddTitleClick" Margin="0,0,0,8" ToolTip="Add a show or film you don't have files for yet"/></WrapPanel></StackPanel>
     <StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}" Foreground="{DynamicResource Muted}"/><TextBlock Text="No titles found" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="NoResultsHint" Text="Try another search or clear your filters." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,22"/><Button x:Name="FindTitleButton" Style="{StaticResource Primary}" Click="FindTitleClick" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/><Button Content="Clear search and filters" Click="ResetFilters" HorizontalAlignment="Center" Margin="0"/></StackPanel></Grid>
   </Grid>

   <!-- Title details -->
   <!-- The viewport reaches 8px left of the content so outlines pulled flush with the page edge are not clipped. -->
   <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="-8,0,0,0"><Grid Margin="8,0,0,0">
    <StackPanel MaxWidth="1100" Margin="0,0,8,0">
     <DockPanel Margin="-8,0,0,24"><Button DockPanel.Dock="Right" Content="{Binding Content, ElementName=BrowseWithGuestButton}" Visibility="{Binding Visibility, ElementName=BrowseWithGuestButton}" Click="BrowseWithGuest" Margin="12,0,0,0"/><ItemsControl x:Name="DetailBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Video location"/></DockPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- Layered translucent frames approximate CardShadow without re-running a blur effect while the page scrolls. -->
      <Grid VerticalAlignment="Top">
      <Border Margin="-9,-3,-9,-15" CornerRadius="21" Background="#0A000000" IsHitTestVisible="False"/>
      <Border Margin="-6,-1,-6,-11" CornerRadius="18" Background="#0F000000" IsHitTestVisible="False"/>
      <Border Margin="-3,1,-3,-7" CornerRadius="15" Background="#14000000" IsHitTestVisible="False"/>
      <Border Margin="-1,3,-1,-4" CornerRadius="13" Background="#1A000000" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource Elevated}" CornerRadius="12">
       <Border CornerRadius="12" local:RoundedClip.Radius="12">
        <Grid><Grid Width="230" Height="340"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=DetailPoster}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="190" Margin="16"><TextBlock Text="&#xE714;" Style="{StaticResource EmptyStateIcon}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Text, ElementName=DetailTitle}" FontSize="19" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/></StackPanel></Grid><Image x:Name="DetailPoster" Stretch="Uniform" MaxWidth="400" MaxHeight="345"/></Grid>
       </Border>
      </Border>
      </Grid>
      <StackPanel Grid.Column="1" Margin="32,6,0,0">
       <TextBlock x:Name="DetailContext" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock x:Name="DetailTitle" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <TextBlock x:Name="DetailMeta" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,24"/>
       <!-- The file's audio and subtitles, with languages identified for tracks the file doesn't tag. -->
       <Grid x:Name="DetailTracks" Visibility="Collapsed" Margin="0,-12,0,22" MaxWidth="720" HorizontalAlignment="Left" AutomationProperties.Name="Audio and subtitles">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Audio" Style="{StaticResource MutedText}" FontSize="14" FontWeight="SemiBold" Margin="0,0,14,4"/>
        <TextBlock x:Name="DetailAudio" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.Name="Audio tracks"/>
        <TextBlock Grid.Row="1" Text="Subtitles" Style="{StaticResource MutedText}" FontSize="14" FontWeight="SemiBold" Margin="0,0,14,0"/>
        <TextBlock x:Name="DetailSubtitles" Grid.Row="1" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" AutomationProperties.Name="Subtitle tracks"/>
       </Grid>
       <!-- One pill per release of this episode, such as a colour and a black-and-white version; the chosen one is highlighted. -->
       <WrapPanel x:Name="DetailVersions" Visibility="Collapsed" Margin="0,-10,0,16" AutomationProperties.Name="Versions"/>
       <WrapPanel><Button x:Name="DetailPlay" Content="Play locally" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="20,8" Click="PlayLocal"/><Button x:Name="RestartButton" Content="Start over" Click="RestartLocal" Visibility="Collapsed"/><Button x:Name="DetailHost" Content="Watch together" ContentTemplate="{StaticResource PeopleContent}" Click="HostClick"/><Button x:Name="DetailQueue" Content="Add to queue" ContentTemplate="{StaticResource AddContent}" Click="QueueClick"/><Button x:Name="DetailWatched" Click="ToggleDetailWatched" ToolTip="Mark as watched" AutomationProperties.Name="Mark as watched"><StackPanel Orientation="Horizontal"><TextBlock x:Name="DetailWatchedIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/><TextBlock x:Name="DetailWatchedText" Text="Mark as watched" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DetailRemove" Content="Remove from library" Click="RemoveUnavailableVideo" Visibility="Collapsed" ToolTip="Remove the saved entry for this unavailable video"/><Button x:Name="DetailAcquire" Content="Acquire" ContentTemplate="{StaticResource DownloadContent}" Click="AcquireDetailClick" Visibility="Collapsed" ToolTip="Ask an acquisition plugin to get this video" AutomationProperties.Name="Acquire"/></WrapPanel>
       <Border Visibility="{Binding Visibility, ElementName=DetailAvailability}" HorizontalAlignment="Left" CornerRadius="10" BorderBrush="{DynamicResource Danger}" BorderThickness="1" Margin="0,8,0,12"><Grid><Border Background="{DynamicResource Danger}" Opacity="0.14" CornerRadius="9"/><DockPanel Margin="12,9,14,9"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Danger}" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"/><TextBlock x:Name="DetailAvailability" Visibility="Collapsed" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></Grid></Border>
       <ContentControl x:Name="WantedDetailPanel" Visibility="Collapsed" Focusable="False" Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
       <TextBlock x:Name="DetailSummary" Margin="0,16,0,0" Style="{StaticResource MutedText}" FontSize="15" LineHeight="24" MaxWidth="720" HorizontalAlignment="Left"/>
       <ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      </StackPanel>
     </Grid>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,32,0,16" Padding="0,12,0,0">
      <StackPanel Margin="-6,0,0,0">
       <!-- The clips that came with a film, and from a clip the film and its other clips. -->
       <StackPanel x:Name="DetailExtrasSection" Visibility="Collapsed" Margin="6,0,0,16" AutomationProperties.Name="Extras">
        <TextBlock Text="Extras" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <WrapPanel x:Name="DetailExtras"/>
       </StackPanel>
       <Expander Header="File location" Foreground="{DynamicResource Muted}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DetailFile}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><TextBox x:Name="DetailFile" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,4" AutomationProperties.Name="Video file location" ToolTip="Select and copy the file location"/></Expander>
       <Expander Header="Artwork and matching" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"><WrapPanel Margin="0,10,0,0"><Button Content="Correct title" Click="EditTitle"/><Button Content="Find artwork / fix match" Click="MatchClick"/><Button Content="Use local poster" Click="LocalPoster"/></WrapPanel></Expander>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid></ScrollViewer>

   <!-- First launch -->
   <ScrollViewer x:Name="WelcomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
     <Image Source="Assets/Watchroom.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,24"/><TextBlock Text="Welcome to Watchroom" FontSize="34" FontWeight="Bold" TextAlignment="Center"/>
     <TextBlock Text="Add your videos or join a friend. Only the host needs the files." Style="{StaticResource MutedText}" FontSize="15" TextAlignment="Center" Margin="0,10,0,28"/>
     <WrapPanel HorizontalAlignment="Center"><Button Content="Add folder" Tag="Folders" Click="Navigate" Style="{StaticResource Primary}" ContentTemplate="{StaticResource AddContent}" Padding="20,8"/><Button Content="Join a friend" Click="JoinFromWelcome" ContentTemplate="{StaticResource PeopleContent}" Padding="20,8" Margin="0,0,8,8"/><Button Content="Add a title" Click="AddTitleClick" ContentTemplate="{StaticResource AddContent}" Padding="20,8" Margin="0,0,0,8" ToolTip="Add the shows and films you want; they show as missing until their files are here"/></WrapPanel>
    </StackPanel>
   </ScrollViewer>

   <!-- Folders -->
   <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="860" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0">
     <DockPanel Margin="0,0,0,20"><Button x:Name="AddFolderButton" DockPanel.Dock="Right" Content="Add folder" Style="{StaticResource Primary}" ContentTemplate="{StaticResource AddContent}" Click="AddFolder" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Includes subfolders. Select an added folder to change its category."/><StackPanel><TextBlock Text="Folders" Style="{StaticResource PageHeading}"/><TextBlock Text="Watchroom scans these folders and their subfolders. Your files stay where they are." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="Add title" ContentTemplate="{StaticResource AddContent}" Click="AddTitleClick" VerticalAlignment="Center" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Add titles without files" Style="{StaticResource FieldLabel}"/><TextBlock Text="Add a show or film you don't have yet. It shows as Missing and fills in when a scan finds its files in these folders." Style="{StaticResource MutedText}" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
     <!-- Programs that fetch missing and upcoming videos into these folders; each is a folder with plugin.json in the plugins folder. -->
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <DockPanel><WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="Open plugins folder" Click="OpenPluginsFolder" Margin="12,0,0,0"/><Button Content="Reload" ContentTemplate="{StaticResource RefreshContent}" Click="ReloadPluginsClick" Margin="8,0,0,0"/></WrapPanel><StackPanel><TextBlock Text="Acquisition plugins" Style="{StaticResource FieldLabel}"/><TextBlock Text="Plugins get missing and upcoming episodes, seasons and films for you. Right-click one, or open it, and choose Acquire. Plugins are told where each video belongs and which folders hold anime, shows and movies." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel>
       <ItemsControl x:Name="AcquisitionPluginList" Margin="0,12,0,0" AutomationProperties.Name="Acquisition plugins" Focusable="False">
        <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="2,4"><Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Elevated}" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock x:Name="AcquisitionPluginStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Border>     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Library folders" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
       <Grid>
        <ListBox x:Name="FolderList" SelectionChanged="FolderSelectionChanged" MinHeight="110" MaxHeight="260" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Library folders" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
         <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2,2"><Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Elevated}" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="No folders yet. Add a folder to discover your videos." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=FolderList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
       <StackPanel x:Name="FolderEditor" Visibility="Collapsed" Margin="0,14,0,0">
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
         <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Category" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FolderKind" Width="160" Margin="0,6,0,8" AutomationProperties.Name="Folder category" SelectedIndex="0"><ComboBoxItem Content="Mixed"/><ComboBoxItem Content="Movie"/><ComboBoxItem Content="Show"/><ComboBoxItem Content="Anime"/></ComboBox></StackPanel>
          <Button x:Name="ChangeFolderButton" Content="Apply category" Click="ChangeFolderKind" IsEnabled="False" VerticalAlignment="Bottom"/>
          <Button x:Name="RemoveFolderButton" Content="Remove folder" Style="{StaticResource QuietButton}" Click="RemoveFolder" IsEnabled="False" VerticalAlignment="Bottom"/>
         </WrapPanel>
        </Border>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="ScanButton" Content="Scan library" ContentTemplate="{StaticResource RefreshContent}" Click="ScanClick" Margin="8,0,0,0"/><Button x:Name="CancelScanButton" Content="Cancel scan" Click="CancelScan" Visibility="Collapsed" Margin="8,0,0,0"/></WrapPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="Scanning" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ScanStatus" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Excluded folders" Style="{StaticResource FieldLabel}"/>
       <TextBlock Text="Subfolders listed here are skipped during scans." Style="{StaticResource MutedText}" Margin="0,2,0,10"/>
       <Grid><ListBox x:Name="ExcludedFolderList" MinHeight="56" MaxHeight="180" SelectionChanged="ExcludedSelectionChanged" AutomationProperties.Name="Excluded folders" Background="{DynamicResource Canvas}"/><TextBlock Text="No exclusions. All subfolders are included." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ExcludedFolderList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
       <WrapPanel Margin="0,12,0,-8"><Button x:Name="ExcludeFolderButton" Content="Exclude folder" Click="ExcludeFolder"/><Button x:Name="RestoreFolderButton" Content="Remove exclusion" Style="{StaticResource QuietButton}" Click="RestoreFolder" IsEnabled="False"/></WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel></Grid>
   </ScrollViewer>

   <!-- Queues: a gallery of queue covers. Opening one shows its videos, with library search beside them while adding. -->
   <Grid x:Name="QueuesPage" Visibility="Collapsed">
    <Grid.Resources>
     <Style x:Key="QueueCover" TargetType="Border"><Setter Property="Width" Value="68"/><Setter Property="Height" Value="100"/><Setter Property="CornerRadius" Value="6"/><Setter Property="local:RoundedClip.Radius" Value="6"/><Setter Property="Background" Value="{DynamicResource Elevated}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RenderTransformOrigin" Value="0.5,1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000"/></Setter.Value></Setter></Style>
     <Style x:Key="QueuePill" TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,2"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Grid.Resources>

    <Grid x:Name="QueueGalleryView">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="New queue" Click="CreateQueue" ContentTemplate="{StaticResource AddContent}" VerticalAlignment="Center" Style="{StaticResource Primary}" Margin="12,0,0,0"/><StackPanel><TextBlock x:Name="QueuesHeading" Text="Queues" Style="{StaticResource PageHeading}"/><TextBlock x:Name="QueuesSubheading" Text="Line up movies and episodes to play back to back." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-6,0,0,0" Focusable="False">
      <ItemsControl x:Name="QueueGallery" AutomationProperties.Name="Saved queues" Focusable="False">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Style="{StaticResource PosterCard}" Width="214" Height="Auto" Tag="{Binding}" Click="QueueCardClick" ContextMenuOpening="QueueCardContextMenu" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding AccessibleName}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu>
         <StackPanel>
          <Border Style="{StaticResource ArtworkFrame}" Height="150" Background="{DynamicResource Surface}">
           <Grid>
            <Rectangle Visibility="{Binding CreateVisibility}" Stroke="{DynamicResource Muted}" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="10" RadiusY="10" Margin="-1" Opacity="0.6"/>
            <TextBlock Visibility="{Binding PlaceholderVisibility}" Text="{Binding PlaceholderIcon}" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            <Border Style="{StaticResource QueueCover}" DataContext="{Binding Cover2}" Visibility="{Binding Visibility}" Margin="0,22,0,0" VerticalAlignment="Top"><Border.RenderTransform><TransformGroup><RotateTransform Angle="-9"/><TranslateTransform X="-46" Y="6"/></TransformGroup></Border.RenderTransform><Image Source="{Binding View.Poster}" Stretch="UniformToFill"/></Border>
            <Border Style="{StaticResource QueueCover}" DataContext="{Binding Cover3}" Visibility="{Binding Visibility}" Margin="0,22,0,0" VerticalAlignment="Top"><Border.RenderTransform><TransformGroup><RotateTransform Angle="9"/><TranslateTransform X="46" Y="6"/></TransformGroup></Border.RenderTransform><Image Source="{Binding View.Poster}" Stretch="UniformToFill"/></Border>
            <Border Style="{StaticResource QueueCover}" DataContext="{Binding Cover1}" Visibility="{Binding Visibility}" Margin="0,18,0,0" VerticalAlignment="Top"><Image Source="{Binding View.Poster}" Stretch="UniformToFill"/></Border>
            <Border Visibility="{Binding PlayingVisibility}" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="8,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="Playing" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></Border>
            <Grid Visibility="{Binding RingVisibility}" Width="30" Height="30" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="{Binding WatchedText}">
             <Ellipse Fill="{DynamicResource Canvas}" Opacity="0.85"/>
             <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="3" Margin="3"/>
             <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="3" Margin="3" StrokeDashArray="{Binding RingDash}" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
            </Grid>
           </Grid>
          </Border>
          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,10,2,0"/>
          <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,3,2,4"/>
         </StackPanel>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>

    <Grid x:Name="QueueDetailView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <!-- Add videos opens by widening its column. A fixed width keeps the results list virtualized; an Auto column would measure every row. -->
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="QueueAddColumn" Width="0"/></Grid.ColumnDefinitions>
     <Button Grid.ColumnSpan="2" Style="{StaticResource BreadcrumbButton}" Click="ShowQueueGallery" HorizontalAlignment="Left" Margin="-8,0,0,10" ToolTip="All queues" AutomationProperties.Name="Back to all queues"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Queues"/></StackPanel></Button>

     <!-- The header and videos share a nested grid; a list spanning the header's Auto row would measure every row. -->
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" local:RoundedClip.Radius="14" Margin="0,0,0,14">
      <Grid>
       <!-- A brush, unlike an Image, never sizes the header to the poster. -->
       <Border x:Name="QueueHeroBackdrop" Opacity="0.3" IsHitTestVisible="False"><Border.Background><ImageBrush ImageSource="{Binding View.Poster}" Stretch="UniformToFill"/></Border.Background><Border.Effect><BlurEffect Radius="40" KernelType="Gaussian"/></Border.Effect></Border>
       <Border Background="{DynamicResource HeroFade}" IsHitTestVisible="False"/>
       <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <UniformGrid x:Name="QueueHeroCollage" Rows="2" Columns="2" Width="132" Height="132" Margin="0,0,22,0" VerticalAlignment="Center">
         <UniformGrid.Resources><Style TargetType="Border"><Setter Property="Margin" Value="2"/><Setter Property="CornerRadius" Value="6"/><Setter Property="local:RoundedClip.Radius" Value="6"/><Setter Property="Background" Value="{DynamicResource Elevated}"/></Style></UniformGrid.Resources>
         <Border x:Name="QueueHeroCover0"><Image Source="{Binding View.Poster}" Stretch="UniformToFill"/></Border>
         <Border x:Name="QueueHeroCover1"><Image Source="{Binding View.Poster}" Stretch="UniformToFill"/></Border>
         <Border x:Name="QueueHeroCover2"><Image Source="{Binding View.Poster}" Stretch="UniformToFill"/></Border>
         <Border x:Name="QueueHeroCover3"><Image Source="{Binding View.Poster}" Stretch="UniformToFill"/></Border>
        </UniformGrid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
         <TextBlock Text="QUEUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
         <TextBlock x:Name="QueueDetailTitle" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
         <TextBlock x:Name="QueueDetailCaption" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,14"/>
         <WrapPanel>
          <Button x:Name="PlaySavedQueueButton" Content="Play" Click="PlaySavedQueue" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" MaxWidth="340" IsEnabled="False"/>
          <Button x:Name="PlayQueueFromStartButton" Content="Play from start" Click="PlayQueueFromStart" Visibility="Collapsed"/>
          <Button x:Name="PlaySelectedSavedQueueButton" Content="Play selected" Click="PlaySelectedSavedQueue" IsEnabled="False" Visibility="Collapsed"/>
          <Button x:Name="AddQueueVideosButton" Content="Add videos" Click="AddQueueVideos" ContentTemplate="{StaticResource AddContent}"/>
          <Button x:Name="QueueMoreButton" Content="&#xE712;" Style="{StaticResource IconButton}" Click="QueueMoreClick" ToolTip="More queue actions" AutomationProperties.Name="More queue actions"><Button.ContextMenu><ContextMenu/></Button.ContextMenu></Button>
         </WrapPanel>
         <TextBlock x:Name="SavedQueueFeedback" AutomationProperties.LiveSetting="Polite" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
       </Grid>
      </Grid>
     </Border>

     <Grid Grid.Row="1">
      <ListBox x:Name="SavedQueueItems" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="SavedQueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" ContextMenuOpening="QueueItemContextMenu" AutomationProperties.Name="Queue videos" AutomationProperties.HelpText="Press Enter or double-click to play from a video. Ctrl+Up and Ctrl+Down move it, Delete removes it." Background="Transparent" BorderThickness="0" Padding="0" AllowDrop="True" PreviewMouseMove="QueueDragMove" PreviewDragOver="QueueDragOver" DragLeave="QueueDragLeave" PreviewDrop="QueueDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
       <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="34"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder" PreviewMouseLeftButtonDown="QueueDragDown"><TextBlock Text="&#xE700;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}"/></Border>
        <TextBlock Grid.Column="1" Text="{Binding Number}" Visibility="{Binding NumberVisibility}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        <TextBlock Grid.Column="1" Text="&#xE768;" Visibility="{Binding CurrentVisibility}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Accent}" ToolTip="Playing now"/>
        <Border Grid.Column="2" Width="112" Height="63" CornerRadius="6" local:RoundedClip.Radius="6" Background="{DynamicResource Elevated}" Margin="0,0,14,0">
         <Grid>
          <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
          <Image Source="{Binding View.Poster}"><Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill"/><Style.Triggers><DataTrigger Binding="{Binding View.PosterFills}" Value="False"><Setter Property="Stretch" Value="Uniform"/></DataTrigger><DataTrigger Binding="{Binding HasProblem}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" MinHeight="0" VerticalAlignment="Bottom" Style="{StaticResource CardProgress}" DataContext="{Binding View}" IsHitTestVisible="False"/>
         </Grid>
        </Border>
        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,2,12,2">
         <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasProblem}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        </StackPanel>
        <Border Grid.Column="4" Style="{StaticResource QueuePill}" BorderBrush="{DynamicResource Danger}" Visibility="{Binding ProblemVisibility}"><TextBlock Text="{Binding Problem}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/></Border>
        <Border Grid.Column="4" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Elevated}" DataContext="{Binding View}"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource QueuePill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Watched" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/></Border>
        <TextBlock Grid.Column="5" Text="{Binding Runtime}" Foreground="{DynamicResource Muted}" FontSize="12" Width="56" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Typography.NumeralAlignment="Tabular"/>
        <Button Grid.Column="6" Content="&#xE711;" Style="{StaticResource QuietIcon}" FontSize="12" Width="36" Height="36" Margin="0" VerticalAlignment="Center" Tag="{Binding}" Click="RemoveSavedItem" ToolTip="Remove from queue" AutomationProperties.Name="Remove video from queue"/>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="QueueEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="16"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SavedQueueItems}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE8FD;" Style="{StaticResource EmptyStateIcon}"/><TextBlock Text="Nothing queued yet" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Choose Add videos to search your library, or right-click any title in the library and add it to this queue." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
      <Border x:Name="QueueDropMarker" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
     </Grid>
     </Grid>

     <!-- Add videos: search the library and add without leaving the queue. -->
     <Border x:Name="QueueAddPanel" Grid.Column="1" Grid.Row="1" Margin="20,0,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,14,10,10" Visibility="Collapsed">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource QuietIcon}" FontSize="12" Margin="0" Click="CloseQueueAdd" ToolTip="Done adding (Esc)" AutomationProperties.Name="Close Add videos"/><TextBlock Text="Add videos" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <Border DockPanel.Dock="Top" Background="{DynamicResource Canvas}" BorderThickness="1" CornerRadius="10" Padding="12,0,8,0" Height="38" Margin="0,0,6,10" Cursor="IBeam">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" IsHitTestVisible="False"/>
         <TextBox x:Name="QueueAddSearch" Grid.Column="1" MinHeight="0" TextChanged="QueueAddSearchChanged" PreviewKeyDown="QueueAddSearchKeyDown" AutomationProperties.Name="Search videos to add" VerticalContentAlignment="Center" Margin="0" Padding="0" Background="Transparent" BorderThickness="0">
          <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></TextBox.Template>
         </TextBox>
         <TextBlock Grid.Column="1" Text="Search movies and episodes" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QueueAddSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
       </Border>
       <ComboBox x:Name="QueueAddFilter" DockPanel.Dock="Top" SelectedIndex="0" SelectionChanged="QueueAddFilterChanged" HorizontalAlignment="Left" MinWidth="150" Margin="0,0,6,8" AutomationProperties.Name="Show"><ComboBoxItem Content="Everything"/><ComboBoxItem Content="Movies"/><ComboBoxItem Content="Shows"/><ComboBoxItem Content="Anime"/></ComboBox>
       <TextBlock x:Name="QueueAddStatus" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,0,6,6" AutomationProperties.LiveSetting="Polite"/>
       <ListBox x:Name="QueueAddResults" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Extended" MouseDoubleClick="QueueAddDoubleClicked" PreviewKeyDown="QueueAddKeyDown" AutomationProperties.Name="Videos to add" AutomationProperties.HelpText="Press Enter or double-click to add the selected videos to the queue." Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,1"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,4" MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="72" Height="40" CornerRadius="5" local:RoundedClip.Radius="5" Background="{DynamicResource Elevated}" Margin="0,0,10,0" Visibility="{Binding ThumbnailVisibility}"><Image Source="{Binding View.Poster}"><Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill"/><Style.Triggers><DataTrigger Binding="{Binding View.PosterFills}" Value="False"><Setter Property="Stretch" Value="Uniform"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="&#xE73E;" Visibility="{Binding QueuedVisibility}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Width="34" TextAlignment="Center" ToolTip="Already in this queue"/>
         <Button Grid.Column="2" Visibility="{Binding AddVisibility}" Content="{Binding AddLabel}" Tag="{Binding}" Click="QueueAddRowClick" Style="{StaticResource QuietButton}" FontSize="12" MinWidth="34" Padding="10,4" Margin="0" VerticalAlignment="Center" ToolTip="{Binding AddHint}" AutomationProperties.Name="{Binding AddHint}"/>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
     </Border>
    </Grid>
   </Grid>

   <!-- Settings -->
   <Grid x:Name="SettingsPage" Visibility="Collapsed">
    <Grid.Resources>
     <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/><Setter Property="Margin" Value="0,0,0,8"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
     <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
     <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageHeading}" Margin="0,0,0,16"/>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,20">
      <WrapPanel x:Name="PreferenceSections">
       <Button Content="Profile" Tag="Profile" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Metadata" Tag="Metadata" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Playback" Tag="Playback" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Voice chat" Tag="Voice" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Appearance" Tag="Appearance" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Updates &amp; about" Tag="Updates" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
      </WrapPanel>
     </Border>
    </StackPanel>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="ProfilePreferences" Tag="Profile" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Your display name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DisplayNameBox" AutomationProperties.Name="Your display name" MaxLength="40"/>
       <TextBlock x:Name="DisplayNameError" Style="{StaticResource FieldError}"/>
       <TextBlock Text="Shown to everyone in your watch rooms." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Watchroom server" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ServerBox" AutomationProperties.Name="Room server address"/>
       <TextBlock x:Name="ServerError" Style="{StaticResource FieldError}"/>
       <TextBlock Text="Change the server only if you host your own." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="MetadataPreferences" Tag="Metadata" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Sources" Style="{StaticResource CardTitle}"/>
       <CheckBox x:Name="AutoArtwork" Content="Automatically fetch artwork and metadata"/>
       <TextBlock Text="Providers · in priority order" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
       <ListBox x:Name="MetadataProviders" AutomationProperties.Name="Metadata provider order" Background="{DynamicResource Canvas}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Padding" Value="8,4"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="&#xE70E;" Tag="Up" Click="ProviderMoved" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}" Style="{StaticResource QuietIcon}" FontSize="11" Width="32" Height="32" MinHeight="32" Margin="4,0,0,0"/>
         <Button Content="&#xE70D;" Tag="Down" Click="ProviderMoved" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}" Style="{StaticResource QuietIcon}" FontSize="11" Width="32" Height="32" MinHeight="32" Margin="4,0,0,0"/>
        </StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="PreferencesChanged" Margin="0" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="Providers receive title searches, never video files. Disable all to use local metadata." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Region" Style="{StaticResource CardTitle}"/>
       <WrapPanel><StackPanel Width="270" Margin="0,0,16,0"><TextBlock Text="Language" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MetadataLanguage" AutomationProperties.Name="Metadata language" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Margin="0,6,0,8"/></StackPanel><StackPanel Width="270"><TextBlock Text="Country" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MetadataCountry" AutomationProperties.Name="Metadata country" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Margin="0,6,0,8"/></StackPanel></WrapPanel>
       <TextBlock x:Name="LocaleError" Style="{StaticResource FieldError}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Refresh and organization" Style="{StaticResource CardTitle}"/>
       <WrapPanel><CheckBox x:Name="NeverRefresh" Content="Never refresh automatically" Margin="-4,6,18,6"/><TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="RefreshLess" Content="&#xE738;" Style="{StaticResource IconButton}" FontSize="11" Click="ChangeRefreshDays" AutomationProperties.Name="Decrease refresh days" Margin="0,6,4,12" VerticalAlignment="Center"/>
        <TextBox x:Name="MetadataRefreshDays" Width="60" TextAlignment="Center" AutomationProperties.Name="Refresh interval in days" MaxLength="3" VerticalAlignment="Center"/>
        <Button x:Name="RefreshMore" Content="&#xE710;" Style="{StaticResource IconButton}" FontSize="11" Click="ChangeRefreshDays" AutomationProperties.Name="Increase refresh days" Margin="4,6,8,12" VerticalAlignment="Center"/>
        <TextBlock Text="days (1–365)" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
       </WrapPanel><TextBlock x:Name="RefreshDaysError" Style="{StaticResource FieldError}"/>
       <CheckBox x:Name="GroupShows" Content="Combine show folders when provider IDs match"/><CheckBox x:Name="ImportMissing" Content="Show missing episodes"/><CheckBox x:Name="ImportUpcoming" Content="Show upcoming episodes"/><CheckBox x:Name="DisplaySpecials" Content="Show specials within their aired seasons when placement is known"/><CheckBox x:Name="SaveNfo" Content="Save metadata beside videos as NFO files"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="TMDB key override" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Optional personal key; leave blank to use the bundled WatchRoom key." Style="{StaticResource Hint}"/><PasswordBox x:Name="MetadataToken" AutomationProperties.Name="TMDB API key or read access token" PasswordChanged="MetadataKeyChanged"/>
       <TextBlock x:Name="MetadataKeyStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
       <TextBlock Text="Save changes stores the key in Windows Credential Manager. Clear it and save to remove it." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Manual refresh" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="Uses saved preferences." Style="{StaticResource Hint}"/>
       <WrapPanel Margin="0,8,0,-8"><ComboBox x:Name="MetadataRefreshMode" SelectedIndex="0" MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="Metadata refresh action"><ComboBoxItem Content="Fill missing metadata"/><ComboBoxItem Content="Refresh text metadata"/><ComboBoxItem Content="Refresh text and replace downloaded artwork"/><ComboBoxItem Content="Retry missing artwork"/></ComboBox>
       <Button Content="Fetch artwork and metadata" Click="FetchArtworkClick" HorizontalAlignment="Left"/></WrapPanel>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="PlaybackPreferences" Tag="Playback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Languages" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Watchroom picks the first language each video has, in this order." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Audio" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0"/>
        <local:LanguagePriorityPicker Grid.Column="1" x:Name="PreferredAudioLanguages" AutomationProperties.Name="Preferred audio languages in priority order" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Subtitles" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0"/>
        <local:LanguagePriorityPicker Grid.Row="1" Grid.Column="1" x:Name="PreferredSubtitleLanguages" AllowOff="True" AutomationProperties.Name="Default subtitle languages in priority order"/>
       </Grid>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Subtitle exceptions" Style="{StaticResource FieldLabel}"/>
         <TextBlock Text="Override the subtitle list for specific audio languages — for example, when the audio is English, show no subtitles." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
         <ItemsControl x:Name="SubtitleLanguageRules" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate>
          <!-- Each exception reads as a sentence: when the audio is X, show subtitles in Y. -->
          <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10,8,6" Margin="0,0,0,8">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="When the audio is" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,7,0,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{x:Static local:LanguagePriorityPicker.AudioOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding AudioLanguage, UpdateSourceTrigger=PropertyChanged}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Audio language for subtitle rule" ToolTip="When the audio is in this language" Width="200" Height="32" MinHeight="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,8"/>
            <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource QuietIcon}" FontSize="12" Click="RemoveSubtitleRule" ToolTip="Remove exception" AutomationProperties.Name="Remove subtitle language rule" VerticalAlignment="Top" Width="32" Height="32" MinHeight="32" Margin="6,0,0,0"/>
            <TextBlock Grid.Row="1" Text="Show subtitles in" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,7,0,0"/>
            <local:LanguagePriorityPicker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SubtitleLanguages, UpdateSourceTrigger=PropertyChanged}" AllowOff="True" EmptyText="Nothing chosen yet" AutomationProperties.Name="Subtitle languages for audio language in priority order"/>
           </Grid>
          </Border>         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <Button x:Name="AddSubtitleRuleButton" Content="Add exception" Style="{StaticResource QuietButton}" ContentTemplate="{StaticResource AddContent}" Click="AddSubtitleRule" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
        </StackPanel>
       </Border>
       <Expander Header="How language preferences work" Foreground="{DynamicResource Muted}" Margin="-6,8,0,0"><TextBlock Text="Each list is tried in order until the video has a matching track; an empty list uses the video's own defaults. Exceptions follow the selected audio language, and adding Off last turns subtitles off when nothing matches. Manual subtitle choices last until the next video. Saved preferences apply to the next video; guests follow the host’s tracks." Style="{StaticResource Hint}" Margin="0,4,0,0"/></Expander>
       <TextBlock x:Name="TrackPreferencesError" Style="{StaticResource FieldError}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Streaming buffer" Style="{StaticResource CardTitle}"/>
       <TextBlock Text="Video to buffer ahead (seconds)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StreamingBufferSeconds" MaxLength="3" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Video buffer ahead in seconds" ToolTip="Choose from 2 to 60 seconds"/>
       <TextBlock x:Name="StreamingBufferError" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock Text="Default: 30 seconds. Playback starts as soon as a few seconds are ready; Watchroom then keeps downloading up to this much video ahead while you watch. Applies to the next streamed video. Larger buffers use more memory but do not delay starting or seeking. During a brief host connection interruption, playback continues from buffered video for up to this time, then pauses if recovery has not finished. Actual coverage depends on available bandwidth." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><DockPanel>
       <Button DockPanel.Dock="Right" Content="Open default apps" Click="OpenDefaultAppsSettings" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.HelpText="Opens Windows Settings, where you can choose Watchroom for video files"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Open videos with Watchroom" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="Double-click a video in File Explorer, choose Open with → Watchroom, or drop a video on this window. Videos from your library play with their artwork, progress and next episode; other videos play on their own. To use Watchroom for every video, choose it in Windows default apps." Style="{StaticResource Hint}"/></StackPanel>
      </DockPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="VoicePreferences" Tag="Voice" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisibleChanged="VoicePreferencesVisibilityChanged"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Devices" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Talk with everyone in your room while you watch. Join voice from the player's top bar or the Participants panel." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
       <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="VoiceInputPicker" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Microphone for voice chat" Margin="0,6,0,8" MaxWidth="460" HorizontalAlignment="Left" MinWidth="320"/>
       <!-- A live level meter while this page is open: speak and watch it move. -->
       <Grid Margin="0,0,0,4" MaxWidth="460" HorizontalAlignment="Left" MinWidth="320"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Border Grid.Column="1" x:Name="VoiceTestTrack" Height="6" CornerRadius="3" Background="{DynamicResource Line}" VerticalAlignment="Center" AutomationProperties.Name="Microphone level"><Border x:Name="VoiceTestFill" CornerRadius="3" Background="#3FB97A" HorizontalAlignment="Left" Width="0"/></Border>
       </Grid>
       <TextBlock x:Name="VoiceTestStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,14"/>
       <TextBlock Text="Speakers or headphones" Style="{StaticResource FieldLabel}"/>
       <WrapPanel><ComboBox x:Name="VoiceOutputPicker" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Speakers or headphones for voice chat" Margin="0,6,8,8" MinWidth="320" MaxWidth="460"/><Button x:Name="VoiceTestSoundButton" Content="Play test sound" Click="PlayVoiceTestSound" Style="{StaticResource SettingsButton}" Margin="0,6,0,8"/></WrapPanel>
       <TextBlock Text="Windows default follows the device you choose in Windows sound settings, including when you plug in a headset. A Bluetooth headset's own microphone makes Windows switch the headset to call-quality sound, movie included; a separate or built-in microphone keeps full quality." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Talking" Style="{StaticResource CardTitle}"/>
       <TextBlock Text="Microphone processing" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="VoiceProcessingPicker" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Microphone processing" Margin="0,6,0,6" MaxWidth="460" HorizontalAlignment="Left" MinWidth="320"/>
       <TextBlock Text="Windows voice processing keeps the movie and other people's voices coming from your speakers out of your microphone, and also suppresses noise and evens out your level. If it swallows quiet words or makes your voice sound wrong, try Standard; Raw bypasses every effect, including any the microphone's own software adds." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
       <CheckBox x:Name="VoicePushToTalk" Content="Push to talk: hold V to speak"/>
       <TextBlock Text="Otherwise Watchroom sends your voice when you speak, and V mutes or unmutes you. Keys work while Watchroom is the active window." Style="{StaticResource Hint}" Margin="28,0,0,10"/>
       <CheckBox x:Name="VoiceAlwaysOn" Content="Send my microphone continuously"/>
       <TextBlock Text="Nothing is ever held back waiting for speech to be detected. Uses a little more bandwidth, and people on older versions of Watchroom see you as always talking." Style="{StaticResource Hint}" Margin="28,0,0,10"/>
       <CheckBox x:Name="VoiceAutoJoin" Content="Join voice automatically when I enter a room"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Listening" Style="{StaticResource CardTitle}"/>
       <TextBlock Text="Voice volume" Style="{StaticResource FieldLabel}"/>
       <Grid MaxWidth="460" HorizontalAlignment="Left" MinWidth="320" Margin="0,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
        <Slider x:Name="VoiceVolumeSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" AutomationProperties.Name="Voice volume" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=VoiceVolumeSlider, StringFormat={}{0:0}%}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
       </Grid>
       <CheckBox x:Name="VoiceDucking" Content="Lower the video while people talk"/>
       <TextBlock Text="The movie fades to half volume while someone speaks, then returns." Style="{StaticResource Hint}" Margin="28,0,0,0"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="AppearancePreferences" Tag="Appearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,12">
      <StackPanel.Resources>
       <!-- A colour theme tile: MainWindow fills in a small preview of the theme in the current mode. -->
       <Style x:Key="ThemeChoice" TargetType="RadioButton">
        <Setter Property="Width" Value="156"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
         <Grid><Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="9"><ContentPresenter/></Border><Border x:Name="Ring" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </StackPanel.Resources>
      <Border Style="{StaticResource Card}"><DockPanel>
       <Button DockPanel.Dock="Right" Content="Switch light / dark" Click="ToggleTheme" VerticalAlignment="Center" Margin="16,0,0,0"/>
       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0"><TextBlock Text="&#xE790;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Mode" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ThemeStatus" Style="{StaticResource Hint}"/><TextBlock Text="Saved immediately." Style="{StaticResource Hint}"/></StackPanel>
      </DockPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Color theme" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Every theme has a light and a dark version. The player stays dark and uses the theme's accent. Saved immediately." Style="{StaticResource Hint}"/>
       <WrapPanel x:Name="ThemeChoices" Margin="0,14,0,-10" AutomationProperties.Name="Color theme"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="UpdatePreferences" Tag="Updates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,18,12">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="App updates" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/><CheckBox x:Name="AutoCheckUpdates" Content="Automatically check for updates" Checked="AutoUpdatesChanged" Unchecked="AutoUpdatesChanged"/><TextBlock Text="Checks at startup and every six hours. Updates install only when you click Update. Update preferences save immediately." Style="{StaticResource Hint}" Margin="0,4,0,0"/><Button x:Name="CheckUpdatesButton" Content="Check for updates" ContentTemplate="{StaticResource RefreshContent}" Click="CheckUpdatesClick" HorizontalAlignment="Left" Margin="0,14,0,8"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="For connection or playback issues, share logs from both devices. Invitations, credentials and videos are excluded." Style="{StaticResource Hint}"/><Button x:Name="OpenLogsFolderButton" Content="Open logs folder" Click="OpenLogsFolder" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="About" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="Video playback by libVLC / LibVLCSharp. Peer connections by libdatachannel / DataChannelDotnet. Voice chat by Concentus (Opus) and NAudio. Artwork by TVmaze (https://www.tvmaze.com, CC BY-SA), Wikipedia, and TMDB. Source pages appear in title details." Style="{StaticResource Hint}"/><Image Source="Assets/Tmdb.png" Width="200" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,16,0,6" AutomationProperties.Name="The Movie Database logo"/><TextBlock><Hyperlink NavigateUri="https://www.themoviedb.org" RequestNavigate="OpenTmdbAttribution" Foreground="{DynamicResource Accent}">The Movie Database</Hyperlink></TextBlock><TextBlock Text="This application uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB." Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="Streaming-provider data supplied by JustWatch via TMDB." Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock><Hyperlink NavigateUri="https://www.justwatch.com/" RequestNavigate="OpenTmdbAttribution" Foreground="{DynamicResource Accent}">JustWatch</Hyperlink></TextBlock>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Canvas}" Padding="0,12,0,0" Margin="0,4,0,0">
     <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="CancelPreferencesButton" Content="Cancel" Style="{StaticResource QuietButton}" Click="CancelPreferences" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="SavePreferencesButton" Content="Save changes" Click="SaveSettings" Style="{StaticResource Primary}" IsEnabled="False" Margin="0"/></WrapPanel><TextBlock x:Name="PreferencesStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,16,0"/></DockPanel>
    </Border>
   </Grid>

   <!-- Saved watch rooms -->
   <Grid x:Name="RoomsPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Watch rooms" Style="{StaticResource PageHeading}"/><TextBlock Text="Watch in sync with friends. Only the host needs the video." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ReturnToRoomButton" Content="Return to player" ContentTemplate="{StaticResource PlayContent}" Tag="Room" Click="Navigate" Margin="0,0,8,0"/><Button x:Name="AddSavedInvitationButton" Content="Join a room" Click="JoinClick" Margin="0,0,8,0" ToolTip="Paste an invitation link or room code to add it to your saved rooms"/><Button x:Name="CreateSavedRoomButton" Content="Create room" ContentTemplate="{StaticResource AddContent}" Click="CreatePersistentRoom" Style="{StaticResource Primary}" Margin="0"/></StackPanel></Grid>
    <!-- Hero: what the connected room is playing, or what the most recent room watched last time. -->
    <Border x:Name="RoomHero" Grid.Row="1" Height="200" CornerRadius="14" local:RoundedClip.Radius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,20" Visibility="Collapsed">
     <Grid>
      <!-- Without a saved picture: a room badge before anything is chosen, a title card otherwise, and a shimmer while the picture downloads. -->
      <Grid HorizontalAlignment="Right" Width="460" ClipToBounds="True">
       <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.45"/></LinearGradientBrush></Grid.OpacityMask>
       <Grid x:Name="RoomHeroBadge">
        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource ElevatedColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentSoftColor}" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.78,0.3" GradientOrigin="0.78,0.3" RadiusX="0.55" RadiusY="0.9" Opacity="0.28"><GradientStop Color="{DynamicResource AccentColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentClear}" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,64,0">
         <Ellipse x:Name="RoomHeroBadgeHalo" Width="160" Height="160" Fill="{DynamicResource Accent}" Opacity="0.05"/>
         <Ellipse x:Name="RoomHeroBadgeHaloInner" Width="132" Height="132" Fill="{DynamicResource Accent}" Opacity="0.08"/>
         <Ellipse Width="112" Height="112" Fill="{DynamicResource AccentSoft}" Stroke="{DynamicResource AccentEdge}" StrokeThickness="1"/>
         <TextBlock x:Name="RoomHeroBadgeText" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
       </Grid>
       <Grid x:Name="RoomHeroTitleCard" Visibility="Collapsed">
        <Rectangle x:Name="RoomHeroTitleCardFill"/>
        <Rectangle><Rectangle.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="14,6" SpreadMethod="Repeat"><GradientStop Color="#09FFFFFF" Offset="0"/><GradientStop Color="#09FFFFFF" Offset="0.15"/><GradientStop Color="#00FFFFFF" Offset="0.15"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <TextBlock x:Name="RoomHeroTitleCardText" FontSize="170" FontWeight="ExtraBold" Foreground="#21FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,-48"/>
       </Grid>
       <Rectangle x:Name="RoomHeroShimmer" Visibility="Collapsed"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3"><LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="RoomHeroShimmerShift"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#1D1E27" Offset="0.3"/><GradientStop Color="#2A2C38" Offset="0.5"/><GradientStop Color="#1D1E27" Offset="0.7"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
       <Image Source="{Binding Poster, NotifyOnTargetUpdated=True}" TargetUpdated="HomeArtworkUpdated" Stretch="UniformToFill"/>
      </Grid>
      <Rectangle Fill="{DynamicResource HeroFade}"/>
      <StackPanel Margin="28,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Border x:Name="RoomHeroLive" Background="{DynamicResource Success}" CornerRadius="4" Padding="7,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock x:Name="RoomHeroLiveText" Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Canvas}"/></Border>
        <TextBlock x:Name="RoomHeroKicker" FontSize="13" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       </StackPanel>
       <TextBlock x:Name="RoomHeroTitle" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
       <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <ProgressBar x:Name="RoomHeroProgress" Height="4" Width="260" Maximum="100" VerticalAlignment="Center"/>
        <TextBlock x:Name="RoomHeroTime" Style="{StaticResource MutedText}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
        <Ellipse x:Name="RoomHeroPresenceDot" Width="8" Height="8" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="RoomHeroPresence" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal">
        <Button x:Name="RoomHeroResume" Content="Return to player" Click="ResumeRoomHero" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="20,8"/>
        <Button x:Name="RoomHeroSecondary" Click="RoomHeroSecondaryClick" Visibility="Collapsed"/>
        <Button x:Name="RoomHeroDisconnect" Content="Disconnect" Click="LeaveRoom" Style="{StaticResource QuietButton}" AutomationProperties.Name="Disconnect from room"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="2"><StackPanel x:Name="RoomsEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" Margin="0,0,0,22"><TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock Text="Watch together" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Create a room and invite friends, or paste an invitation to join theirs." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,24"/><WrapPanel HorizontalAlignment="Center"><Button Content="Create room" ContentTemplate="{StaticResource AddContent}" Click="CreatePersistentRoom" Style="{StaticResource Primary}"/><Button Content="Join a room" Click="JoinClick" Margin="0,0,0,8"/></WrapPanel></StackPanel>
     <!-- Saved rooms: a row of room pills, then tiles for the selected room. -->
     <DockPanel x:Name="SavedRoomsContent" Visibility="Collapsed">
      <DockPanel.Resources>
       <Style x:Key="TileLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
       <Style x:Key="Tile" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18,16"/></Style>
      </DockPanel.Resources>
      <ListBox x:Name="SavedRoomsList" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,14" SelectionChanged="SavedRoomSelectionChanged" AutomationProperties.Name="Saved watch rooms" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ToolTip" Value="{Binding Caption}"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Pill" Background="{DynamicResource Elevated}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="14,6">
          <StackPanel Orientation="Horizontal">
           <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
           <TextBlock x:Name="PillText" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Muted}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </StackPanel>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="live"><Setter TargetName="LiveDot" Property="Visibility" Value="Visible"/><Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="PillText" Property="FontWeight" Value="SemiBold"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
      </ListBox>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Grid x:Name="SavedRoomDetails" Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="11*" MinWidth="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="10*" MinWidth="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="10*" MinWidth="220"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- The room: its state, the invitation, and what it watched last. -->
        <Border Grid.RowSpan="3" Style="{StaticResource Tile}" Padding="0" local:RoundedClip.Radius="12">
         <Grid>
          <Rectangle IsHitTestVisible="False"><Rectangle.Fill><RadialGradientBrush Center="0.9,0" GradientOrigin="0.9,0" RadiusX="0.75" RadiusY="0.6" Opacity="0.20"><GradientStop Color="{DynamicResource AccentColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentClear}" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
          <StackPanel Margin="20,18,20,18">
           <TextBlock x:Name="SavedRoomHeading" Text="Choose a room" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <DockPanel Margin="0,4,0,0">
            <Ellipse x:Name="SavedRoomStatusDot" Width="7" Height="7" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="SavedRoomStatus" Text="Create a room or save an invitation to get started." Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </DockPanel>
           <!-- Actions sit on their own row so the status beside the heading is never squeezed. -->
           <WrapPanel Margin="0,12,0,0"><Button x:Name="ConnectSavedRoomButton" Content="Connect" Click="ConnectSavedRoom" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="DisconnectSavedRoomButton" Content="Disconnect" Click="LeaveRoom" Visibility="Collapsed" AutomationProperties.Name="Disconnect from room" VerticalAlignment="Center" Margin="0"/></WrapPanel>
           <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
            <StackPanel>
             <TextBlock Text="INVITE FRIENDS" Style="{StaticResource TileLabel}" Margin="0,0,0,6"/>
             <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="SavedRoomCode" FontFamily="Consolas" FontSize="22" Foreground="{DynamicResource Ink}" AutomationProperties.Name="Room code"/></Viewbox>
             <TextBlock x:Name="SavedRoomInviteHint" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,12"/>
             <WrapPanel><Button x:Name="CopySavedInviteButton" Content="Copy invitation" Click="CopySavedInvitation" Style="{StaticResource Primary}"/><Button x:Name="CopySavedCodeButton" Content="Copy code" Click="CopySavedCode" ToolTip="Friends on the same room server can paste just the code"/></WrapPanel>
            </StackPanel>
           </Border>
           <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
            <StackPanel>
             <TextBlock Text="LAST SESSION" Style="{StaticResource TileLabel}"/>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="SavedRoomSessionThumb" Width="72" Height="44" CornerRadius="6" local:RoundedClip.Radius="6" Margin="0,0,12,0" VerticalAlignment="Center">
               <Grid><TextBlock x:Name="SavedRoomSessionInitials" FontSize="18" FontWeight="ExtraBold" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="SavedRoomSessionImage" Stretch="UniformToFill"/></Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
               <TextBlock x:Name="SavedRoomSessionTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
               <TextBlock x:Name="SavedRoomSessionDetail" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
              </StackPanel>
             </Grid>
            </StackPanel>
           </Border>
          </StackPanel>
         </Grid>
        </Border>
        <!-- People: the host admits and removes guests here; guests see who is in the room. -->
        <Border x:Name="SavedRoomGuestManagement" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Tile}">
         <DockPanel>
          <DockPanel DockPanel.Dock="Top"><TextBlock x:Name="SavedRoomGuestCount" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11.5"/><TextBlock x:Name="SavedRoomGuestHeading" Text="GUESTS" Style="{StaticResource TileLabel}"/></DockPanel>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <!-- With nobody to list, the hint becomes an empty state in the middle of the tile. -->
          <StackPanel x:Name="SavedRoomGuestHintPanel" Margin="0,0,0,12">
           <Border x:Name="SavedRoomGuestEmptyIcon" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
           <TextBlock x:Name="SavedRoomGuestHint" Text="Connect as the host to manage guests." Style="{StaticResource MutedText}" FontSize="11.5"/>
          </StackPanel>
          <ItemsControl x:Name="SavedRoomGuests" Grid.Row="1" AutomationProperties.Name="Saved room guests"><ItemsControl.ItemTemplate><DataTemplate>
           <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Tint}" Opacity="{Binding Presence}" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13" Foreground="#14121F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel>
            <WrapPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="{Binding AdmitLabel}" Tag="{Binding Id}" Click="Admit" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Style="{StaticResource Primary}" Padding="10,0" MinHeight="30" Height="30" Margin="0,0,4,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Visibility="{Binding ManageVisibility}" IsEnabled="{Binding CanRemove}" Style="{StaticResource QuietButton}" Padding="8,0" MinHeight="30" Height="30" Margin="0"/></WrapPanel>
           </Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Grid>
         </DockPanel>
        </Border>
        <!-- What guests may do; only the host sees this tile. -->
        <Border x:Name="SavedRoomHostControls" Grid.Column="4" Style="{StaticResource Tile}">
         <StackPanel>
          <TextBlock Text="GUESTS CAN" Style="{StaticResource TileLabel}" Margin="0,0,0,4"/>
          <ToggleButton x:Name="SavedRoomSharedControls" Content="Play, pause and seek" ToolTip="Guests can play, pause and seek. Changes save immediately." Click="SavedRoomControlsChanged" AutomationProperties.Name="Saved room shared controls" Style="{StaticResource Switch}"/>
          <CheckBox x:Name="SavedRoomLibraryBrowsing" Content="Browse my library" ToolTip="One admitted guest can browse at a time. Turning this off ends the active session." Checked="SavedRoomLibraryChanged" Unchecked="SavedRoomLibraryChanged" AutomationProperties.Name="Allow guests to browse my library" Style="{StaticResource Switch}"/>
         </StackPanel>
        </Border>
        <Border x:Name="SavedRoomActions" Grid.Column="4" Grid.Row="2" Style="{StaticResource Tile}">
         <StackPanel>
          <TextBlock Text="ROOM" Style="{StaticResource TileLabel}"/>
          <WrapPanel><Button x:Name="RenameSavedRoomButton" Content="Rename" Style="{StaticResource QuietButton}" Click="RenameSavedRoom" Margin="0,0,4,8"/><Button x:Name="ForgetSavedRoomButton" Content="Forget room" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Danger}" Click="ForgetSavedRoom" Margin="0,0,0,8"/></WrapPanel>
         </StackPanel>
        </Border>
       </Grid>
      </ScrollViewer>
     </DockPanel>
    </Grid>
   </Grid>

   <!-- Player. Always dark: the app palette keys are remapped for everything inside it. -->
   <Grid x:Name="RoomPage" Visibility="Collapsed" Background="#0B0B0E" TextElement.Foreground="#F4F4F7">
    <Grid.Resources>
     <SolidColorBrush x:Key="Canvas" Color="#0B0B0E"/><SolidColorBrush x:Key="Surface" Color="#17181F"/><SolidColorBrush x:Key="Elevated" Color="#23242E"/><SolidColorBrush x:Key="Ink" Color="#F4F4F7"/><SolidColorBrush x:Key="Muted" Color="#B4B6C2"/><SolidColorBrush x:Key="Line" Color="#2E303B"/><SolidColorBrush x:Key="Accent" Color="#9FD4A8"/><SolidColorBrush x:Key="AccentInk" Color="#0E2A15"/><SolidColorBrush x:Key="Hover" Color="#2A2C37"/><SolidColorBrush x:Key="AccentSoft" Color="#1F3324"/>
    </Grid.Resources>
    <Grid>
     <Border x:Name="VideoFrame" Background="Black" SizeChanged="VideoFrameSizeChanged">
      <vlc:VideoView x:Name="Video">
       <!-- A nonzero alpha keeps the native overlay hit-testable over the video. -->
       <Grid x:Name="PlayerOverlay" Background="#01000000" Focusable="True" PreviewMouseLeftButtonDown="PlayerOverlayPressed" MouseMove="PlayerMouseMoved" MouseLeftButtonDown="VideoClicked" MouseLeave="PlayerMouseLeft" MouseWheel="VideoWheel" PreviewKeyDown="KeyPressed" PreviewKeyUp="KeyReleased">
        <Border x:Name="PlayerEmpty" Background="#0B0B0E"><Viewbox x:Name="PlayerEmptyContent" Stretch="Uniform" StretchDirection="DownOnly" Margin="16,72,16,128"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center"><TextBlock Text="&#xF5B0;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/></Border><TextBlock Text="Choose a video to play" FontSize="21" FontWeight="SemiBold" Foreground="#F4F4F7" HorizontalAlignment="Center" Margin="0,20,0,20"/><Button Content="Browse library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" HorizontalAlignment="Center" Margin="0"/></StackPanel></Viewbox></Border>
        <StackPanel x:Name="PlayerTopChrome" VerticalAlignment="Top">
         <!-- Top bar: floating pills for back, the title, room status and room actions, centred on the window buttons. It hides and shows together with the dock. -->
         <Border x:Name="RoomHeader" Background="{StaticResource PlayerHeaderFade}" Padding="9,9,14,24" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed" SizeChanged="RoomHeaderSizeChanged" MouseLeftButtonDown="RoomHeaderPressed">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Button x:Name="PlayerBackButton" Content="&#xE72B;" Tag="Library" Click="Navigate" Style="{StaticResource PlayerGlassButton}" FontFamily="{StaticResource IconFont}" FontSize="11" Width="28" Padding="0" Margin="0,0,6,0" ToolTip="Back to library" AutomationProperties.Name="Library"/>
           <!-- The title, then what is playing or the room's state, on one line; the line trims before the title does. -->
           <Border Grid.Column="1" Style="{StaticResource PlayerChip}" Padding="12,0" Margin="0,0,8,0" HorizontalAlignment="Left" SizeChanged="RoomTitleSizeChanged">
            <DockPanel VerticalAlignment="Center">
             <TextBlock x:Name="RoomHeading" DockPanel.Dock="Left" Text="Watchroom player" Foreground="#F4F4F7" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
             <TextBlock x:Name="RoomSubtitle" Text="Choose a video from your library to start watching." Foreground="#A9ABB8" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
           </Border>
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <StackPanel x:Name="RoomHeaderDetails" Orientation="Horizontal" VerticalAlignment="Top">
             <Border x:Name="RoomStatusChip" Style="{StaticResource PlayerChip}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="RoomStatusDot" Width="7" Height="7" Fill="#6B6D7A" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionStatus" Text="Local playback" Foreground="#D9DAE2" FontSize="11.5" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
             <ToggleButton x:Name="SharedControls" Click="ControlsChanged" Visibility="Collapsed" Style="{StaticResource PlayerChipToggle}" ToolTip="Let admitted guests play, pause and seek" AutomationProperties.Name="Allow shared controls"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SharedControlsIcon" Text="&#xE72E;" Style="{StaticResource PlayerPillIcon}" FontSize="11" Margin="0,0,6,0"/><TextBlock x:Name="SharedControlsText" Text="Host controls"/></StackPanel></ToggleButton>
            </StackPanel>
            <!-- Room actions share one pill: the microphone switch and voice while in a room, invite, and leave. -->
            <Border Style="{StaticResource PlayerHeaderGroup}"><StackPanel Orientation="Horizontal">
             <Button x:Name="VoiceMuteButton" Click="ToggleVoiceMute" Style="{StaticResource PlayerSegmentIcon}" Visibility="Collapsed" Content="&#xE720;" ToolTip="Mute microphone (V)" AutomationProperties.Name="Mute microphone"/>
             <Button x:Name="VoiceButton" Click="ToggleVoice" Style="{StaticResource PlayerSegmentButton}" Visibility="Collapsed" ToolTip="Join voice chat to talk while you watch" AutomationProperties.Name="Join voice chat"><StackPanel Orientation="Horizontal"><TextBlock x:Name="VoiceButtonIcon" Text="&#xE95B;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="VoiceButtonText" Text="Voice" VerticalAlignment="Center"/><Border x:Name="VoiceCountBadge" Visibility="Collapsed" Background="#3FB97A" CornerRadius="8" MinWidth="16" Height="16" Padding="5,0" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="VoiceCountText" Foreground="#0B0B0E" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button>
             <Button x:Name="InviteButton" Content="&#xE71B;" Click="CopyInvite" Style="{StaticResource PlayerSegmentIcon}" ToolTip="Copy invite" AutomationProperties.Name="Copy invite"/>
             <Button x:Name="LeaveButton" Content="Leave" Click="LeaveRoom" Style="{StaticResource PlayerSegmentButton}" Padding="10,0"/>
            </StackPanel></Border>
            <!-- The docked player has no caption row: the window buttons sit in the bar's corner, and the bar drags the window. -->
            <StackPanel x:Name="PlayerCaptionButtons" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-9,-14,0">
             <Button x:Name="PlayerMinimizeButton" Content="&#xE921;" Click="MinimizeWindow" Style="{StaticResource PlayerCaptionButton}" AutomationProperties.Name="Minimize"/>
             <Button x:Name="PlayerMaximizeButton" Content="&#xE922;" Click="ToggleMaximizeWindow" Style="{StaticResource PlayerCaptionButton}" AutomationProperties.Name="Maximize"/>
             <Button x:Name="PlayerCloseButton" Content="&#xE8BB;" Click="CloseWindow" Style="{StaticResource PlayerCaptionCloseButton}" AutomationProperties.Name="Close"/>
            </StackPanel>
           </StackPanel>
          </Grid>
         </Border>
         <Border x:Name="FullscreenHint" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0" Background="#D917181F" CornerRadius="20" Padding="18,9"><TextBlock Text="Fullscreen · Esc to exit · Move the mouse for controls" Foreground="#F4F4F7" FontSize="13"/></Border>
        </StackPanel>
        <Border x:Name="RoomPlaybackNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,112,24,112" Background="#E617181F" BorderBrush="#2E303B" BorderThickness="1" CornerRadius="12" Padding="22,14" IsHitTestVisible="False">
         <TextBlock x:Name="RoomPlaybackNoticeText" Foreground="#F4F4F7" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.Name="Room playback status" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <!-- Offers the next episode in the player and plays it when the countdown ends.
             It stacks on the fullscreen controls host so the controls never cover it. -->
        <StackPanel x:Name="PlayerBottomChrome" VerticalAlignment="Bottom">
         <!-- The update card moves here while the player is open; native video draws over the main window.
              This overlay is a separate window that does not inherit the app text colour, so the card sets its own. -->
         <Grid x:Name="PlayerUpdateHost"/>
         <!-- Sits centred just above the dock and drops to the bottom when the dock hides; see PlaceUpNextCard. -->
         <Border x:Name="UpNextCard" Panel.ZIndex="1" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,8" Width="340" Background="#D9111116" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="12,12,10,10" MouseLeftButtonDown="UpNextCardClicked" AutomationProperties.Name="Up next">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Border x:Name="UpNextThumb" Width="96" Height="54" CornerRadius="8" local:RoundedClip.Radius="8" Background="#23242E" Margin="0,0,12,0" VerticalAlignment="Center"><Image x:Name="UpNextImage" Stretch="UniformToFill"/></Border>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="UP NEXT" Foreground="{DynamicResource PlayerAccent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBlock x:Name="UpNextSeries" Foreground="#F4F4F7" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="UpNextEpisode" Foreground="#A9ABB8" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
           </StackPanel>
           <!-- The fill shrinks with a render transform animation so it drains smoothly. -->
           <Border x:Name="UpNextProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="3" CornerRadius="1.5" Background="#26FFFFFF" Margin="0,12,2,0" IsHitTestVisible="False"><Border x:Name="UpNextFill" CornerRadius="1.5" Background="{DynamicResource PlayerAccent}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="UpNextFillScale"/></Border.RenderTransform></Border></Border>
           <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="UpNextCountdown" Foreground="#A9ABB8" FontSize="11.5" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
             <Button Content="Cancel" Click="UpNextCancelClicked" Style="{StaticResource PlayerSegmentButton}" Height="26" Padding="12,0" Margin="0,0,4,0" ToolTip="Stay on this episode (Esc)"/>
             <Button Click="UpNextPlayClicked" Style="{StaticResource PlayerSegmentPlay}" Width="Auto" Height="26" Padding="12,0" Margin="0" AutomationProperties.Name="Play now"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF5B0;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Play now" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
           </Grid>
          </Grid>
         </Border>
         <!-- Bottom bar: timeline, transport, track and queue pills, and output. Each pill opens its menu above itself, so the bar never changes height. -->
         <Border x:Name="PlaybackControls" Background="{StaticResource PlayerControlsFade}" Padding="16,40,16,16" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed">
          <!-- The dock: one glass capsule holding the timeline and every control, centred over the video. -->
          <Border x:Name="PlaybackDock" Background="#D9111116" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="10,2,10,8" MaxWidth="980" SizeChanged="PlaybackControlsSizeChanged">
           <!-- The timeline spans the dock; while the episode pill shows, it stops at the output pill's column, and the episode pill centres over that pill. -->
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Slider x:Name="Timeline" Grid.ColumnSpan="3" Margin="0,0,0,2" PreviewMouseWheel="TimelineWheel" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewMouseMove="SeekMoved" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyStarted" PreviewKeyUp="SeekKeyFinished" AutomationProperties.Name="Playback position"/>
            <Button x:Name="EpisodeEndButton" Grid.Column="2" HorizontalAlignment="Center" Content="Next episode →" Click="EpisodeEndClicked" Visibility="Collapsed" Margin="10,0,0,2" Background="#1FFFFFFF" Style="{StaticResource PlayerSegmentButton}" AutomationProperties.Name="Next episode"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
             <Border Style="{StaticResource PlayerPillGroup}"><StackPanel Orientation="Horizontal">
              <Button x:Name="PreviousButton" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Content="&#xE892;" Click="PreviousQueued" Style="{StaticResource PlayerSegmentIcon}" ToolTip="Previous video (P)" AutomationProperties.Name="Previous video"/>
              <Button x:Name="PlayButton" Content="&#xF5B0;" Click="TogglePlayback" Style="{StaticResource PlayerSegmentPlay}" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause"/>
              <Button x:Name="NextButton" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Content="&#xE893;" Click="NextQueued" Style="{StaticResource PlayerSegmentIcon}" ToolTip="Next video (N)" AutomationProperties.Name="Next video"/>
              <Button x:Name="StopButton" Content="&#xEE95;" Click="StopPlayback" Style="{StaticResource PlayerSegmentIcon}" ToolTip="Stop (S)" AutomationProperties.Name="Stop playback"/>
             </StackPanel></Border>
             <Border x:Name="PlaybackTimePill" Style="{StaticResource PlayerPillGroup}" Padding="10,0"><TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="#D9DAE2" FontSize="11.5" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/></Border>
            </StackPanel>
            <!-- Pills that don't fit fold, from the end, into the … pill; its menu also holds any bar buttons hidden for width. -->
            <local:PillStrip x:Name="PlayerPills" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,-6,0">
             <ToggleButton x:Name="AudioPill" Style="{StaticResource PlayerMenuPill}" ToolTip="Audio track" AutomationProperties.Name="Audio track"><StackPanel Orientation="Horizontal"><TextBlock x:Name="AudioPillIcon" Text="&#xE7F6;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="AudioPillText" Text="Audio" Style="{StaticResource PlayerPillText}"/><TextBlock x:Name="AudioPillDetail" Style="{StaticResource PlayerPillDetail}"/><TextBlock Text="&#xE70E;" Style="{StaticResource PlayerPillChevron}"/></StackPanel></ToggleButton>
             <local:PlayerMenuPopup x:Name="AudioMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened"><local:MenuSizer>
              <ContentControl Style="{StaticResource PlayerMenu}" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel>
               <TextBlock Text="Audio" Style="{StaticResource PlayerMenuCaption}"/>
               <ListBox x:Name="AudioTracks" Style="{StaticResource PlayerMenuList}" ItemTemplate="{StaticResource PlayerTrackRow}" SelectionChanged="AudioChanged" PreviewMouseLeftButtonUp="TrackMenuClicked" AutomationProperties.Name="Audio track"/>
               <TextBlock x:Name="AudioPreferenceHint" Visibility="Collapsed" Foreground="#7D7F8C" FontSize="11" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" Margin="10,6,10,4"/>
              </StackPanel></ContentControl></local:MenuSizer>
             </local:PlayerMenuPopup>
             <ToggleButton x:Name="SubtitlePill" Style="{StaticResource PlayerMenuPill}" ToolTip="Subtitles" AutomationProperties.Name="Subtitles"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SubtitlePillIcon" Text="&#xE7F0;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="SubtitlePillText" Text="Subtitles" Style="{StaticResource PlayerPillText}"/><TextBlock x:Name="SubtitlePillDetail" Style="{StaticResource PlayerPillDetail}"/><TextBlock Text="&#xE70E;" Style="{StaticResource PlayerPillChevron}"/></StackPanel></ToggleButton>
             <local:PlayerMenuPopup x:Name="SubtitleMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened"><local:MenuSizer>
              <ContentControl Style="{StaticResource PlayerMenu}" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel>
               <TextBlock Text="Subtitles" Style="{StaticResource PlayerMenuCaption}"/>
               <ListBox x:Name="SubtitleTracks" Style="{StaticResource PlayerMenuList}" ItemTemplate="{StaticResource PlayerTrackRow}" SelectionChanged="SubtitlesChanged" PreviewMouseLeftButtonUp="TrackMenuClicked" AutomationProperties.Name="Subtitle track"/>
               <Border Height="1" Background="{StaticResource PlayerLine}" Margin="6,4"/>
               <Button x:Name="LoadSubtitlesButton" Click="LoadSubtitles" Style="{StaticResource PlayerMenuButton}" AutomationProperties.Name="Load subtitles from file"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource PlayerAccent}" Width="24" VerticalAlignment="Center"/><TextBlock Text="Load from file…"/></StackPanel></Button>
              </StackPanel></ContentControl></local:MenuSizer>
             </local:PlayerMenuPopup>
             <ToggleButton x:Name="QueuePill" Style="{StaticResource PlayerMenuPill}" ToolTip="Queue" AutomationProperties.Name="Queue"><StackPanel Orientation="Horizontal"><TextBlock x:Name="QueuePillIcon" Text="&#xE8FD;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="QueuePillText" Text="Queue" Style="{StaticResource PlayerPillText}"/><TextBlock x:Name="QueuePillDetail" Style="{StaticResource PlayerPillDetail}" Typography.NumeralAlignment="Tabular"/><TextBlock Text="&#xE70E;" Style="{StaticResource PlayerPillChevron}"/></StackPanel></ToggleButton>
             <local:PlayerMenuPopup x:Name="PlayerQueueMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened"><local:MenuSizer>
              <ContentControl Style="{StaticResource PlayerMenu}" Width="380" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel Margin="6,2,6,2">
               <!-- Switching between the episode list (or no queue) and a queue never interrupts the playing video. -->
               <Border Background="#0F1015" BorderBrush="{StaticResource PlayerLine}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,8">
                <UniformGrid Rows="1">
                 <ToggleButton x:Name="QueueModeOff" Click="QueueModeOffClicked" Style="{StaticResource PlayerSegment}" AutomationProperties.Name="Turn the queue off"><StackPanel Orientation="Horizontal"><TextBlock x:Name="QueueModeOffIcon" Text="&#xE7F4;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="QueueModeOffText" Text="Episodes"/></StackPanel></ToggleButton>
                 <ToggleButton x:Name="QueueModeOn" Click="QueueModeOnClicked" Style="{StaticResource PlayerSegment}" AutomationProperties.Name="Use a queue"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource PlayerPillIcon}"/><TextBlock Text="Queue"/></StackPanel></ToggleButton>
                </UniformGrid>
               </Border>
               <Grid x:Name="QueuePickerRow" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="PlayerQueuePicker" DisplayMemberPath="Name" SelectionChanged="PlayerQueueChanged" AutomationProperties.Name="Player queue" Style="{StaticResource PlayerOptionPicker}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Tag="Queues" Click="Navigate" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" Margin="0" ToolTip="Manage queues" AutomationProperties.Name="Manage queues"/>
               </Grid>
               <TextBlock x:Name="QueueStatus" Text="Queue is empty." Foreground="{StaticResource PlayerMuted}" FontSize="12" TextWrapping="Wrap" Margin="4,2,4,8"/>
               <ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" MaxHeight="240" ItemTemplate="{StaticResource PlayerQueueRow}" ItemContainerStyle="{StaticResource PlayerQueueItem}" AutomationProperties.Name="Playback queue" AutomationProperties.HelpText="Select a video and choose Play selected, double-click it, or press Enter to play from that point in the queue." Margin="0,0,0,8">
                <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource PlayerMenuList}"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
               </ListBox>
               <WrapPanel x:Name="QueueEditActions" Visibility="Collapsed">
                <Button x:Name="PlaySelectedQueueButton" Content="Play selected" Click="PlaySelectedQueued" Style="{StaticResource PlayerOptionButton}" IsEnabled="False"/>
                <Button x:Name="QueueEarlier" Content="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11" Tag="Earlier" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" ToolTip="Move earlier" AutomationProperties.Name="Move earlier"/>
                <Button x:Name="QueueLater" Content="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Tag="Later" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="34" Padding="0" ToolTip="Move later" AutomationProperties.Name="Move later"/>
                <Button x:Name="RemoveQueueButton" Content="Remove" Click="RemoveQueued" Style="{StaticResource PlayerOptionButton}" ToolTip="Remove selected video from queue" AutomationProperties.Name="Remove selected video from queue"/>
                <Button x:Name="AddEpisodeToQueueButton" Content="Add to queue…" Click="AddEpisodeToQueue" Style="{StaticResource PlayerOptionButton}" Visibility="Collapsed" ToolTip="Add the selected episode to a queue"/>
               </WrapPanel>
               <WrapPanel>
                <Button x:Name="PlayPlayerQueueButton" Content="Play queue from start" Click="PlayPlayerQueue" Style="{StaticResource PlayerOptionButton}"/>
                <Button x:Name="AddCurrentToQueueButton" Content="Add current video" Click="AddCurrentToQueue" Style="{StaticResource PlayerOptionButton}" Visibility="Collapsed" ToolTip="Add the playing video to the end of this queue"/>
               </WrapPanel>
              </StackPanel></ContentControl></local:MenuSizer>
             </local:PlayerMenuPopup>
             <!-- Participants: voice chat, who is here and, for the host, admitting and removing guests. Shown only in a room. -->
             <ToggleButton x:Name="ParticipantsPill" local:PillStrip.Shown="False" Style="{StaticResource PlayerMenuPill}" ToolTip="Participants and voice chat" AutomationProperties.Name="Participants"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ParticipantsPillIcon" Text="&#xE716;" Style="{StaticResource PlayerPillIcon}"/><TextBlock x:Name="ParticipantsPillText" Text="Participants" Style="{StaticResource PlayerPillText}"/><TextBlock x:Name="ParticipantsPillDetail" Style="{StaticResource PlayerPillDetail}" Typography.NumeralAlignment="Tabular"/><TextBlock Text="&#xE70E;" Style="{StaticResource PlayerPillChevron}"/></StackPanel></ToggleButton>
             <local:PlayerMenuPopup x:Name="ParticipantsMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened"><local:MenuSizer>
              <ContentControl Style="{StaticResource PlayerMenu}" Width="360" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel x:Name="RoomParticipants" Margin="6,2,6,6">
               <TextBlock Text="Participants" Style="{StaticResource PlayerMenuCaption}" Margin="4,4,4,8"/>
               <!-- Voice chat: who is talking, your microphone, and joining or leaving. -->
               <Border x:Name="VoiceCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                 <Border x:Name="VoiceCardBadge" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top" Margin="0,2,10,0"><TextBlock x:Name="VoiceCardIcon" Text="&#xE95B;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                 <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="Voice chat" FontWeight="SemiBold"/>
                  <TextBlock x:Name="VoiceCardStatus" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  <Border x:Name="VoiceLevelTrack" Height="3" CornerRadius="1.5" Background="{DynamicResource Line}" Margin="0,6,0,2" Visibility="Collapsed" ToolTip="Your microphone level"><Border x:Name="VoiceLevelFill" CornerRadius="1.5" Background="#3FB97A" HorizontalAlignment="Left" Width="0"/></Border>
                  <!-- Everyone's voice volume, applied as it moves; each person's row has their own level. -->
                  <StackPanel x:Name="VoiceCardVolumeRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,6,0,0">
                   <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Voice volume"/>
                   <Slider x:Name="VoiceCardVolume" Width="150" Minimum="0" Maximum="200" Value="100" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True" Style="{StaticResource PlayerSlider}" ValueChanged="VoiceCardVolumeChanged" ToolTip="Voice volume for everyone" AutomationProperties.Name="Voice volume"/>
                   <TextBlock x:Name="VoiceCardVolumeText" Text="100%" Foreground="{DynamicResource Muted}" FontSize="11" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="VoiceCardProblem" Foreground="#F0616D" FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"><Run x:Name="VoiceCardProblemText"/><Hyperlink x:Name="VoicePrivacyLink" NavigateUri="ms-settings:privacy-microphone" RequestNavigate="OpenMicrophonePrivacy" Foreground="{DynamicResource Accent}"><Run x:Name="VoicePrivacyLinkText"/></Hyperlink></TextBlock>
                 </StackPanel>
                 <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="VoiceCardMute" Click="ToggleVoiceMute" Style="{StaticResource IconButton}" Width="34" Height="34" MinHeight="34" Margin="0,0,6,0" Visibility="Collapsed" Content="&#xE720;" ToolTip="Mute microphone (V)" AutomationProperties.Name="Mute microphone"/>
                  <Button x:Name="VoiceCardJoin" Click="ToggleVoice" Style="{StaticResource Primary}" Content="Join" Padding="14,0" Height="34" MinHeight="34" Margin="0" AutomationProperties.Name="Join voice chat"/>
                 </StackPanel>
                </Grid>
               </Border>
               <ListBox x:Name="PeopleList" MaxHeight="280" AutomationProperties.Name="Room participants" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                 <!-- The avatar ring lights up while the person is talking. -->
                 <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoft}" BorderBrush="{Binding Voice.Ring}" BorderThickness="2" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                 <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                 <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Voice.Visibility}" Margin="0,0,6,0">
                  <TextBlock Text="{Binding Voice.Icon}" Foreground="{Binding Voice.IconBrush}" ToolTip="{Binding Voice.Description}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="{Binding Voice.Description}"/>
                  <Button Content="{Binding Voice.LocalMuteIcon}" Visibility="{Binding Voice.LocalMuteVisibility}" Tag="{Binding Id}" Click="ToggleLocalVoiceMute" ToolTip="{Binding Voice.LocalMuteHelp}" AutomationProperties.Name="{Binding Voice.LocalMuteHelp}" Style="{StaticResource QuietIcon}" FontSize="12" Width="28" Height="28" MinHeight="28" Margin="0"/>
                  <!-- This person's level for you, up to twice as loud. -->
                  <Slider Width="70" Minimum="0" Maximum="200" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True" Style="{StaticResource PlayerSlider}" Value="{Binding Voice.Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Voice.LocalMuteVisibility}" ToolTip="{Binding Voice.LevelHelp}" AutomationProperties.Name="{Binding Voice.LevelHelp}" Margin="4,0,0,0"/>
                 </StackPanel>
                 <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Actions}"><Button Content="{Binding AdmitLabel}" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Tag="{Binding Id}" Click="Admit" Style="{StaticResource Primary}" Padding="10,0" Height="30" MinHeight="30" FontSize="12" Margin="0,0,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Style="{StaticResource QuietButton}" Padding="8,0" Height="30" MinHeight="30" FontSize="12" Margin="0"/></StackPanel>
                </Grid>
               </DataTemplate></ListBox.ItemTemplate></ListBox>
               <TextBlock x:Name="RoomFeedback" Visibility="Collapsed" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="4,8,4,0"/>
              </StackPanel></ContentControl></local:MenuSizer>
             </local:PlayerMenuPopup>
             <ToggleButton x:Name="OverflowPill" Style="{StaticResource PlayerMenuPill}" Padding="12,0" Visibility="Hidden" ToolTip="More" AutomationProperties.Name="More"><TextBlock Text="&#xE712;" Style="{StaticResource PlayerPillIcon}" Foreground="{StaticResource PlayerInk}" FontSize="14" Margin="0"/></ToggleButton>
             <local:PlayerMenuPopup x:Name="OverflowMenu" Style="{StaticResource PlayerMenuPopup}" Opened="PlayerMenuOpened"><local:MenuSizer>
              <ContentControl Style="{StaticResource PlayerMenu}" MinWidth="220" PreviewKeyDown="PlayerMenuKeyDown"><StackPanel x:Name="OverflowItems"/></ContentControl></local:MenuSizer>
             </local:PlayerMenuPopup>
            </local:PillStrip>
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PlayerPillGroup}" Margin="10,0,0,0" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal">
             <!-- The volume slider rises above the speaker while the pointer is on it or the volume changes; the level sits beside the speaker. -->
             <StackPanel x:Name="VolumeGroup" Orientation="Horizontal" VerticalAlignment="Center" PreviewMouseWheel="VolumeWheel" MouseEnter="VolumeGroupEntered" MouseLeave="VolumeGroupLeft">
              <Button x:Name="MuteButton" Content="&#xE995;" Click="MutePlayback" Style="{StaticResource PlayerSegmentIcon}" ToolTip="Mute (M)" AutomationProperties.Name="Mute"/>
              <TextBlock x:Name="VolumeText" Text="80%" Foreground="#B4B6C2" FontSize="10.5" MinWidth="28" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False" Typography.NumeralAlignment="Tabular"/>
              <Popup x:Name="VolumeFlyout" Placement="Top" HorizontalOffset="-5" VerticalOffset="-8" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Opened="VolumeFlyoutOpened">
               <Border Background="#F717181F" BorderBrush="{StaticResource PlayerLine}" BorderThickness="1" CornerRadius="10" Width="40" Height="136" Padding="0,10">
                <Slider x:Name="Volume" Orientation="Vertical" IsMoveToPointEnabled="True" Style="{StaticResource PlayerVerticalSlider}" Minimum="0" Maximum="100" Value="80" SmallChange="5" LargeChange="10" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume"/>
               </Border>
              </Popup>
             </StackPanel>
             <Button x:Name="PictureInPictureButton" Content="&#xE8A7;" Click="EnterPictureInPicture" Style="{StaticResource PlayerSegmentIcon}" ToolTip="Picture in picture (I)" AutomationProperties.Name="Picture in picture"/><Button x:Name="FullscreenButton" Content="&#xE740;" Click="Fullscreen" Style="{StaticResource PlayerSegmentIcon}" Margin="0" ToolTip="Fullscreen (F or double-click video)" AutomationProperties.Name="Fullscreen"/></StackPanel></Border>
           </Grid>
          </Border>
         </Border>
        </StackPanel>
        <!-- Picture in picture keeps only play/pause and a way back; they appear while the pointer is over the video.
             The panel has no background, so pressing on the video still reaches the overlay to move or resize the window. -->
        <Grid x:Name="PictureInPictureControls" Visibility="Collapsed">
         <Border Background="#66000000" IsHitTestVisible="False"/>
         <Button x:Name="PictureInPicturePlayButton" Click="TogglePlayback" Style="{StaticResource PlayerPlayButton}" Width="52" Height="52" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Play or pause"/>
         <Button Content="&#xE740;" Click="ExitPictureInPicture" Style="{StaticResource PlayerIconButton}" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Back to the full player (Esc or double-click)" AutomationProperties.Name="Exit picture in picture"/>
        </Grid>
        <!-- Picture in picture is too small for the up-next card, so a compact strip mirrors it along the bottom. -->
        <Border x:Name="PictureInPictureUpNext" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#F217181F" Padding="10,6,6,0" MouseLeftButtonDown="UpNextCardClicked" AutomationProperties.Name="Up next">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
           <TextBlock Text="UP NEXT" Foreground="{DynamicResource PlayerAccent}" FontSize="10" FontWeight="SemiBold"/>
           <TextBlock Text="{Binding Text, ElementName=UpNextEpisode}" ToolTip="{Binding Text, ElementName=UpNextCountdown}" Foreground="#F4F4F7" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="1" Content="&#xE711;" Click="UpNextCancelClicked" Style="{StaticResource PlayerIconButton}" Width="30" MinWidth="30" Height="30" FontSize="11" Margin="0" ToolTip="Stay on this episode (Esc)" AutomationProperties.Name="Cancel up next"/>
          <Button Grid.Column="2" Content="Play now" Click="UpNextPlayClicked" Style="{StaticResource PlayerButton}" Background="{DynamicResource PlayerAccent}" Foreground="{DynamicResource PlayerAccentInk}" FontWeight="SemiBold" FontSize="12" MinHeight="30" Height="30" Padding="10,0" Margin="4,0,0,0" ToolTip="Play the next episode now"/>
          <Border Grid.Row="1" Grid.ColumnSpan="3" Height="3" Margin="-10,6,-6,0" Background="#2E303B" Visibility="{Binding Visibility, ElementName=UpNextProgress}" IsHitTestVisible="False"><Border Background="{DynamicResource PlayerAccent}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="PictureInPictureUpNextFillScale"/></Border.RenderTransform></Border></Border>
         </Grid>
        </Border>
       </Grid>
      </vlc:VideoView>
     </Border>
    </Grid>
   </Grid>
  </Grid>
  <!-- Caption row: the sidebar and details backdrop extend behind it; empty space drags the window. -->
  <Grid x:Name="CaptionBar" Grid.Column="1" Panel.ZIndex="50">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
    <Button x:Name="MinimizeButton" Content="&#xE921;" Click="MinimizeWindow" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize"/>
    <Button x:Name="MaximizeButton" Content="&#xE922;" Click="ToggleMaximizeWindow" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize"/>
    <Button x:Name="CloseButton" Content="&#xE8BB;" Click="CloseWindow" Style="{StaticResource CaptionCloseButton}" AutomationProperties.Name="Close"/>
   </StackPanel>
  </Grid>
  <Border x:Name="AppStatusBar" Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel><ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="96" Height="3" Margin="18,0" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Welcome to Watchroom" Foreground="{DynamicResource Muted}" Margin="16,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
  <Border x:Name="UpdateCard" Grid.Column="1" Grid.Row="1" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="420" Margin="24" Padding="22" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" TextElement.Foreground="{DynamicResource Ink}" Effect="{StaticResource CardShadow}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock x:Name="UpdateCardTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="320"/></StackPanel><TextBlock x:Name="UpdateCardStatus" Style="{StaticResource MutedText}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,14"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="DismissUpdateButton" Content="Later" Style="{StaticResource QuietButton}" Click="DismissUpdate" Margin="0,0,8,0"/><Button x:Name="InstallUpdateButton" Content="Update" Click="InstallUpdate" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></StackPanel></Border></Grid>
</Window>
