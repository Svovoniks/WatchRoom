<Window x:Class="Watchroom.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Watchroom.Desktop" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Style="{StaticResource {x:Type Window}}" Title="Watchroom" Icon="Assets/Watchroom.ico" Width="1280" Height="850" MinWidth="900" MinHeight="640" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" Closing="WindowClosing" PreviewKeyDown="KeyPressed">
 <Grid Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="34"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="192" x:Name="RailWidth"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Rail" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="12,20,12,12" LastChildFill="False">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="6,0,0,8"><Image Source="Assets/Watchroom.png" Width="28" Height="28"/><TextBlock Text="watchroom" FontSize="19" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>


     <Button x:Name="LibraryNav" Tag="Library" Click="LibraryMenuClick" Style="{StaticResource Navigation}" AutomationProperties.Name="Library" AutomationProperties.HelpText="Expand or collapse library categories">
      <Grid Width="126"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▦   Library"/><TextBlock x:Name="LibraryChevron" Grid.Column="1" Text="▾"/></Grid>
     </Button>
     <StackPanel x:Name="LibraryCategories" Margin="18,0,0,8">
      <Button x:Name="AllLibraryNav" Content="All" Tag="0" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="AnimeLibraryNav" Content="Anime" Tag="3" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="ShowsLibraryNav" Content="Shows" Tag="2" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="MoviesLibraryNav" Content="Movies" Tag="1" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="UnavailableLibraryNav" Content="Unavailable" Tag="4" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}" Visibility="Collapsed"/>
     </StackPanel>
     <Button x:Name="QueuesNav" Content="☷   Queues" Tag="Queues" Click="Navigate" Style="{StaticResource Navigation}"/>
     <Button x:Name="RoomNav" Content="▷   Watch rooms" Tag="Rooms" Click="Navigate" Style="{StaticResource Navigation}"/>
     <Button x:Name="FoldersNav" Content="＋   Folders" Tag="Folders" Click="Navigate" Style="{StaticResource Navigation}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">

     <Button x:Name="SettingsNav" Content="⚙   Settings" Tag="Settings" Click="Navigate" Style="{StaticResource Navigation}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,20,24,16" x:Name="ContentArea">
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="LocalLibraryHeader"><TextBlock x:Name="GuestLibraryStatus" Visibility="Collapsed" Style="{StaticResource MutedText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>

     <Border x:Name="HostLibraryActivity" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="8" Padding="12,6" Margin="0,0,0,10">
      <DockPanel><Button x:Name="BrowseWithGuestButton" DockPanel.Dock="Right" Click="BrowseWithGuest" Padding="12,5" Margin="8,0,0,0" Visibility="Collapsed"/><Button DockPanel.Dock="Right" Content="Permissions" Click="OpenLibraryPermissions" Padding="10,5" Margin="8,0,0,0"/><TextBlock x:Name="HostLibraryActivityText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel>
     </Border>
     <Grid x:Name="LibraryToolbar" Height="40" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="SearchFrame" MouseLeftButtonDown="SearchFrameClick" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="10" Padding="14,0,8,0" HorizontalAlignment="Stretch">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" MinHeight="0" TextChanged="SearchChanged" ToolTip="Search your library (Ctrl+F)" AutomationProperties.Name="Search library" VerticalContentAlignment="Center" Margin="0" Padding="0" Background="Transparent" BorderThickness="0">
         <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></TextBox.Template>
        </TextBox>
        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search your library" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Grid.Column="2" Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="×" Click="ClearSearch" ToolTip="Clear search" AutomationProperties.Name="Clear search" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Padding="0" MinHeight="0" Margin="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <ComboBox x:Name="LibraryStatusFilter" Grid.Column="1" Width="152" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter artwork and availability" Margin="12,0,12,0"><ComboBoxItem Content="Any status"/><ComboBoxItem Content="Needs artwork"/></ComboBox>
      <Button x:Name="RescanButton" Grid.Column="2" Width="108" Height="40" MinHeight="0" Padding="12,0" Content="↻  Rescan" Click="ScanClick" Margin="0" ToolTip="Check your folders for new videos"/>
     </Grid>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ItemsControl x:Name="LibraryBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Library location"/><TextBlock Grid.Column="1" x:Name="ResultCount" Width="100" TextAlignment="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,8,0"/></Grid>
     <Expander x:Name="SeasonInformation" Foreground="{DynamicResource Muted}" Header="Season details" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock x:Name="SeasonSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,8" MaxWidth="760" HorizontalAlignment="Left"/></Expander>
    </StackPanel>
    <Grid x:Name="LocalLibraryContent" Grid.Row="1"><ItemsControl x:Name="PosterGrid" PreviewMouseWheel="HostLibraryScrollInput" PreviewTouchDown="HostLibraryTouchInput" VirtualizingPanel.ScrollUnit="Pixel"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="LibraryScroll" PreviewMouseLeftButtonDown="HostLibraryPointerInput" ScrollChanged="LibraryScrollChanged" CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:VirtualizingLibraryPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid><Border Panel.ZIndex="1" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="3" CornerRadius="10" Margin="0,0,12,10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGuestHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border><Button Click="SelectMovie" MouseEnter="LibraryCardHoverEnter" MouseLeave="LibraryCardHoverLeave" Tag="{Binding Card}" Style="{StaticResource PosterCard}" VerticalAlignment="Top" ContextMenuOpening="CardContextMenu" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><StackPanel><Border Background="{DynamicResource Elevated}" CornerRadius="9" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Setter Property="Height" Value="248"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Height" Value="162"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=CardArtwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" Margin="0,12,0,0"/></StackPanel></Grid><Image x:Name="CardArtwork" Source="{Binding Poster, NotifyOnTargetUpdated=True}" ImageFailed="CardArtworkFailed" Loaded="CardArtworkLoaded" TargetUpdated="CardArtworkUpdated"><Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Stretch" Value="Uniform"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid></Border><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,10,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="Height" Value="40"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Caption}"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Text" Value="{Binding EpisodeMeta}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Margin="0,6,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><ProgressBar Height="3" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Background="{DynamicResource Elevated}" Foreground="{DynamicResource Accent}" BorderThickness="0"/><TextBlock Text="{Binding PlaybackLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></StackPanel></Button><Button Click="ToggleCardWatched"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CardWatchedButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRemote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"><TextBlock Text="No videos yet" FontSize="23" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Add a folder, or join a friend without local files." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,15,0,22"/><Button Content="Add folder" Style="{StaticResource Primary}" Tag="Folders" Click="Navigate" HorizontalAlignment="Center"/><Button Content="Join a friend" Click="JoinFromWelcome" HorizontalAlignment="Center"/></StackPanel><StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="No titles found" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Try another search or clear your filters." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,12,0,22"/><Button Content="Clear search and filters" Click="ResetFilters" HorizontalAlignment="Center"/></StackPanel></Grid>

<Border Grid.Row="2" x:Name="NowPlayingStrip" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Return to player →" Tag="Room" Click="Navigate" Margin="12,0,0,0"/><TextBlock x:Name="NowPlayingLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   </Grid>
   <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1100">
<DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="{Binding Content, ElementName=BrowseWithGuestButton}" Visibility="{Binding Visibility, ElementName=BrowseWithGuestButton}" Click="BrowseWithGuest" Margin="12,0,0,0"/><ItemsControl x:Name="DetailBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Video location"/></DockPanel>
<Border Padding="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Elevated}" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top"><Grid><Grid Height="360"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=DetailPoster}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><TextBlock Text="WATCHROOM" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Image x:Name="DetailPoster" Stretch="Uniform"/></Grid></Border>
<StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock x:Name="DetailContext" Foreground="{DynamicResource Accent}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="DetailMeta" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
<WrapPanel><Button x:Name="DetailPlay" Content="Play locally" Style="{StaticResource Primary}" Click="PlayLocal"/><Button x:Name="RestartButton" Content="Start over" Click="RestartLocal" Visibility="Collapsed"/><Button x:Name="DetailHost" Content="Watch together" Click="HostClick"/><Button x:Name="DetailQueue" Content="Add to queue" Click="QueueClick"/><Button x:Name="DetailRemove" Content="Remove from library" Click="RemoveUnavailableVideo" Visibility="Collapsed" ToolTip="Remove the saved entry for this unavailable video"/></WrapPanel>
<TextBlock x:Name="DetailSummary" Margin="0,12,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
<ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed"/></StackPanel></Grid></Border>
<TextBlock Text="File" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="DetailFile" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
<Expander Header="Artwork and matching" Foreground="{DynamicResource Muted}" Margin="0,24,0,16"><WrapPanel Margin="0,12,0,0"><Button Content="Correct title" Click="EditTitle"/><Button Content="Find artwork / fix match" Click="MatchClick"/><Button Content="Use local poster" Click="LocalPoster"/></WrapPanel></Expander>
</StackPanel></ScrollViewer>

   <ScrollViewer x:Name="WelcomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,16,0,0">
     <TextBlock Text="Welcome to Watchroom" Style="{StaticResource PageHeading}"/>
     <TextBlock Text="Add your videos or join a friend. Only the host needs the files." Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
     <WrapPanel><Button Content="Add folder" Tag="Folders" Click="Navigate" Style="{StaticResource Primary}"/><Button Content="Join a friend" Click="JoinFromWelcome"/></WrapPanel>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="850" HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0">
     <DockPanel Margin="0,0,0,16"><Button x:Name="AddFolderButton" DockPanel.Dock="Right" Content="Add folder" Style="{StaticResource Primary}" Click="AddFolder" Margin="12,0,0,0" ToolTip="Includes subfolders. Select an added folder to change its category."/><TextBlock Text="Folders" Style="{StaticResource PageHeading}"/></DockPanel>
     <Grid>
      <ListBox x:Name="FolderList" SelectionChanged="FolderSelectionChanged" MinHeight="120" MaxHeight="240" AutomationProperties.Name="Library folders" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5"><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="No folders yet. Add a folder to discover your videos." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=FolderList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <StackPanel x:Name="FolderEditor" Visibility="Collapsed" Margin="0,16,0,0">
      <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Category"/><ComboBox x:Name="FolderKind" Width="150" Margin="0,4,0,8" AutomationProperties.Name="Folder category" SelectedIndex="0"><ComboBoxItem Content="Mixed"/><ComboBoxItem Content="Movie"/><ComboBoxItem Content="Show"/><ComboBoxItem Content="Anime"/></ComboBox></StackPanel>
       <Button x:Name="ChangeFolderButton" Content="Apply category" Click="ChangeFolderKind" IsEnabled="False" VerticalAlignment="Bottom"/>
       <Button x:Name="RemoveFolderButton" Content="Remove folder" Click="RemoveFolder" IsEnabled="False" VerticalAlignment="Bottom"/>
      </WrapPanel>
     </StackPanel>
     <WrapPanel Margin="0,16,0,0"><Button x:Name="ScanButton" Content="Scan library" Click="ScanClick"/><Button x:Name="CancelScanButton" Content="Cancel scan" Click="CancelScan" Visibility="Collapsed"/></WrapPanel>
     <TextBlock x:Name="ScanStatus" Style="{StaticResource MutedText}" Margin="0,4,0,16" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="Excluded folders" Style="{StaticResource SectionHeading}"/>
     <ListBox x:Name="ExcludedFolderList" MinHeight="80" MaxHeight="180" SelectionChanged="ExcludedSelectionChanged" AutomationProperties.Name="Excluded folders"/>
     <WrapPanel Margin="0,12,0,0"><Button x:Name="ExcludeFolderButton" Content="Exclude folder" Click="ExcludeFolder"/><Button x:Name="RestoreFolderButton" Content="Remove exclusion" Click="RestoreFolder" IsEnabled="False"/></WrapPanel>
    </StackPanel></Grid>
   </ScrollViewer>
   <Grid x:Name="QueuesPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><TextBlock Text="Queues" Style="{StaticResource PageHeading}"/><Button Content="Create queue" Click="CreateQueue" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Primary}" Margin="0"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ListBox Grid.Row="1" x:Name="QueuePicker" SelectionChanged="SavedQueueChanged" AutomationProperties.Name="Saved queues" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}, {1} videos"><Binding Path="Name"/><Binding Path="MediaIds.Length"/></MultiBinding></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaIds.Length, StringFormat={}{0} videos}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="QueueDetailTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="QueueDetailCaption" Style="{StaticResource MutedText}" Margin="0,4,0,12"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,0,10"><WrapPanel><Button x:Name="PlaySavedQueueButton" Content="Play queue" Click="PlaySavedQueue" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="PlaySelectedSavedQueueButton" Content="Play selected" Click="PlaySelectedSavedQueue" IsEnabled="False"/><Button x:Name="AddQueueVideosButton" Content="Add videos" Click="AddQueueVideos"/></WrapPanel><TextBlock x:Name="SavedQueueFeedback" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
       <Grid Grid.Row="2">
        <ListBox x:Name="SavedQueueItems" SelectionChanged="SavedQueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" AutomationProperties.Name="Queue videos" AutomationProperties.HelpText="Select a video and choose Play selected, double-click it, or press Enter to play from that point in the queue." Background="Transparent" BorderThickness="0" AllowDrop="True" PreviewMouseMove="QueueDragMove" PreviewDragOver="QueueDragOver" DragLeave="QueueDragLeave" PreviewDrop="QueueDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CardBorder" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Elevated}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder" PreviewMouseLeftButtonDown="QueueDragDown"><TextBlock Text="⠿" FontSize="23" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Border>
          <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,4,12,4"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
          <Button Grid.Column="3" Content="×" FontSize="22" Width="40" Height="40" Padding="0" Margin="0" VerticalAlignment="Center" Tag="{Binding}" Click="RemoveSavedItem" ToolTip="Remove from queue" AutomationProperties.Name="Remove video from queue"/>
         </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="QueueDropMarker" Height="3" CornerRadius="1" Background="{DynamicResource Accent}" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
       </Grid>
       <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0"><WrapPanel><Button x:Name="SavedQueueEarlier" Content="↑" Width="40" Padding="0" ToolTip="Move earlier" AutomationProperties.Name="Move earlier" Tag="Earlier" Click="EditQueueOrder" IsEnabled="False"/><Button x:Name="SavedQueueLater" Content="↓" Width="40" Padding="0" ToolTip="Move later" AutomationProperties.Name="Move later" Tag="Later" Click="EditQueueOrder" IsEnabled="False"/><Button Content="Rename" Click="RenameQueue"/><Button Content="Delete queue" Click="DeleteQueue"/></WrapPanel></Border>
      </Grid>
     </Border>
    </Grid>
   </Grid>

   <Grid x:Name="SettingsPage" Visibility="Collapsed">
    <Grid.Resources><Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/><Setter Property="Margin" Value="0,0,0,8"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageHeading}" Margin="0,0,0,12"/>
     <WrapPanel x:Name="PreferenceSections" Margin="0,0,0,20">
      <Button Content="Profile" Tag="Profile" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
      <Button Content="Metadata" Tag="Metadata" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
      <Button Content="Playback" Tag="Playback" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
      <Button Content="Appearance" Tag="Appearance" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
      <Button Content="Updates &amp; about" Tag="Updates" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
     </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="ProfilePreferences" Tag="Profile" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Margin="0,0,18,12" HorizontalAlignment="Stretch">
      <TextBlock Text="Your display name"/><TextBox x:Name="DisplayNameBox" AutomationProperties.Name="Your display name" MaxLength="40"/>
      <TextBlock x:Name="DisplayNameError" Style="{StaticResource FieldError}"/>
      <TextBlock Text="Watchroom server"/><TextBox x:Name="ServerBox" AutomationProperties.Name="Room server address"/>
      <TextBlock x:Name="ServerError" Style="{StaticResource FieldError}"/>
      <TextBlock Text="Change the server only if you host your own." Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="MetadataPreferences" Tag="Metadata" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Margin="0,0,18,12" HorizontalAlignment="Stretch">
      <CheckBox x:Name="AutoArtwork" Content="Automatically fetch artwork and metadata"/>
      <TextBlock Text="Providers · in priority order" FontWeight="SemiBold" Margin="0,12,0,10"/>
      <ListBox x:Name="MetadataProviders" AutomationProperties.Name="Metadata provider order" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="↑" Tag="Up" Click="ProviderMoved" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}" MinHeight="32" Padding="10,4" Margin="6,0,0,0"/>
        <Button Content="↓" Tag="Down" Click="ProviderMoved" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}" MinHeight="32" Padding="10,4" Margin="6,0,0,0"/>
       </StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="PreferencesChanged" Margin="0" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="Providers receive title searches, never video files. Disable all to use local metadata." Style="{StaticResource MutedText}" Margin="0,10,0,14"/>
      <WrapPanel><StackPanel Width="270" Margin="0,0,12,0"><TextBlock Text="Language"/><ComboBox x:Name="MetadataLanguage" AutomationProperties.Name="Metadata language" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/></StackPanel><StackPanel Width="270"><TextBlock Text="Country"/><ComboBox x:Name="MetadataCountry" AutomationProperties.Name="Metadata country" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/></StackPanel></WrapPanel>
      <TextBlock x:Name="LocaleError" Style="{StaticResource FieldError}"/>
      <TextBlock Text="Refresh frequency" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <WrapPanel><CheckBox x:Name="NeverRefresh" Content="Never refresh automatically" Margin="0,10,18,10"/><TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <Button x:Name="RefreshLess" Content="−" Click="ChangeRefreshDays" AutomationProperties.Name="Decrease refresh days" Padding="10,4" Margin="0,6,4,14"/>
       <TextBox x:Name="MetadataRefreshDays" Width="64" AutomationProperties.Name="Refresh interval in days" MaxLength="3"/>
       <Button x:Name="RefreshMore" Content="+" Click="ChangeRefreshDays" AutomationProperties.Name="Increase refresh days" Padding="10,4" Margin="4,6,8,14"/>
       <TextBlock Text="days (1–365)" VerticalAlignment="Center"/>
      </WrapPanel><TextBlock x:Name="RefreshDaysError" Style="{StaticResource FieldError}"/>
      <CheckBox x:Name="GroupShows" Content="Combine show folders when provider IDs match"/><CheckBox x:Name="ImportMissing" Content="Show missing episodes"/><CheckBox x:Name="ImportUpcoming" Content="Show upcoming episodes"/><CheckBox x:Name="DisplaySpecials" Content="Show specials within their aired seasons when placement is known"/><CheckBox x:Name="SaveNfo" Content="Save metadata beside videos as NFO files"/>
      <TextBlock Text="TMDB key" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="API key or read access token (optional)"/><PasswordBox x:Name="MetadataToken" AutomationProperties.Name="TMDB API key or read access token" PasswordChanged="MetadataKeyChanged"/>
      <TextBlock x:Name="MetadataKeyStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
      <TextBlock Text="Save changes stores the key in Windows Credential Manager. Clear it and save to remove it." Style="{StaticResource MutedText}"/>
      <TextBlock Text="Manual refresh" Style="{StaticResource SectionHeading}"/><TextBlock Text="Uses saved preferences." Style="{StaticResource MutedText}"/>
      <ComboBox x:Name="MetadataRefreshMode" SelectedIndex="0" AutomationProperties.Name="Metadata refresh action"><ComboBoxItem Content="Fill missing metadata"/><ComboBoxItem Content="Refresh text metadata"/><ComboBoxItem Content="Refresh text and replace downloaded artwork"/></ComboBox>
      <Button Content="Fetch artwork and metadata" Click="FetchArtworkClick" HorizontalAlignment="Left"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="PlaybackPreferences" Tag="Playback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Margin="0,0,18,12" HorizontalAlignment="Stretch">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Audio priority"/><TextBox x:Name="PreferredAudioLanguages" AutomationProperties.Name="Preferred audio languages in priority order" ToolTip="en, ja or English, Japanese"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="Default subtitle priority"/><TextBox x:Name="PreferredSubtitleLanguages" AutomationProperties.Name="Default subtitle languages in priority order" ToolTip="en, ja, off or English, Japanese, off"/></StackPanel>
      </Grid>
      <TextBlock Text="Default subtitles apply to audio languages without a rule." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
      <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SubtitleLanguageRules}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Audio language"/><TextBlock Grid.Column="1" Text="Subtitle priority"/>
      </Grid>
      <ItemsControl x:Name="SubtitleLanguageRules"><ItemsControl.ItemTemplate><DataTemplate>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding AudioLanguage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Audio language for subtitle rule" ToolTip="Japanese or ja" Margin="0,4,12,12"/>
        <TextBox Grid.Column="1" Text="{Binding SubtitleLanguages, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Subtitle languages for audio language in priority order" ToolTip="English, Russian, off" Margin="0,4,12,12"/>
        <Button Grid.Column="2" Content="×" Click="RemoveSubtitleRule" ToolTip="Remove language rule" AutomationProperties.Name="Remove subtitle language rule" Margin="0,4,0,12" Padding="8"/>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button x:Name="AddSubtitleRuleButton" Content="+ Add audio rule" Click="AddSubtitleRule" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <TextBlock Text="List names or codes in order, separated by commas (English, Russian or en, ru). Use off to disable subtitles; leave blank for video defaults." Style="{StaticResource MutedText}"/>
      <Expander Header="Language preference help" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"><TextBlock Text="Rules follow the selected audio language. Add off last to disable subtitles if no language matches. Manual subtitle choices last until the next video. Saved preferences apply to the next video; guests follow the host’s tracks." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></Expander>
      <TextBlock x:Name="TrackPreferencesError" Style="{StaticResource FieldError}"/>
      <TextBlock Text="FFmpeg executable (optional)"/><TextBox x:Name="FfmpegBox" AutomationProperties.Name="FFmpeg executable path" ToolTip="Used to prepare smaller copies of your videos"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="AppearancePreferences" Tag="Appearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="ThemeStatus" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
      <Button Content="Switch light / dark" Click="ToggleTheme" HorizontalAlignment="Left"/><TextBlock Text="Saved immediately." Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="UpdatePreferences" Tag="Updates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,0,18,12">
      <TextBlock Text="Update preferences save immediately." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
      <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeading}" Margin="0,24,0,10"/><TextBlock Text="For connection or playback issues, share logs from both devices. Invitations, credentials and videos are excluded." Style="{StaticResource MutedText}"/><Button x:Name="OpenLogsFolderButton" Content="Open logs folder" Click="OpenLogsFolder" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left"/><TextBlock Text="App updates" Style="{StaticResource SectionHeading}" Margin="0,24,0,10"/><CheckBox x:Name="AutoCheckUpdates" Content="Automatically check for updates" Checked="AutoUpdatesChanged" Unchecked="AutoUpdatesChanged"/><TextBlock Text="Checks at startup and every six hours. Updates install only when you click Update." Style="{StaticResource MutedText}"/><Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdatesClick" HorizontalAlignment="Left" Margin="0,12,0,8"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="About" Style="{StaticResource SectionHeading}"/><TextBlock Text="Video playback by libVLC / LibVLCSharp. Peer connections by libdatachannel / DataChannelDotnet. Artwork by TVmaze (https://www.tvmaze.com, CC BY-SA), Wikipedia, and optional TMDB. Source pages appear in title details." Style="{StaticResource MutedText}"/><TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Canvas}" Padding="0,12,0,0" Margin="0,12,0,0">
     <StackPanel><TextBlock x:Name="PreferencesStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
      <WrapPanel><Button x:Name="SavePreferencesButton" Content="Save changes" Click="SaveSettings" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="CancelPreferencesButton" Content="Cancel" Click="CancelPreferences" IsEnabled="False"/></WrapPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Grid x:Name="RoomsPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Watch rooms" Style="{StaticResource PageHeading}" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CreateSavedRoomButton" Content="Create room" Click="CreatePersistentRoom" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="AddSavedInvitationButton" Content="Add invitation" Click="SaveRoomInvitation" Margin="0" ToolTip="Paste an invitation link or room code to add it to your saved rooms"/><Button x:Name="ReturnToRoomButton" Content="Return to player" Tag="Room" Click="Navigate" Margin="8,0,0,0"/></StackPanel></Grid>
    <Grid Grid.Row="1"><StackPanel x:Name="RoomsEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"><TextBlock Text="No rooms yet" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Create a room or join a friend. Only the host needs the video." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,14,0,22"/><WrapPanel HorizontalAlignment="Center"><Button Content="Create room" Click="CreatePersistentRoom" Style="{StaticResource Primary}"/><Button Content="Add invitation" Click="SaveRoomInvitation"/></WrapPanel></StackPanel><Grid x:Name="SavedRoomsContent" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DockPanel><ListBox x:Name="SavedRoomsList" SelectionChanged="SavedRoomSelectionChanged" AutomationProperties.Name="Saved watch rooms" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
     <Border x:Name="SavedRoomDetails" Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <TextBlock x:Name="SavedRoomHeading" Text="Choose a room" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="SavedRoomStatus" Text="Create a room or save an invitation to get started." Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
       <WrapPanel><Button x:Name="ConnectSavedRoomButton" Content="Connect" Click="ConnectSavedRoom" Style="{StaticResource Primary}"/><Button x:Name="CopySavedInviteButton" Content="Copy invitation" Click="CopySavedInvitation"/></WrapPanel>
       <StackPanel x:Name="SavedRoomHostControls"><TextBlock Text="Permissions" Style="{StaticResource SectionHeading}"/>
       <ToggleButton x:Name="SavedRoomSharedControls" Content="Guest playback controls" ToolTip="Guests can play, pause and seek. Changes save immediately." Click="SavedRoomControlsChanged" AutomationProperties.Name="Saved room shared controls" Style="{StaticResource Switch}"/>
       <CheckBox x:Name="SavedRoomLibraryBrowsing" Content="Allow guests to browse my library" ToolTip="One admitted guest can browse at a time. Turning this off ends the active session." Checked="SavedRoomLibraryChanged" Unchecked="SavedRoomLibraryChanged"/>
       </StackPanel><Button x:Name="SavedRoomLibraryButton" Content="Room library" Click="OpenRoomLibrary" HorizontalAlignment="Left" IsEnabled="False" Margin="0,12,0,0"/>
       <StackPanel x:Name="SavedRoomGuestManagement"><TextBlock Text="Guests" Style="{StaticResource SectionHeading}"/>
       <TextBlock x:Name="SavedRoomGuestHint" Text="Connect as the host to manage guests. Admitted guests are remembered when they reconnect." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
       <ItemsControl x:Name="SavedRoomGuests" AutomationProperties.Name="Saved room guests"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{Binding AdmitLabel}" Tag="{Binding Id}" Click="Admit" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Padding="8,6" MinHeight="32"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" IsEnabled="{Binding CanRemove}" Padding="8,6" MinHeight="32"/></WrapPanel></Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,14,0,0"><WrapPanel><Button x:Name="RenameSavedRoomButton" Content="Rename" Click="RenameSavedRoom"/><Button x:Name="ForgetSavedRoomButton" Content="Forget room" Click="ForgetSavedRoom"/></WrapPanel></Border>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid></Grid>
   </Grid>
   <Grid x:Name="RoomPage" Visibility="Collapsed" Background="#101112">
    <Grid.Resources>
     <SolidColorBrush x:Key="Surface" Color="#222426"/><SolidColorBrush x:Key="Elevated" Color="#303236"/><SolidColorBrush x:Key="Ink" Color="#F3F3F3"/><SolidColorBrush x:Key="Muted" Color="#AFB2B8"/><SolidColorBrush x:Key="Line" Color="#42454A"/><SolidColorBrush x:Key="Accent" Color="#F3A44B"/>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="RoomHeader" Background="#222426" BorderBrush="#3C3E42" BorderThickness="0,0,0,1" Padding="12,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="←  Library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RoomHeading" Text="Watchroom player" Foreground="#F3F3F3" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RoomSubtitle" Text="Choose a video from your library to start watching." Foreground="#AFB2B8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"><Button x:Name="RoomLibraryButton" Content="Room library" Click="OpenRoomLibrary" Style="{StaticResource PlayerButton}" Visibility="Collapsed" ToolTip="Browse the host library, manage the room queue and guest access"/><Button x:Name="RoomToggle" Content="Room &amp; chat" Click="ToggleRoomPanel" Style="{StaticResource PlayerButton}" ToolTip="Show or hide participants and chat"/><Button x:Name="InviteButton" Content="Copy invite" Click="CopyInvite" Style="{StaticResource PlayerButton}"/><Button x:Name="LeaveButton" Content="Leave" Click="LeaveRoom" Style="{StaticResource PlayerButton}"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="0" x:Name="RoomSplitterWidth"/><ColumnDefinition Width="0" x:Name="RoomSideWidth" MaxWidth="600"/></Grid.ColumnDefinitions>
     <Border x:Name="VideoFrame" Background="Black">
      <vlc:VideoView x:Name="Video">
       <!-- A nonzero alpha keeps the native overlay hit-testable over the video. -->
       <Grid x:Name="PlayerOverlay" Background="#01000000" Focusable="True" MouseMove="PlayerMouseMoved" MouseLeftButtonDown="VideoClicked" MouseWheel="VideoWheel" PreviewKeyDown="KeyPressed">
        <Border x:Name="PlayerEmpty" Background="Black"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▶" FontSize="52" Foreground="#F3A44B" HorizontalAlignment="Center"/><TextBlock Text="Choose a video to play" FontSize="22" Foreground="#EEEEEE" HorizontalAlignment="Center" Margin="0,16,0,20"/><Button Content="Browse library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" HorizontalAlignment="Center"/></StackPanel></Viewbox></Border>
        <Border x:Name="PlaybackTitleOverlay" VerticalAlignment="Top" Background="#CC222426" Padding="18,12" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="{Binding Visibility, ElementName=PlaybackControls}"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PlaybackTitleLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock x:Name="PlaybackTitleLabel" Foreground="#F3F3F3" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Currently playing"/></Border>
        <Border x:Name="FullscreenHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,62,0,0" Background="#DC222426" CornerRadius="6" Padding="18,10"><TextBlock Text="Fullscreen · Esc to exit · Move the mouse for controls" Foreground="#EEEEEE" FontSize="13"/></Border>
        <Grid x:Name="FullscreenControlsHost" VerticalAlignment="Bottom"/>
       </Grid>
      </vlc:VideoView>
     </Border>
     <GridSplitter Grid.Column="1" x:Name="RoomSplitter" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" KeyboardIncrement="16" ToolTip="Drag to resize participants and chat" AutomationProperties.Name="Resize room panel"/>
     <Grid Grid.Column="2" x:Name="RoomSide" Margin="12,16" SizeChanged="RoomPanelSizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl x:Name="RoomTabs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}">
       <TabControl.Resources>
        <Style TargetType="TabItem">
         <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,10"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Elevated}"/></Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style>
       </TabControl.Resources>
       <TabItem Header="Participants">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="PeopleList" AutomationProperties.Name="Room participants" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
          <Grid Margin="2,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Actions}"><Button Content="{Binding AdmitLabel}" Visibility="{Binding AdmitVisibility}" IsEnabled="{Binding CanAdmit}" Tag="{Binding Id}" Click="Admit" Padding="8,6" MinHeight="32" FontSize="12" Margin="0,0,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Padding="8,6" MinHeight="32" FontSize="12" Margin="0"/></StackPanel>
          </Grid>
         </DataTemplate></ListBox.ItemTemplate></ListBox>
         <Button Grid.Row="1" Content="Join a room" Click="JoinClick" Margin="0,12,0,0"/>
        </Grid>
       </TabItem>
       <TabItem Header="Chat">
        <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ListBox x:Name="ChatList" BorderThickness="0" AutomationProperties.Name="Room chat" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ListBox.ItemTemplate></ListBox>
         <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" MaxLength="1000" KeyDown="ChatKey" ToolTip="Message the room" AutomationProperties.Name="Message the room" Margin="0,8,6,0"/><Button Grid.Column="1" x:Name="SendChatButton" Content="Send" Click="SendChat" Padding="12,8" Margin="0,8,0,0"/></Grid>
        </Grid>
       </TabItem>
      </TabControl>
      <TextBlock Grid.Row="1" x:Name="RoomFeedback" Visibility="Collapsed" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </Grid>
    </Grid>
    <Grid x:Name="DockedControlsHost" Grid.Row="2">
     <Border x:Name="PlaybackControls" Background="#F5222426" BorderBrush="#42454A" BorderThickness="0,1,0,0" Padding="14,8,14,10" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed">
      <Border.Resources><SolidColorBrush x:Key="Surface" Color="#222426"/><SolidColorBrush x:Key="Elevated" Color="#303236"/><SolidColorBrush x:Key="Ink" Color="#F3F3F3"/><SolidColorBrush x:Key="Muted" Color="#AFB2B8"/><SolidColorBrush x:Key="Line" Color="#42454A"/><SolidColorBrush x:Key="Accent" Color="#F3A44B"/><SolidColorBrush x:Key="AccentInk" Color="#222426"/></Border.Resources>
      <StackPanel>
       <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="Timeline" PreviewMouseWheel="TimelineWheel" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewMouseMove="SeekMoved" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyStarted" PreviewKeyUp="SeekKeyFinished" AutomationProperties.Name="Playback position"/><TextBlock Grid.Column="1" x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="#D7D9DC" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" Margin="16,0,0,0"/><Button x:Name="EpisodeEndButton" Grid.Column="2" Content="Next episode →" Click="EpisodeEndClicked" Visibility="Collapsed" Margin="12,0,0,0" Padding="12,5" Style="{StaticResource PlayerButton}" AutomationProperties.Name="Next episode"/></Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶" Click="TogglePlayback" Style="{StaticResource PlayerIconButton}" FontSize="22"  BorderBrush="#F3A44B" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause"/><Button x:Name="StopButton" Content="■" Click="StopPlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Stop (S)" AutomationProperties.Name="Stop playback"/><Border Width="1" Background="#42454A" Margin="6,5,12,5"/><Button x:Name="BackwardButton" Content="−10" Click="SkipBackward" Style="{StaticResource PlayerIconButton}" ToolTip="Back 10 seconds (Left)" AutomationProperties.Name="Back 10 seconds"/><Button x:Name="ForwardButton" Content="+10" Click="SkipForward" Style="{StaticResource PlayerIconButton}" ToolTip="Forward 10 seconds (Right)" AutomationProperties.Name="Forward 10 seconds"/><Button x:Name="PreviousButton" Visibility="Collapsed" Content="|◀" Click="PreviousQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Previous video (P)" AutomationProperties.Name="Previous video"/><Button x:Name="NextButton" Visibility="Collapsed" Content="▶|" Click="NextQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Next in queue (N)" AutomationProperties.Name="Next in queue"/></StackPanel>
        <TextBlock Grid.Column="1" x:Name="ConnectionStatus" Text="Local playback" Foreground="#AFB2B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="14,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="OptionsButton" Content="Playback options" Click="TogglePlayerOptions" Style="{StaticResource PlayerButton}" ToolTip="Audio, subtitles, quality and queue"/><Button x:Name="MuteButton" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Click="MutePlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Mute (M)" AutomationProperties.Name="Mute"/><Slider x:Name="Volume" PreviewMouseWheel="VolumeWheel" IsMoveToPointEnabled="True" Style="{StaticResource PlayerSlider}" Width="90" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume" Margin="4,0,8,0"/><TextBlock x:Name="VolumeText" Text="80%" Foreground="#D7D9DC" Width="38" VerticalAlignment="Center" FontSize="12"/><Button x:Name="FullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="18" Click="Fullscreen" Style="{StaticResource PlayerIconButton}" ToolTip="Fullscreen (F or double-click video)" AutomationProperties.Name="Fullscreen"/></StackPanel>
       </Grid>
       <Border x:Name="PlayerOptions" Visibility="Collapsed" BorderBrush="#42454A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0"><ScrollViewer x:Name="PlayerOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260"><StackPanel>
<ToggleButton x:Name="SharedControls" Content="Allow shared controls" Click="ControlsChanged" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12" Style="{StaticResource Switch}" AutomationProperties.Name="Allow shared controls" ToolTip="Let admitted guests control room playback"/>
        <WrapPanel>
         <StackPanel Orientation="Horizontal"><TextBlock Text="Audio" Foreground="#D7D9DC" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="AudioTracks" Width="200" DisplayMemberPath="Name" SelectionChanged="AudioChanged" ToolTip="Audio track" AutomationProperties.Name="Audio track" Style="{StaticResource PlayerOptionPicker}"/></StackPanel>
         <StackPanel Orientation="Horizontal"><TextBlock Text="Subtitles" Foreground="#D7D9DC" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="SubtitleTracks" Width="200" DisplayMemberPath="Name" SelectionChanged="SubtitlesChanged" ToolTip="Subtitle track" AutomationProperties.Name="Subtitle track" Style="{StaticResource PlayerOptionPicker}"/></StackPanel>
         <Button x:Name="LoadSubtitlesButton" Content="Load subtitles…" Click="LoadSubtitles" Style="{StaticResource PlayerOptionButton}"/>
         <Button x:Name="PrepareButton" Content="Prepare 720p copy" Click="PrepareCopy" Style="{StaticResource PlayerOptionButton}"/>
        </WrapPanel>
        <Border BorderBrush="#42454A" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,12,0,0">
         <StackPanel>
          <WrapPanel>
           <StackPanel Orientation="Horizontal"><TextBlock Text="Queue" Foreground="#D7D9DC" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="PlayerQueuePicker" Width="200" DisplayMemberPath="Name" SelectionChanged="PlayerQueueChanged" AutomationProperties.Name="Player queue" Style="{StaticResource PlayerOptionPicker}"/></StackPanel>
           <Button x:Name="PlayPlayerQueueButton" Content="Play queue" Click="PlayPlayerQueue"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlayerOptionButton}"><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=QueueList}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
           <Button Content="Manage queues" Tag="Queues" Click="Navigate" Style="{StaticResource PlayerOptionButton}"/>
          </WrapPanel>
          <ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" MaxHeight="120" DisplayMemberPath="QueueTitle" AutomationProperties.Name="Playback queue" AutomationProperties.HelpText="Select a video and choose Play selected, double-click it, or press Enter to play from that point in the queue." Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
           <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
          </ListBox>
          <WrapPanel x:Name="QueueEditActions" Visibility="Collapsed">
           <Button x:Name="PlaySelectedQueueButton" Content="Play selected" Click="PlaySelectedQueued" Style="{StaticResource PlayerOptionButton}" IsEnabled="False"/>
           <Button x:Name="QueueEarlier" Content="↑" Tag="Earlier" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="36" Padding="0" ToolTip="Move earlier" AutomationProperties.Name="Move earlier"/>
           <Button x:Name="QueueLater" Content="↓" Tag="Later" Click="MoveQueued" Style="{StaticResource PlayerOptionButton}" Width="36" Padding="0" ToolTip="Move later" AutomationProperties.Name="Move later"/>
           <Button x:Name="RemoveQueueButton" Content="Remove" Click="RemoveQueued" Style="{StaticResource PlayerOptionButton}" ToolTip="Remove selected video from queue" AutomationProperties.Name="Remove selected video from queue"/>
          </WrapPanel>
          <TextBlock x:Name="QueueStatus" Text="Queue is empty." Foreground="#AFB2B8" FontSize="12" TextWrapping="Wrap"/>
         </StackPanel>
        </Border></StackPanel></ScrollViewer></Border>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="AppStatusBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel><ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="90" Height="3" Margin="18,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="StatusText" Text="Welcome to Watchroom" Foreground="{DynamicResource Muted}" Margin="18,7" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
 <Border x:Name="UpdateCard" Grid.Column="1" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="440" Margin="24" Padding="22" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource Surface}"><StackPanel><TextBlock x:Name="UpdateCardTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="UpdateCardStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,16" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,14"/><WrapPanel><Button x:Name="InstallUpdateButton" Content="Update" Click="InstallUpdate" Style="{StaticResource Primary}"/><Button x:Name="DismissUpdateButton" Content="Later" Click="DismissUpdate"/></WrapPanel></StackPanel></Border></Grid>
</Window>
