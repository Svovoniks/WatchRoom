<Window x:Class="Watchroom.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Style="{StaticResource {x:Type Window}}" Title="Watchroom" Width="1280" Height="850" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="WindowClosing" PreviewKeyDown="KeyPressed">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="190" x:Name="RailWidth"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Rail" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="18,24,12,18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="◉ watchroom" FontSize="23" FontWeight="SemiBold" Margin="2,0,0,5"/><TextBlock Text="YOUR PRIVATE CINEMA" FontSize="10" Foreground="{DynamicResource Muted}" Margin="3,0,0,32"/><Button Content="Library" Tag="Library" Click="Navigate" HorizontalContentAlignment="Left"/><Button Content="Watch room" Tag="Room" Click="Navigate" HorizontalContentAlignment="Left"/><Button Content="Folders" Tag="Folders" Click="Navigate" HorizontalContentAlignment="Left"/></StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Button Content="Settings" Tag="Settings" Click="Navigate" HorizontalContentAlignment="Left"/><TextBlock Text="Windows preview · 0.1" Style="{StaticResource MutedText}" FontSize="11" Margin="5,10,0,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,24,30,18" x:Name="ContentArea">
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><DockPanel><Button Content="Join a room" DockPanel.Dock="Right" Click="JoinClick"/><TextBlock Text="YOUR COLLECTION, TOGETHER" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center"/></DockPanel><TextBlock Text="What’s on tonight?" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Pick something you love. Bring your people." Style="{StaticResource MutedText}"/><Grid Margin="0,16,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Search your library" AutomationProperties.Name="Search library" Margin="0,6,14,12"/><ComboBox x:Name="Category" Grid.Column="1" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="All titles"/><ComboBoxItem Content="Movies"/><ComboBoxItem Content="Shows"/><ComboBoxItem Content="Anime"/><ComboBoxItem Content="Needs artwork"/></ComboBox><Button Grid.Column="2" Content="Rescan" Click="ScanClick" Margin="8,6,0,12"/></Grid></StackPanel>
    <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="PosterGrid"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="SelectMovie" Tag="{Binding}" Width="176" Padding="0" Margin="0,0,18,22" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><StackPanel><Border Height="238" Background="{DynamicResource Elevated}" CornerRadius="9" ClipToBounds="True"><Grid><StackPanel VerticalAlignment="Center" Margin="14"><TextBlock Text="◉" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" Margin="0,12,0,0"/></StackPanel><Image Source="{Binding Poster}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"><TextBlock Text="Your next movie night starts here." FontSize="23" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Add the folders where you keep movies, shows and anime. Watchroom will bring them into one library." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,15,0,22"/><Button Content="Add your first folder" Style="{StaticResource Primary}" Tag="Folders" Click="Navigate" HorizontalAlignment="Center"/></StackPanel></Grid>
    <Border x:Name="Details" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="10" Padding="20" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="DetailTitle" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DetailSummary" Style="{StaticResource MutedText}" MaxHeight="62" Margin="0,5,0,10"/><ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed"/><WrapPanel><Button Content="Play locally" Click="PlayLocal"/><Button Content="Watch together" Style="{StaticResource Primary}" Click="HostClick"/><Button Content="Find artwork / fix match" Click="MatchClick"/><Button Content="Use local poster" Click="LocalPoster"/><Button Content="Add to queue" Click="QueueClick"/></WrapPanel></StackPanel></Border>
   </Grid>
   <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed"><StackPanel MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="MAKE YOURSELF AT HOME" Foreground="{DynamicResource Accent}" FontSize="11"/><TextBlock Text="Where do you keep your movies?" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="Choose as many folders as you need. Subfolders are included automatically. Your files stay on this computer." Style="{StaticResource MutedText}" Margin="0,0,0,24"/><ListBox x:Name="FolderList" MinHeight="160" MaxHeight="300" DisplayMemberPath="Path"/><WrapPanel Margin="0,20,0,0"><ComboBox x:Name="FolderKind" SelectedIndex="0"><ComboBoxItem Content="Mixed"/><ComboBoxItem Content="Movie"/><ComboBoxItem Content="Show"/><ComboBoxItem Content="Anime"/></ComboBox><Button Content="Add folder" Click="AddFolder" Margin="8,6,8,12"/><Button Content="Remove selected" Click="RemoveFolder" Margin="0,6,0,12"/></WrapPanel><Button Content="Scan library" Style="{StaticResource Primary}" Click="ScanClick" HorizontalAlignment="Left"/><TextBlock x:Name="ScanStatus" Style="{StaticResource MutedText}" Margin="0,12,0,16"/><TextBlock Text="Just joining friends? You can join a room without adding any folders." Style="{StaticResource MutedText}"/><Button Content="Join a room" Click="JoinClick" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></ScrollViewer>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel MaxWidth="680" HorizontalAlignment="Left"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBlock Text="Your display name"/><TextBox x:Name="DisplayNameBox" MaxLength="40"/><TextBlock Text="Watchroom server"/><TextBox x:Name="ServerBox" ToolTip="https://watchroom.example.com"/><TextBlock Text="Internet rooms need a deployed HTTPS server. Localhost is for testing on this machine." Style="{StaticResource MutedText}" Margin="0,0,0,18"/><TextBlock Text="TMDB API read access token"/><PasswordBox x:Name="MetadataToken"/><TextBlock Text="Optional. Enables movie and series posters. Title searches are sent to TMDB; video files are never uploaded. The token is kept only for this app session." Style="{StaticResource MutedText}"/><CheckBox x:Name="AutoArtwork" Content="Automatically fetch confident artwork matches after scanning"/><TextBlock Text="FFmpeg executable (optional, for preparing smaller copies)" Margin="0,12,0,0"/><TextBox x:Name="FfmpegBox"/><WrapPanel><Button Content="Save settings" Style="{StaticResource Primary}" Click="SaveSettings"/><Button Content="Toggle light / dark" Click="ToggleTheme"/></WrapPanel><TextBlock Text="About Watchroom" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="Video playback by libVLC / LibVLCSharp. Peer connections by libdatachannel / DataChannelDotnet. Metadata by TMDB." Style="{StaticResource MutedText}"/><TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Preview build. Public-server deployment and two-network playback validation are required before release." Style="{StaticResource MutedText}" Margin="0,16,0,0"/></StackPanel></ScrollViewer>
   <Grid x:Name="RoomPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,15"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Host library / Guest views" Click="OpenRoomLibrary"/><Button Content="Copy invitation" Click="CopyInvite"/><Button Content="Leave" Click="LeaveRoom"/></StackPanel><StackPanel><TextBlock x:Name="RoomHeading" Text="Your watch room" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="RoomSubtitle" Text="Play a movie from your library or join a friend." Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250" x:Name="RoomSideWidth"/></Grid.ColumnDefinitions><Border Background="Black" CornerRadius="8" Margin="0,0,16,0"><vlc:VideoView x:Name="Video"/></Border><Grid Grid.Column="1" x:Name="RoomSide"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="IN THE ROOM" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,0,10"/><ListBox Grid.Row="1" x:Name="PeopleList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11"/><WrapPanel Visibility="{Binding Actions}"><Button Content="Admit" Tag="{Binding Id}" Click="Admit" Padding="8,4" Margin="0,6,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Padding="8,4" Margin="0,6,0,0"/></WrapPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2"><CheckBox x:Name="SharedControls" Content="Allow shared controls" Click="ControlsChanged"/><Button Content="Join a room" Click="JoinClick"/></StackPanel><ListBox Grid.Row="3" x:Name="ChatList" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5" MaxWidth="200"/></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" MaxLength="1000" KeyDown="ChatKey" ToolTip="Message the room" Margin="0,8,6,0"/><Button Grid.Column="1" Content="Send" Click="SendChat" Padding="10,8" Margin="0,8,0,0"/></Grid></Grid></Grid>
    <StackPanel Grid.Row="2" Margin="0,15,0,0"><Slider x:Name="Timeline" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" AutomationProperties.Name="Playback position"/><DockPanel Margin="0,5,0,10"><TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ConnectionStatus" Text="Local playback" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/></DockPanel><WrapPanel><Button x:Name="PlayButton" Content="Play" Style="{StaticResource Primary}" Click="TogglePlayback"/><Button Content="Next in queue" Click="NextQueued"/><Button Content="Fullscreen (F)" Click="Fullscreen"/><TextBlock Text="Volume" VerticalAlignment="Center" Margin="5,0,8,10"/><Slider x:Name="Volume" Width="95" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" VerticalAlignment="Center" Margin="0,0,12,10"/><ComboBox x:Name="AudioTracks" DisplayMemberPath="Name" SelectionChanged="AudioChanged" ToolTip="Audio track"/><ComboBox x:Name="SubtitleTracks" DisplayMemberPath="Name" SelectionChanged="SubtitlesChanged" ToolTip="Subtitle track"/><Button Content="Load subtitles" Click="LoadSubtitles"/><Button Content="Prepare 720p copy" Click="PrepareCopy"/></WrapPanel><TextBlock x:Name="QueueStatus" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Welcome to Watchroom" Foreground="{DynamicResource Muted}" Margin="18,7" FontSize="12" TextTrimming="CharacterEllipsis"/></Border>
 </Grid>
</Window>
