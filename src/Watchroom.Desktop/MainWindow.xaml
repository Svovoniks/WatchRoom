<Window x:Class="Watchroom.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Style="{StaticResource {x:Type Window}}" Title="Watchroom" Icon="Assets/Watchroom.ico" Width="1280" Height="850" MinWidth="900" MinHeight="640" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" Closing="WindowClosing" PreviewKeyDown="KeyPressed">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="34"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="208" x:Name="RailWidth"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Rail" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,28,16,20" LastChildFill="False">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="6,0,0,8"><Image Source="Assets/Watchroom.png" Width="32" Height="32"/><TextBlock Text="watchroom" FontSize="21" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>


     <Button x:Name="LibraryNav" Content="▦   Library" Tag="Library" Click="Navigate" Style="{StaticResource Navigation}"/>
     <Button x:Name="QueuesNav" Content="☷   Queues" Tag="Queues" Click="Navigate" Style="{StaticResource Navigation}"/>
     <Button x:Name="RoomNav" Content="▷   Watch rooms" Tag="Rooms" Click="Navigate" Style="{StaticResource Navigation}"/>
     <Button x:Name="FoldersNav" Content="＋   Folders" Tag="Folders" Click="Navigate" Style="{StaticResource Navigation}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">

     <Button x:Name="SettingsNav" Content="⚙   Settings" Tag="Settings" Click="Navigate" Style="{StaticResource Navigation}"/>
     <TextBlock Text="WATCHROOM / WINDOWS PREVIEW" Style="{StaticResource MutedText}" FontSize="9" Margin="10,12,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,18" x:Name="ContentArea">
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>

     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,0,10" HorizontalAlignment="Left" Width="480"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="126"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Search your library (Ctrl+F)" AutomationProperties.Name="Search library" VerticalContentAlignment="Center" Margin="0" Padding="8,3,30,3"/><TextBlock x:Name="SearchHint" Text="Search…" Foreground="{DynamicResource Muted}" Margin="13,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button x:Name="ClearSearchButton" Content="×" Click="ClearSearch" ToolTip="Clear search" AutomationProperties.Name="Clear search" HorizontalAlignment="Right" Width="32" Padding="4" MinHeight="0" Margin="4" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/></Grid>
      <ComboBox x:Name="Category" Grid.Column="1" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter library" Margin="0,0,12,0"><ComboBoxItem Content="All titles"/><ComboBoxItem Content="Movies"/><ComboBoxItem Content="Shows"/><ComboBoxItem Content="Anime"/><ComboBoxItem Content="Needs artwork"/><ComboBoxItem Content="Unavailable"/></ComboBox>
      <Button x:Name="RescanButton" Grid.Column="2" Content="↻  Rescan" Click="ScanClick" Margin="0" ToolTip="Check your folders for new videos"/>
     </Grid></Border>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="LibraryBack" Content="← Back" Click="LibraryBackClick" Visibility="Collapsed"/><TextBlock Grid.Column="1" x:Name="LibraryLocation" Text="All titles" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" x:Name="ResultCount" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,8,0"/></Grid>
     <Expander x:Name="SeasonInformation" Header="Season details" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock x:Name="SeasonSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,8" MaxWidth="760" HorizontalAlignment="Left"/></Expander>
    </StackPanel>
    <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="PosterGrid"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="SelectMovie" Tag="{Binding}" Style="{StaticResource PosterCard}" VerticalAlignment="Top" Width="{Binding Source, ElementName=CardArtwork, Converter={StaticResource ArtworkCardWidth}}" ContextMenuOpening="CardContextMenu" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><StackPanel><Border Background="{DynamicResource Elevated}" CornerRadius="9" ClipToBounds="True"><Grid><Grid Height="248"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=CardArtwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" Margin="0,12,0,0"/></StackPanel></Grid><Image x:Name="CardArtwork" Source="{Binding Poster}" Stretch="Uniform" ImageFailed="CardArtworkFailed"/></Grid></Border><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"><TextBlock Text="No videos" FontSize="23" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Add a folder to your library." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,15,0,22"/><Button Content="Add your first folder" Style="{StaticResource Primary}" Tag="Folders" Click="Navigate" HorizontalAlignment="Center"/></StackPanel><StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="No titles found" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Try a different title or clear your filters to see your collection." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,12,0,22"/><Button Content="Clear search and filters" Click="ResetFilters" HorizontalAlignment="Center"/></StackPanel></Grid>

<Border Grid.Row="2" x:Name="NowPlayingStrip" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Return to player →" Tag="Room" Click="Navigate" Margin="12,0,0,0"/><TextBlock x:Name="NowPlayingLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   </Grid>
   <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1100">
<Button Content="Back to library" Click="DetailBack" HorizontalAlignment="Left" Margin="0,0,0,24"/>
<Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Elevated}" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top"><Grid><Grid Height="360"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=DetailPoster}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><TextBlock Text="WATCHROOM" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Image x:Name="DetailPoster" Stretch="Uniform"/></Grid></Border>
<StackPanel Grid.Column="1" Margin="30,8,0,0"><TextBlock x:Name="DetailContext" Foreground="{DynamicResource Accent}" FontSize="15" TextWrapping="Wrap"/><TextBlock x:Name="DetailTitle" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,10"/><TextBlock x:Name="DetailMeta" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
<WrapPanel><Button x:Name="DetailPlay" Content="Play locally" Style="{StaticResource Primary}" Click="PlayLocal"/><Button x:Name="RestartButton" Content="Start over" Click="RestartLocal" Visibility="Collapsed"/><Button x:Name="DetailHost" Content="Watch together" Click="HostClick"/><Button x:Name="DetailQueue" Content="Add to queue" Click="QueueClick"/></WrapPanel>
<TextBlock Text="Overview" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,10"/><TextBlock x:Name="DetailSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
<ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed"/></StackPanel></Grid></Border>
<TextBlock Text="Media file" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/><TextBlock x:Name="DetailFile" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
<Expander Header="Artwork and matching" Foreground="{DynamicResource Muted}" Margin="0,24,0,16"><WrapPanel Margin="0,12,0,0"><Button Content="Correct title" Click="EditTitle"/><Button Content="Find artwork / fix match" Click="MatchClick"/><Button Content="Use local poster" Click="LocalPoster"/></WrapPanel></Expander>
</StackPanel></ScrollViewer>
   <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed"><StackPanel MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="Folders" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="Subfolders are included automatically." Style="{StaticResource MutedText}" Margin="0,0,0,24"/><TextBlock Text="Library folders" Style="{StaticResource SectionHeading}"/><ListBox x:Name="FolderList" SelectionChanged="FolderSelectionChanged" MinHeight="160" MaxHeight="300" AutomationProperties.Name="Library folders"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5"><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,12,0,0"><ComboBox x:Name="FolderKind" Margin="0,0,12,12" MinHeight="46" AutomationProperties.Name="Folder category" SelectedIndex="0"><ComboBoxItem Content="Mixed"/><ComboBoxItem Content="Movie"/><ComboBoxItem Content="Show"/><ComboBoxItem Content="Anime"/></ComboBox><Button x:Name="AddFolderButton" Content="Add folder" Style="{StaticResource Primary}" Click="AddFolder"/><Button x:Name="RemoveFolderButton" IsEnabled="False" Content="Remove selected" Click="RemoveFolder"/></WrapPanel><Button x:Name="ChangeFolderButton" IsEnabled="False" Content="Apply category to selected folder" Click="ChangeFolderKind" HorizontalAlignment="Left"/><Button x:Name="ScanButton" Content="Scan library" Style="{StaticResource Primary}" Click="ScanClick" HorizontalAlignment="Left"/><Button x:Name="CancelScanButton" Content="Cancel scan" Click="CancelScan" Visibility="Collapsed" HorizontalAlignment="Left"/><TextBlock x:Name="ScanStatus" Style="{StaticResource MutedText}" Margin="0,12,0,16"/><TextBlock Text="Excluded folders" Style="{StaticResource SectionHeading}"/><ListBox x:Name="ExcludedFolderList" MinHeight="80" MaxHeight="180" SelectionChanged="ExcludedSelectionChanged" AutomationProperties.Name="Excluded folders"/><WrapPanel Margin="0,12,0,0"><Button x:Name="ExcludeFolderButton" Content="Exclude folder" Click="ExcludeFolder"/><Button x:Name="RestoreFolderButton" Content="Remove exclusion" Click="RestoreFolder" IsEnabled="False"/></WrapPanel></StackPanel></ScrollViewer>
   <Grid x:Name="QueuesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

<WrapPanel Grid.Row="1"><ComboBox x:Name="QueuePicker" Width="240" DisplayMemberPath="Name" SelectionChanged="SavedQueueChanged" AutomationProperties.Name="Saved queue"/><Button Content="Create queue" Click="CreateQueue"/><Button Content="Rename" Click="RenameQueue"/><Button Content="Delete queue" Click="DeleteQueue"/><Button Content="Play queue" Click="PlaySavedQueue" Style="{StaticResource Primary}"/></WrapPanel>
<ListBox Grid.Row="2" x:Name="SavedQueueItems" DisplayMemberPath="QueueTitle" AutomationProperties.Name="Queue titles"/>
<WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button Content="Add videos" Click="AddQueueVideos"/><Button Content="Move earlier" Tag="Earlier" Click="EditQueueOrder"/><Button Content="Move later" Tag="Later" Click="EditQueueOrder"/><Button Content="Remove selected" Click="RemoveSavedItem"/><Button Content="Add from library" Tag="Library" Click="Navigate"/></WrapPanel></Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel MaxWidth="680" HorizontalAlignment="Left"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBlock Text="Profile and connection" Style="{StaticResource SectionHeading}"/><TextBlock Text="Your display name"/><TextBox x:Name="DisplayNameBox" AutomationProperties.Name="Your display name" MaxLength="40"/><TextBlock Text="Watchroom server"/><TextBox x:Name="ServerBox" AutomationProperties.Name="Room server address" ToolTip="https://watchroom.example.com"/><TextBlock Text="Internet rooms need a deployed HTTPS server. Localhost is for testing on this machine." Style="{StaticResource MutedText}" Margin="0,0,0,18"/><TextBlock Text="Artwork" Style="{StaticResource SectionHeading}"/><TextBlock Text="TMDB API read access token"/><PasswordBox x:Name="MetadataToken" AutomationProperties.Name="TMDB read access token"/><TextBlock Text="Optional. Enables movie and series artwork and overviews. Title searches are sent to TMDB; video files are never uploaded. The token is kept only for this app session." Style="{StaticResource MutedText}"/><CheckBox x:Name="AutoArtwork" Content="Automatically fetch artwork and metadata"/><Button Content="Fetch artwork and metadata" Style="{StaticResource SettingsButton}" Click="FetchArtworkClick" HorizontalAlignment="Left"/><TextBlock Text="Matched metadata determines Movie, Show, or Anime. Unmatched titles keep their filename-based category. Without a token, Watchroom uses TVmaze and Wikipedia. Some titles may need a manual match. Title searches are sent to these providers; videos stay on your computer." Style="{StaticResource MutedText}"/><TextBlock Text="Playback" Style="{StaticResource SectionHeading}"/><TextBlock Text="FFmpeg executable (optional, for preparing smaller copies)" Margin="0,12,0,0"/><TextBox x:Name="FfmpegBox" AutomationProperties.Name="FFmpeg executable path"/><WrapPanel Margin="0,12,0,0"><Button Content="Save settings" Style="{StaticResource SettingsPrimary}" Click="SaveSettings"/><Button Content="Toggle light / dark" Style="{StaticResource SettingsButton}" Click="ToggleTheme"/></WrapPanel><TextBlock Text="About Watchroom" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="Video playback by libVLC / LibVLCSharp. Peer connections by libdatachannel / DataChannelDotnet. Artwork by TVmaze (https://www.tvmaze.com, CC BY-SA), Wikipedia, and optional TMDB. Source pages appear in title details." Style="{StaticResource MutedText}"/><TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Preview build. Public-server deployment and two-network playback validation are required before release." Style="{StaticResource MutedText}" Margin="0,16,0,0"/></StackPanel></ScrollViewer>
   <Grid x:Name="RoomsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="Create room" Click="CreatePersistentRoom" Style="{StaticResource Primary}"/><Button Content="Save invitation" Click="SaveRoomInvitation"/><Button x:Name="ReturnToRoomButton" Content="Return to player" Tag="Room" Click="Navigate"/></WrapPanel>
<ListBox Grid.Row="1" x:Name="SavedRoomsList" SelectionChanged="SavedRoomSelectionChanged" AutomationProperties.Name="Saved watch rooms"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="ConnectSavedRoomButton" Content="Connect" Click="ConnectSavedRoom" Style="{StaticResource Primary}"/><Button x:Name="RenameSavedRoomButton" Content="Rename" Click="RenameSavedRoom"/><Button x:Name="ForgetSavedRoomButton" Content="Remove saved room" Click="ForgetSavedRoom"/><Button x:Name="CopySavedInviteButton" Content="Copy invitation" Click="CopySavedInvitation"/></WrapPanel></Grid>
   <Grid x:Name="RoomPage" Visibility="Collapsed" Background="#101112">
    <Grid.Resources>
     <SolidColorBrush x:Key="Surface" Color="#222426"/><SolidColorBrush x:Key="Elevated" Color="#303236"/><SolidColorBrush x:Key="Ink" Color="#F3F3F3"/><SolidColorBrush x:Key="Muted" Color="#AFB2B8"/><SolidColorBrush x:Key="Line" Color="#42454A"/><SolidColorBrush x:Key="Accent" Color="#F3A44B"/>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="RoomHeader" Background="#222426" BorderBrush="#3C3E42" BorderThickness="0,0,0,1" Padding="12,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="←  Library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RoomHeading" Text="Watchroom player" Foreground="#F3F3F3" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RoomSubtitle" Text="Choose a video from your library to start watching." Foreground="#AFB2B8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"><Button x:Name="RoomToggle" Content="Room &amp; chat" Click="ToggleRoomPanel" Style="{StaticResource PlayerButton}" ToolTip="Show or hide participants and chat"/><Button x:Name="InviteButton" Content="Copy invite" Click="CopyInvite" Style="{StaticResource PlayerButton}"/><Button x:Name="LeaveButton" Content="Leave" Click="LeaveRoom" Style="{StaticResource PlayerButton}"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0" x:Name="RoomSideWidth"/></Grid.ColumnDefinitions>
     <Border x:Name="VideoFrame" Background="Black">
      <vlc:VideoView x:Name="Video">
       <!-- A nonzero alpha keeps the native overlay hit-testable over the video. -->
       <Grid x:Name="PlayerOverlay" Background="#01000000" Focusable="True" MouseMove="PlayerMouseMoved" MouseLeftButtonDown="VideoClicked" PreviewKeyDown="KeyPressed">
        <Border x:Name="PlayerEmpty" Background="Black"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▶" FontSize="52" Foreground="#F3A44B" HorizontalAlignment="Center"/><TextBlock Text="Ready when you are" FontSize="24" Foreground="#EEEEEE" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="Choose a video, or join a friend’s room." Foreground="#AFB2B8" HorizontalAlignment="Center" Margin="0,0,0,20"/><Button Content="Browse library" Tag="Library" Click="Navigate" Style="{StaticResource PlayerButton}" HorizontalAlignment="Center"/></StackPanel></Viewbox></Border>
        <Border x:Name="FullscreenHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0" Background="#DC222426" CornerRadius="6" Padding="18,10"><TextBlock Text="Fullscreen · Esc to exit · Move the mouse for controls" Foreground="#EEEEEE" FontSize="13"/></Border>
        <Grid x:Name="FullscreenControlsHost" VerticalAlignment="Bottom"/>
       </Grid>
      </vlc:VideoView>
     </Border>
     <Grid Grid.Column="1" x:Name="RoomSide" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="IN THE ROOM" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,0,10"/><ListBox Grid.Row="1" x:Name="PeopleList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11"/><WrapPanel Visibility="{Binding Actions}"><Button Content="Admit" Tag="{Binding Id}" Click="Admit" Margin="0,6,6,0"/><Button Content="Remove" Tag="{Binding Id}" Click="RemovePeer" Margin="0,6,0,0"/></WrapPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2"><CheckBox x:Name="SharedControls" Content="Allow shared controls" Click="ControlsChanged"/><Button Content="Join a room" Click="JoinClick"/></StackPanel><ListBox Grid.Row="3" x:Name="ChatList" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5" MaxWidth="200"/></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" MaxLength="1000" KeyDown="ChatKey" ToolTip="Message the room" Margin="0,8,6,0"/><Button Grid.Column="1" x:Name="SendChatButton" Content="Send" Click="SendChat" Margin="0,8,0,0"/></Grid></Grid>
    </Grid>
    <Grid x:Name="DockedControlsHost" Grid.Row="2">
     <Border x:Name="PlaybackControls" Background="#F5222426" BorderBrush="#42454A" BorderThickness="0,1,0,0" Padding="14,8,14,10" PreviewMouseMove="ControlsMouseMoved" PreviewKeyDown="ControlsKeyPressed">
      <Border.Resources><SolidColorBrush x:Key="Surface" Color="#222426"/><SolidColorBrush x:Key="Elevated" Color="#303236"/><SolidColorBrush x:Key="Ink" Color="#F3F3F3"/><SolidColorBrush x:Key="Muted" Color="#AFB2B8"/><SolidColorBrush x:Key="Line" Color="#42454A"/><SolidColorBrush x:Key="Accent" Color="#F3A44B"/></Border.Resources>
      <StackPanel>
       <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="Timeline" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewMouseMove="SeekMoved" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyStarted" PreviewKeyUp="SeekKeyFinished" AutomationProperties.Name="Playback position"/><TextBlock Grid.Column="1" x:Name="PlaybackTime" Text="00:00 / 00:00" Foreground="#D7D9DC" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" Margin="16,0,0,0"/></Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶" Click="TogglePlayback" Style="{StaticResource PlayerIconButton}" FontSize="22"  BorderBrush="#F3A44B" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause"/><Button x:Name="StopButton" Content="■" Click="StopPlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Stop (S)" AutomationProperties.Name="Stop playback"/><Border Width="1" Background="#42454A" Margin="6,5,12,5"/><Button x:Name="BackwardButton" Content="−10" Click="SkipBackward" Style="{StaticResource PlayerIconButton}" ToolTip="Back 10 seconds (Left)" AutomationProperties.Name="Back 10 seconds"/><Button x:Name="ForwardButton" Content="+10" Click="SkipForward" Style="{StaticResource PlayerIconButton}" ToolTip="Forward 10 seconds (Right)" AutomationProperties.Name="Forward 10 seconds"/><Button x:Name="PreviousButton" Content="|◀" Click="PreviousQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Previous video (P)" AutomationProperties.Name="Previous video"/><Button x:Name="NextButton" Content="▶|" Click="NextQueued" Style="{StaticResource PlayerIconButton}" ToolTip="Next in queue (N)" AutomationProperties.Name="Next in queue"/></StackPanel>
        <TextBlock Grid.Column="1" x:Name="ConnectionStatus" Text="Local playback" Foreground="#AFB2B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="14,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="OptionsButton" Content="Playback options" Click="TogglePlayerOptions" Style="{StaticResource PlayerButton}" ToolTip="Audio, subtitles, quality and queue"/><Button x:Name="MuteButton" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Click="MutePlayback" Style="{StaticResource PlayerIconButton}" ToolTip="Mute (M)" AutomationProperties.Name="Mute"/><Slider x:Name="Volume" Style="{StaticResource PlayerSlider}" Width="90" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" AutomationProperties.Name="Volume" Margin="4,0,8,0"/><TextBlock x:Name="VolumeText" Text="80%" Foreground="#D7D9DC" Width="38" VerticalAlignment="Center" FontSize="12"/><Button x:Name="FullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="18" Click="Fullscreen" Style="{StaticResource PlayerIconButton}" ToolTip="Fullscreen (F or double-click video)" AutomationProperties.Name="Fullscreen"/></StackPanel>
       </Grid>
       <Border x:Name="PlayerOptions" Visibility="Collapsed" BorderBrush="#42454A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0"><StackPanel><WrapPanel><TextBlock Text="Audio" Foreground="#D7D9DC" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="AudioTracks" MaxWidth="260" DisplayMemberPath="Name" SelectionChanged="AudioChanged" ToolTip="Audio track" AutomationProperties.Name="Audio track"/><TextBlock Text="Subtitles" Foreground="#D7D9DC" VerticalAlignment="Center" Margin="8,0,8,6"/><ComboBox x:Name="SubtitleTracks" MaxWidth="260" DisplayMemberPath="Name" SelectionChanged="SubtitlesChanged" ToolTip="Subtitle track" AutomationProperties.Name="Subtitle track"/><Button x:Name="LoadSubtitlesButton" Content="Load subtitles…" Click="LoadSubtitles" Style="{StaticResource PlayerButton}"/><Button x:Name="PrepareButton" Content="Prepare 720p copy" Click="PrepareCopy" Style="{StaticResource PlayerButton}"/></WrapPanel><TextBlock x:Name="TrackSummary" Foreground="#AFB2B8" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8"/><WrapPanel><ComboBox x:Name="PlayerQueuePicker" Width="220" DisplayMemberPath="Name" SelectionChanged="PlayerQueueChanged" AutomationProperties.Name="Player queue"/><Button Content="Play queue" Click="PlayPlayerQueue" Style="{StaticResource PlayerButton}"/><Button Content="Manage queues" Tag="Queues" Click="Navigate" Style="{StaticResource PlayerButton}"/></WrapPanel><TextBlock Text="Queue" Foreground="#D7D9DC" FontWeight="SemiBold" Margin="0,0,0,6"/><ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" MaxHeight="120" DisplayMemberPath="QueueTitle" AutomationProperties.Name="Playback queue"/><WrapPanel><Button x:Name="QueueEarlier" Content="Move earlier" Tag="Earlier" Click="MoveQueued" Style="{StaticResource PlayerButton}"/><Button x:Name="QueueLater" Content="Move later" Tag="Later" Click="MoveQueued" Style="{StaticResource PlayerButton}"/><Button x:Name="RemoveQueueButton" Content="Remove selected from queue" Click="RemoveQueued" Style="{StaticResource PlayerButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/></WrapPanel><TextBlock x:Name="QueueStatus" Text="Queue is empty. Add titles from the library." Foreground="#AFB2B8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="AppStatusBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel><ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="90" Height="3" Margin="18,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="StatusText" Text="Welcome to Watchroom" Foreground="{DynamicResource Muted}" Margin="18,7" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
 </Grid>
</Window>
