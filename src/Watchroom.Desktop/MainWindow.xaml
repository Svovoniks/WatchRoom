<Window x:Class="Watchroom.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Watchroom.Desktop" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Style="{StaticResource {x:Type Window}}" Title="Watchroom" Icon="Assets/Watchroom.ico" Width="1280" Height="850" MinWidth="900" MinHeight="640" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" Closing="WindowClosing" PreviewKeyDown="KeyPressed">
 <Grid Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="30"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="212" x:Name="RailWidth"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <Border x:Name="Rail" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="12,18,12,12" LastChildFill="False">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="10,0,0,24"><Image Source="Assets/Watchroom.png" Width="26" Height="26"/><TextBlock Text="watchroom" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"/></StackPanel>
     <Button x:Name="HomeNav" Tag="Home" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Home"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Home"/></StackPanel></Button>
     <Button x:Name="LibraryNav" Tag="Library" Click="LibraryMenuClick" Style="{StaticResource Navigation}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Library" AutomationProperties.HelpText="Expand or collapse library categories">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Library"/></StackPanel><TextBlock x:Name="LibraryChevron" Grid.Column="1" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid>
     </Button>
     <StackPanel x:Name="LibraryCategories" Margin="0,0,0,6">
      <Button x:Name="AllLibraryNav" Content="All" Tag="0" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="AnimeLibraryNav" Content="Anime" Tag="3" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="ShowsLibraryNav" Content="Shows" Tag="2" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="MoviesLibraryNav" Content="Movies" Tag="1" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}"/>
      <Button x:Name="UnavailableLibraryNav" Content="Unavailable" Tag="4" Click="LibraryCategoryClick" Style="{StaticResource LibrarySubNavigation}" Visibility="Collapsed"/>
     </StackPanel>
     <Button x:Name="QueuesNav" Tag="Queues" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Queues"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Queues"/></StackPanel></Button>
     <Button x:Name="RoomNav" Tag="Rooms" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Watch rooms"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Watch rooms"/></StackPanel></Button>
     <Button x:Name="FoldersNav" Tag="Folders" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Folders"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Folders"/></StackPanel></Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Button Tag="Room" Click="Navigate" Visibility="{Binding Visibility, ElementName=NowPlayingStrip}" Background="{DynamicResource AccentSoft}" HorizontalContentAlignment="Stretch" Padding="12,10" Margin="0,0,0,8" ToolTip="Return to the current video" AutomationProperties.Name="Return to player">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Accent}" VerticalAlignment="Center"><TextBlock Text="&#xF5B0;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" Margin="2,0,0,0"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Return to player" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Text, ElementName=NowPlayingLabel}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
      </Grid>
     </Button>
     <Button x:Name="SettingsNav" Tag="Settings" Click="Navigate" Style="{StaticResource Navigation}" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Settings"/></StackPanel></Button>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Blurred artwork behind title details: spans the whole content column and fades downward. -->
  <!-- Pre-blurred artwork and a canvas-coloured fade keep this layer free of per-repaint effects and masks. -->
  <Grid Grid.Column="1" Height="560" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=Details}">
   <Image Source="{Binding Source, ElementName=DetailPoster, Converter={StaticResource DetailBackdrop}}" Stretch="UniformToFill" Margin="-90" RenderOptions.BitmapScalingMode="Linear"/>
   <Rectangle Fill="{DynamicResource BackdropFade}"/>
  </Grid>
  <Grid Grid.Column="1" Margin="28,22,28,16" x:Name="ContentArea">

   <!-- Home -->
   <ScrollViewer x:Name="HomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ScrollViewer.Resources>
     <DataTemplate x:Key="HomePoster">
      <Button Click="OpenHomeCard" Tag="{Binding Card}" Style="{StaticResource PosterCard}" Width="180" Height="306" Margin="0,0,12,8" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}">
       <StackPanel>
        <Border Height="216" Style="{StaticResource ArtworkFrame}">
         <Grid><TextBlock Text="{Binding DisplayTitle}" Margin="14" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><Image Source="{Binding Poster}" Stretch="UniformToFill" Loaded="HomeArtworkLoaded"/></Grid>
        </Border>
        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,10,2,3"/>
        <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="2,0"/>
        <ProgressBar Height="3" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="2,8,2,0" Style="{StaticResource CardProgress}"/>
        <TextBlock Text="{Binding PlaybackLabel}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,5,2,0"/>
       </StackPanel>
      </Button>
     </DataTemplate>
     <Style x:Key="HomeRow" TargetType="ItemsControl"><Setter Property="ItemTemplate" Value="{StaticResource HomePoster}"/><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter></Style>
    </ScrollViewer.Resources>
    <StackPanel Margin="0,0,8,0">
     <DockPanel Margin="0,0,0,22"><Button DockPanel.Dock="Right" Content="Refresh picks" Click="RefreshHomePicks" Style="{StaticResource QuietButton}" ContentTemplate="{StaticResource RefreshContent}" VerticalAlignment="Center" Margin="0"/><StackPanel><TextBlock Text="Home" Style="{StaticResource PageHeading}"/><TextBlock Text="Pick up where you left off, or find something new." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <TextBlock x:Name="HomeStatus" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <TextBlock Text="Continue watching" Style="{StaticResource RowHeading}"/>
     <TextBlock x:Name="HomeContinueEmpty" Text="Your unfinished movies and shows will appear here once you start watching." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-6,0,0,0"><ItemsControl x:Name="HomeContinue" Style="{StaticResource HomeRow}"/></ScrollViewer>
     <Button x:Name="HomeMystery" Click="PickMystery" HorizontalContentAlignment="Stretch" Padding="20,18" Margin="0,18,0,30" Background="{DynamicResource AccentSoft}" AutomationProperties.Name="Mystery pick: choose a random movie, show, or anime">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock Text="Surprise me" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="8,1,0,0"/></StackPanel>
       <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Accent}" Margin="0,0,18,0"><TextBlock Text="&#xE8B1;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/></Border>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Mystery pick" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Can't decide? Let Watchroom choose a random title from your library." Style="{StaticResource MutedText}" Margin="0,3,0,0"/></StackPanel>
      </DockPanel>
     </Button>
     <TextBlock Text="Suggestions" Style="{StaticResource RowHeading}"/>
     <TextBlock x:Name="HomeSuggestionsEmpty" Text="No new titles to suggest. Try a mystery pick or browse your library." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
     <ItemsControl x:Name="HomeSuggestions" ItemTemplate="{StaticResource HomePoster}" Margin="-6,0,0,0" AutomationProperties.Name="Suggestions"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    </StackPanel>
   </ScrollViewer>

   <!-- Library -->
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="LocalLibraryHeader"><TextBlock x:Name="GuestLibraryStatus" Visibility="Collapsed" Style="{StaticResource MutedText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
     <Border x:Name="HostLibraryActivity" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,6" Margin="0,0,0,12">
      <DockPanel><Button x:Name="BrowseWithGuestButton" DockPanel.Dock="Right" Click="BrowseWithGuest" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed"/><Button DockPanel.Dock="Right" Content="Permissions" Click="OpenLibraryPermissions" Padding="12,0" Margin="8,0,0,0"/><TextBlock Text="&#xE716;" DockPanel.Dock="Left" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock x:Name="HostLibraryActivityText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel>
     </Border>
     <Grid x:Name="LibraryToolbar" Height="40" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="SearchFrame" MouseLeftButtonDown="SearchFrameClick" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="10" Padding="14,0,8,0" HorizontalAlignment="Stretch" Cursor="IBeam">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" IsHitTestVisible="False"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" MinHeight="0" TextChanged="SearchChanged" ToolTip="Search your library (Ctrl+F)" AutomationProperties.Name="Search library" VerticalContentAlignment="Center" Margin="0" Padding="0" Background="Transparent" BorderThickness="0">
         <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></TextBox.Template>
        </TextBox>
        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search your library" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Elevated}" CornerRadius="5" Padding="6,2" Margin="0,0,2,0" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Muted}"/></Border>
        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="&#xE711;" Click="ClearSearch" ToolTip="Clear search" AutomationProperties.Name="Clear search" Style="{StaticResource QuietIcon}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" MinHeight="0" Margin="0" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <ComboBox x:Name="LibraryStatusFilter" Grid.Column="1" Width="180" Height="40" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter library" ToolTip="Filter by artwork or watch progress" Margin="10,0,10,0"><ComboBoxItem Content="All watch states"/><ComboBoxItem Content="Needs artwork"/><ComboBoxItem Content="Continue watching"/><ComboBoxItem Content="Unwatched"/><ComboBoxItem Content="Watched"/></ComboBox>
      <Button x:Name="RescanButton" Grid.Column="2" Width="112" Height="40" MinHeight="0" Padding="12,0" Content="Rescan" Click="ScanClick" Margin="0" ToolTip="Check your folders for new videos"/>
     </Grid>
     <Grid Margin="-8,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ItemsControl x:Name="LibraryBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Library location"/><TextBlock Grid.Column="1" x:Name="ResultCount" Width="100" TextAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0"/></Grid>
     <Expander x:Name="SeasonInformation" Foreground="{DynamicResource Muted}" Header="Season details" Visibility="Collapsed" Margin="-6,0,0,10"><TextBlock x:Name="SeasonSummary" Style="{StaticResource MutedText}" Margin="0,8,0,8" MaxWidth="760" HorizontalAlignment="Left"/></Expander>
    </StackPanel>
    <Grid x:Name="LocalLibraryContent" Grid.Row="1" Margin="-6,0,0,0"><ItemsControl x:Name="PosterGrid" PreviewMouseWheel="HostLibraryScrollInput" PreviewTouchDown="HostLibraryTouchInput" VirtualizingPanel.ScrollUnit="Pixel"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="LibraryScroll" PreviewMouseLeftButtonDown="HostLibraryPointerInput" ScrollChanged="LibraryScrollChanged" CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:VirtualizingLibraryPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid>
      <Border Panel.ZIndex="1" IsHitTestVisible="False" BorderBrush="{DynamicResource Accent}" BorderThickness="3" CornerRadius="12" Margin="0,0,14,18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGuestHovered}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
      <Button Click="SelectMovie" MouseEnter="LibraryCardHoverEnter" MouseLeave="LibraryCardHoverLeave" Tag="{Binding Card}" Style="{StaticResource PosterCard}" VerticalAlignment="Top" ContextMenuOpening="CardContextMenu" ToolTip="{Binding DisplayTitle}" AutomationProperties.Name="{Binding DisplayTitle}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu>
       <StackPanel>
        <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ArtworkFrame}"><Setter Property="Height" Value="248"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Height" Value="162"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <Grid>
          <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=CardArtwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel VerticalAlignment="Center" Margin="14,0"><TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Grid>
          <Image x:Name="CardArtwork" Source="{Binding Poster, NotifyOnTargetUpdated=True}" ImageFailed="CardArtworkFailed" Loaded="CardArtworkLoaded" TargetUpdated="CardArtworkUpdated"><Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Stretch" Value="Uniform"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
          <Border VerticalAlignment="Bottom" Padding="10,22,10,9" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#E0000000" Offset="0.55"/></LinearGradientBrush></Border.Background><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMovie}" Value="True"/><Condition Binding="{Binding HasPlaybackProgress}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding PlaybackLabel}" Foreground="#F4F4F7" FontSize="12" FontWeight="SemiBold"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Background="#40FFFFFF" Margin="0,6,0,0"/></StackPanel></Border>
         </Grid>
        </Border>
        <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="2,10,2,3"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="MaxHeight" Value="40"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Caption}"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Text" Value="{Binding EpisodeMeta}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <StackPanel Margin="2,7,2,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEpisode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><ProgressBar Height="3" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource CardProgress}"/><TextBlock Text="{Binding PlaybackLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
       </StackPanel>
      </Button>
      <Button Click="ToggleCardWatched"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CardWatchedButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRemote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}" Margin="0,0,0,22"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><TextBlock Text="Your library starts here" FontWeight="SemiBold" FontSize="24" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Add a video folder to discover movies and shows. Your files stay where they are." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,24"/><WrapPanel HorizontalAlignment="Center"><Button Content="Add folder" Style="{StaticResource Primary}" ContentTemplate="{StaticResource AddContent}" Tag="Folders" Click="Navigate"/><Button Content="Join a friend" ContentTemplate="{StaticResource PeopleContent}" Click="JoinFromWelcome" Margin="0,0,0,8"/></WrapPanel></StackPanel>
     <StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}" Foreground="{DynamicResource Muted}"/><TextBlock Text="No titles found" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Try another search or clear your filters." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,22"/><Button Content="Clear search and filters" Click="ResetFilters" HorizontalAlignment="Center" Margin="0"/></StackPanel></Grid>
    <Border Grid.Row="2" x:Name="NowPlayingStrip" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Return to player" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Tag="Room" Click="Navigate" Margin="12,0,0,0"/><TextBlock Text="&#xE714;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="2,0,12,0"/><TextBlock x:Name="NowPlayingLabel" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   </Grid>

   <!-- Title details -->
   <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
    <StackPanel MaxWidth="1100" Margin="0,0,8,0">
     <DockPanel Margin="-8,0,0,24"><Button DockPanel.Dock="Right" Content="{Binding Content, ElementName=BrowseWithGuestButton}" Visibility="{Binding Visibility, ElementName=BrowseWithGuestButton}" Click="BrowseWithGuest" Margin="12,0,0,0"/><ItemsControl x:Name="DetailBreadcrumbs" Button.Click="BreadcrumbClick" Style="{StaticResource LibraryBreadcrumbs}" AutomationProperties.Name="Video location"/></DockPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- Layered translucent frames approximate CardShadow without re-running a blur effect while the page scrolls. -->
      <Grid VerticalAlignment="Top">
      <Border Margin="-9,-3,-9,-15" CornerRadius="21" Background="#0A000000" IsHitTestVisible="False"/>
      <Border Margin="-6,-1,-6,-11" CornerRadius="18" Background="#0F000000" IsHitTestVisible="False"/>
      <Border Margin="-3,1,-3,-7" CornerRadius="15" Background="#14000000" IsHitTestVisible="False"/>
      <Border Margin="-1,3,-1,-4" CornerRadius="13" Background="#1A000000" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource Elevated}" CornerRadius="12">
       <Border CornerRadius="12" local:RoundedClip.Radius="12">
        <Grid><Grid Width="230" Height="340"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=DetailPoster}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="190" Margin="16"><TextBlock Text="&#xE714;" Style="{StaticResource EmptyStateIcon}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Text, ElementName=DetailTitle}" FontSize="19" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/></StackPanel></Grid><Image x:Name="DetailPoster" Stretch="Uniform" MaxWidth="400" MaxHeight="345"/></Grid>
       </Border>
      </Border>
      </Grid>
      <StackPanel Grid.Column="1" Margin="32,6,0,0">
       <TextBlock x:Name="DetailContext" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock x:Name="DetailTitle" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <TextBlock x:Name="DetailMeta" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,24"/>
       <WrapPanel><Button x:Name="DetailPlay" Content="Play locally" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="20,8" Click="PlayLocal"/><Button x:Name="RestartButton" Content="Start over" Click="RestartLocal" Visibility="Collapsed"/><Button x:Name="DetailHost" Content="Watch together" ContentTemplate="{StaticResource PeopleContent}" Click="HostClick"/><Button x:Name="DetailQueue" Content="Add to queue" ContentTemplate="{StaticResource AddContent}" Click="QueueClick"/><Button x:Name="DetailRemove" Content="Remove from library" Click="RemoveUnavailableVideo" Visibility="Collapsed" ToolTip="Remove the saved entry for this unavailable video"/></WrapPanel>
       <TextBlock x:Name="DetailAvailability" Visibility="Collapsed" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="DetailSummary" Margin="0,16,0,0" Style="{StaticResource MutedText}" FontSize="15" LineHeight="24" MaxWidth="720" HorizontalAlignment="Left"/>
       <ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      </StackPanel>
     </Grid>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,32,0,16" Padding="0,12,0,0">
      <StackPanel Margin="-6,0,0,0">
       <Expander Header="File location" Foreground="{DynamicResource Muted}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DetailFile}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><TextBox x:Name="DetailFile" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,4" AutomationProperties.Name="Video file location" ToolTip="Select and copy the file location"/></Expander>
       <Expander Header="Artwork and matching" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"><WrapPanel Margin="0,10,0,0"><Button Content="Correct title" Click="EditTitle"/><Button Content="Find artwork / fix match" Click="MatchClick"/><Button Content="Use local poster" Click="LocalPoster"/></WrapPanel></Expander>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid></ScrollViewer>

   <!-- First launch -->
   <ScrollViewer x:Name="WelcomePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
     <Image Source="Assets/Watchroom.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,24"/><TextBlock Text="Welcome to Watchroom" FontSize="34" FontWeight="Bold" TextAlignment="Center"/>
     <TextBlock Text="Add your videos or join a friend. Only the host needs the files." Style="{StaticResource MutedText}" FontSize="15" TextAlignment="Center" Margin="0,10,0,28"/>
     <WrapPanel HorizontalAlignment="Center"><Button Content="Add folder" Tag="Folders" Click="Navigate" Style="{StaticResource Primary}" ContentTemplate="{StaticResource AddContent}" Padding="20,8"/><Button Content="Join a friend" Click="JoinFromWelcome" ContentTemplate="{StaticResource PeopleContent}" Padding="20,8" Margin="0,0,0,8"/></WrapPanel>
    </StackPanel>
   </ScrollViewer>

   <!-- Folders -->
   <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="860" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0">
     <DockPanel Margin="0,0,0,20"><Button x:Name="AddFolderButton" DockPanel.Dock="Right" Content="Add folder" Style="{StaticResource Primary}" ContentTemplate="{StaticResource AddContent}" Click="AddFolder" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Includes subfolders. Select an added folder to change its category."/><StackPanel><TextBlock Text="Folders" Style="{StaticResource PageHeading}"/><TextBlock Text="Watchroom scans these folders and their subfolders. Your files stay where they are." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Library folders" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
       <Grid>
        <ListBox x:Name="FolderList" SelectionChanged="FolderSelectionChanged" MinHeight="110" MaxHeight="260" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Library folders" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
         <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2,2"><Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Elevated}" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="No folders yet. Add a folder to discover your videos." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=FolderList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
       <StackPanel x:Name="FolderEditor" Visibility="Collapsed" Margin="0,14,0,0">
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
         <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Category" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FolderKind" Width="160" Margin="0,6,0,8" AutomationProperties.Name="Folder category" SelectedIndex="0"><ComboBoxItem Content="Mixed"/><ComboBoxItem Content="Movie"/><ComboBoxItem Content="Show"/><ComboBoxItem Content="Anime"/></ComboBox></StackPanel>
          <Button x:Name="ChangeFolderButton" Content="Apply category" Click="ChangeFolderKind" IsEnabled="False" VerticalAlignment="Bottom"/>
          <Button x:Name="RemoveFolderButton" Content="Remove folder" Style="{StaticResource QuietButton}" Click="RemoveFolder" IsEnabled="False" VerticalAlignment="Bottom"/>
         </WrapPanel>
        </Border>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="ScanButton" Content="Scan library" ContentTemplate="{StaticResource RefreshContent}" Click="ScanClick" Margin="8,0,0,0"/><Button x:Name="CancelScanButton" Content="Cancel scan" Click="CancelScan" Visibility="Collapsed" Margin="8,0,0,0"/></WrapPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="Scanning" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ScanStatus" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Excluded folders" Style="{StaticResource FieldLabel}"/>
       <TextBlock Text="Subfolders listed here are skipped during scans." Style="{StaticResource MutedText}" Margin="0,2,0,10"/>
       <Grid><ListBox x:Name="ExcludedFolderList" MinHeight="56" MaxHeight="180" SelectionChanged="ExcludedSelectionChanged" AutomationProperties.Name="Excluded folders" Background="{DynamicResource Canvas}"/><TextBlock Text="No exclusions. All subfolders are included." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ExcludedFolderList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
       <WrapPanel Margin="0,12,0,-8"><Button x:Name="ExcludeFolderButton" Content="Exclude folder" Click="ExcludeFolder"/><Button x:Name="RestoreFolderButton" Content="Remove exclusion" Style="{StaticResource QuietButton}" Click="RestoreFolder" IsEnabled="False"/></WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel></Grid>
   </ScrollViewer>

   <!-- Queues -->
   <Grid x:Name="QueuesPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Create queue" Click="CreateQueue" ContentTemplate="{StaticResource AddContent}" VerticalAlignment="Center" Style="{StaticResource Primary}" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Queues" Style="{StaticResource PageHeading}"/><TextBlock Text="Line up movies and episodes to play back to back." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ListBox Grid.Row="1" x:Name="QueuePicker" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="SavedQueueChanged" AutomationProperties.Name="Saved queues" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}, {1} videos"><Binding Path="Name"/><Binding Path="MediaIds.Length"/></MultiBinding></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,4"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaIds.Length, StringFormat={}{0} videos}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,20,22,10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="QueueDetailTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="QueueDetailCaption" Style="{StaticResource MutedText}" Margin="0,4,0,14"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,0,10"><WrapPanel><Button x:Name="PlaySavedQueueButton" Content="Play queue" Click="PlaySavedQueue" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="PlaySelectedSavedQueueButton" Content="Play selected" Click="PlaySelectedSavedQueue" IsEnabled="False"/><Button x:Name="AddQueueVideosButton" Content="Add videos" Click="AddQueueVideos"/></WrapPanel><TextBlock x:Name="SavedQueueFeedback" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
       <Grid Grid.Row="2">
        <ListBox x:Name="SavedQueueItems" SelectionChanged="SavedQueueSelectionChanged" MouseDoubleClick="QueueItemDoubleClicked" PreviewKeyDown="QueueItemKeyDown" AutomationProperties.Name="Queue videos" AutomationProperties.HelpText="Select a video and choose Play selected, double-click it, or press Enter to play from that point in the queue." Background="Transparent" BorderThickness="0" Padding="0" AllowDrop="True" PreviewMouseMove="QueueDragMove" PreviewDragOver="QueueDragOver" DragLeave="QueueDragLeave" PreviewDrop="QueueDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder" PreviewMouseLeftButtonDown="QueueDragDown"><TextBlock Text="&#xE700;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}"/></Border>
          <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,2,12,2"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
          <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource QuietIcon}" FontSize="12" Width="36" Height="36" Margin="0" VerticalAlignment="Center" Tag="{Binding}" Click="RemoveSavedItem" ToolTip="Remove from queue" AutomationProperties.Name="Remove video from queue"/>
         </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="QueueEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Margin="16"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SavedQueueItems}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE8FD;" Style="{StaticResource EmptyStateIcon}"/><TextBlock Text="Nothing queued yet" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Add movies or episodes from your library, then arrange them in the order you want to watch." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel><Border x:Name="QueueDropMarker" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
       </Grid>
       <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0"><WrapPanel><Button x:Name="SavedQueueEarlier" Content="&#xE70E;" Style="{StaticResource IconButton}" FontSize="12" ToolTip="Move earlier" AutomationProperties.Name="Move earlier" Tag="Earlier" Click="EditQueueOrder" IsEnabled="False"/><Button x:Name="SavedQueueLater" Content="&#xE70D;" Style="{StaticResource IconButton}" FontSize="12" ToolTip="Move later" AutomationProperties.Name="Move later" Tag="Later" Click="EditQueueOrder" IsEnabled="False"/><Button Content="Rename" Style="{StaticResource QuietButton}" Click="RenameQueue"/><Button Content="Delete queue" Style="{StaticResource QuietButton}" Click="DeleteQueue"/></WrapPanel></Border>
      </Grid>
     </Border>
    </Grid>
   </Grid>

   <!-- Settings -->
   <Grid x:Name="SettingsPage" Visibility="Collapsed">
    <Grid.Resources>
     <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/><Setter Property="Margin" Value="0,0,0,8"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
     <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
     <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageHeading}" Margin="0,0,0,16"/>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,20">
      <WrapPanel x:Name="PreferenceSections">
       <Button Content="Profile" Tag="Profile" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Metadata" Tag="Metadata" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Playback" Tag="Playback" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Appearance" Tag="Appearance" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
       <Button Content="Updates &amp; about" Tag="Updates" Click="PreferenceSectionClicked" Style="{StaticResource PreferenceTab}"/>
      </WrapPanel>
     </Border>
    </StackPanel>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="ProfilePreferences" Tag="Profile" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Your display name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DisplayNameBox" AutomationProperties.Name="Your display name" MaxLength="40"/>
       <TextBlock x:Name="DisplayNameError" Style="{StaticResource FieldError}"/>
       <TextBlock Text="Shown to everyone in your watch rooms." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Watchroom server" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ServerBox" AutomationProperties.Name="Room server address"/>
       <TextBlock x:Name="ServerError" Style="{StaticResource FieldError}"/>
       <TextBlock Text="Change the server only if you host your own." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="MetadataPreferences" Tag="Metadata" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Sources" Style="{StaticResource CardTitle}"/>
       <CheckBox x:Name="AutoArtwork" Content="Automatically fetch artwork and metadata"/>
       <TextBlock Text="Providers · in priority order" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
       <ListBox x:Name="MetadataProviders" AutomationProperties.Name="Metadata provider order" Background="{DynamicResource Canvas}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Padding" Value="8,4"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="&#xE70E;" Tag="Up" Click="ProviderMoved" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}" Style="{StaticResource QuietIcon}" FontSize="11" Width="32" Height="32" MinHeight="32" Margin="4,0,0,0"/>
         <Button Content="&#xE70D;" Tag="Down" Click="ProviderMoved" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}" Style="{StaticResource QuietIcon}" FontSize="11" Width="32" Height="32" MinHeight="32" Margin="4,0,0,0"/>
        </StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="PreferencesChanged" Margin="0" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="Providers receive title searches, never video files. Disable all to use local metadata." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Region" Style="{StaticResource CardTitle}"/>
       <WrapPanel><StackPanel Width="270" Margin="0,0,16,0"><TextBlock Text="Language" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MetadataLanguage" AutomationProperties.Name="Metadata language" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Margin="0,6,0,8"/></StackPanel><StackPanel Width="270"><TextBlock Text="Country" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MetadataCountry" AutomationProperties.Name="Metadata country" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Margin="0,6,0,8"/></StackPanel></WrapPanel>
       <TextBlock x:Name="LocaleError" Style="{StaticResource FieldError}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Refresh and organization" Style="{StaticResource CardTitle}"/>
       <WrapPanel><CheckBox x:Name="NeverRefresh" Content="Never refresh automatically" Margin="-4,6,18,6"/><TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="RefreshLess" Content="&#xE738;" Style="{StaticResource IconButton}" FontSize="11" Click="ChangeRefreshDays" AutomationProperties.Name="Decrease refresh days" Margin="0,6,4,12" VerticalAlignment="Center"/>
        <TextBox x:Name="MetadataRefreshDays" Width="60" TextAlignment="Center" AutomationProperties.Name="Refresh interval in days" MaxLength="3" VerticalAlignment="Center"/>
        <Button x:Name="RefreshMore" Content="&#xE710;" Style="{StaticResource IconButton}" FontSize="11" Click="ChangeRefreshDays" AutomationProperties.Name="Increase refresh days" Margin="4,6,8,12" VerticalAlignment="Center"/>
        <TextBlock Text="days (1–365)" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
       </WrapPanel><TextBlock x:Name="RefreshDaysError" Style="{StaticResource FieldError}"/>
       <CheckBox x:Name="GroupShows" Content="Combine show folders when provider IDs match"/><CheckBox x:Name="ImportMissing" Content="Show missing episodes"/><CheckBox x:Name="ImportUpcoming" Content="Show upcoming episodes"/><CheckBox x:Name="DisplaySpecials" Content="Show specials within their aired seasons when placement is known"/><CheckBox x:Name="SaveNfo" Content="Save metadata beside videos as NFO files"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="TMDB key override" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Optional personal key; leave blank to use the bundled WatchRoom key." Style="{StaticResource Hint}"/><PasswordBox x:Name="MetadataToken" AutomationProperties.Name="TMDB API key or read access token" PasswordChanged="MetadataKeyChanged"/>
       <TextBlock x:Name="MetadataKeyStatus" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
       <TextBlock Text="Save changes stores the key in Windows Credential Manager. Clear it and save to remove it." Style="{StaticResource Hint}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Manual refresh" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/><TextBlock Text="Uses saved preferences." Style="{StaticResource Hint}"/>
       <WrapPanel Margin="0,8,0,-8"><ComboBox x:Name="MetadataRefreshMode" SelectedIndex="0" MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="Metadata refresh action"><ComboBoxItem Content="Fill missing metadata"/><ComboBoxItem Content="Refresh text metadata"/><ComboBoxItem Content="Refresh text and replace downloaded artwork"/><ComboBoxItem Content="Retry missing artwork"/></ComboBox>
       <Button Content="Fetch artwork and metadata" Click="FetchArtworkClick" HorizontalAlignment="Left"/></WrapPanel>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="PlaybackPreferences" Tag="Playback" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,0,12" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Languages" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="Watchroom picks the first language each video has, in this order." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Audio" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0"/>
        <local:LanguagePriorityPicker Grid.Column="1" x:Name="PreferredAudioLanguages" AutomationProperties.Name="Preferred audio languages in priority order" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Subtitles" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0"/>
        <local:LanguagePriorityPicker Grid.Row="1" Grid.Column="1" x:Name="PreferredSubtitleLanguages" AllowOff="True" AutomationProperties.Name="Default subtitle languages in priority order"/>
       </Grid>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Subtitle exceptions" Style="{StaticResource FieldLabel}"/>
         <TextBlock Text="Override the subtitle list for specific audio languages — for example, when the audio is English, show no subtitles." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
         <ItemsControl x:Name="SubtitleLanguageRules" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate>
          <!-- Each exception reads as a sentence: when the audio is X, show subtitles in Y. -->
          <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10,8,6" Margin="0,0,0,8">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="When the audio is" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,7,0,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{x:Static local:LanguagePriorityPicker.AudioOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding AudioLanguage, UpdateSourceTrigger=PropertyChanged}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AutomationProperties.Name="Audio language for subtitle rule" ToolTip="When the audio is in this language" Width="200" Height="32" MinHeight="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,8"/>
            <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource QuietIcon}" FontSize="12" Click="RemoveSubtitleRule" ToolTip="Remove exception" AutomationProperties.Name="Remove subtitle language rule" VerticalAlignment="Top" Width="32" Height="32" MinHeight="32" Margin="6,0,0,0"/>
            <TextBlock Grid.Row="1" Text="Show subtitles in" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,7,0,0"/>
            <local:LanguagePriorityPicker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SubtitleLanguages, UpdateSourceTrigger=PropertyChanged}" AllowOff="True" EmptyText="Nothing chosen yet" AutomationProperties.Name="Subtitle languages for audio language in priority order"/>
           </Grid>
          </Border>         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <Button x:Name="AddSubtitleRuleButton" Content="Add exception" Style="{StaticResource QuietButton}" ContentTemplate="{StaticResource AddContent}" Click="AddSubtitleRule" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
        </StackPanel>
       </Border>
       <Expander Header="How language preferences work" Foreground="{DynamicResource Muted}" Margin="-6,8,0,0"><TextBlock Text="Each list is tried in order until the video has a matching track; an empty list uses the video's own defaults. Exceptions follow the selected audio language, and adding Off last turns subtitles off when nothing matches. Manual subtitle choices last until the next video. Saved preferences apply to the next video; guests follow the host’s tracks." Style="{StaticResource Hint}" Margin="0,4,0,0"/></Expander>
