       <TextBlock x:Name="DetailTitle" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <TextBlock x:Name="DetailMeta" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,24"/>
       <WrapPanel><Button x:Name="DetailPlay" Content="Play locally" Style="{StaticResource Primary}" ContentTemplate="{StaticResource PlayContent}" Padding="20,8" Click="PlayLocal"/><Button x:Name="RestartButton" Content="Start over" Click="RestartLocal" Visibility="Collapsed"/><Button x:Name="DetailHost" Content="Watch together" ContentTemplate="{StaticResource PeopleContent}" Click="HostClick"/><Button x:Name="DetailQueue" Content="Add to queue" ContentTemplate="{StaticResource AddContent}" Click="QueueClick"/><Button x:Name="DetailWatched" Click="ToggleDetailWatched" ToolTip="Mark as watched" AutomationProperties.Name="Mark as watched"><StackPanel Orientation="Horizontal"><TextBlock x:Name="DetailWatchedIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/><TextBlock x:Name="DetailWatchedText" Text="Mark as watched" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DetailRemove" Content="Remove from library" Click="RemoveUnavailableVideo" Visibility="Collapsed" ToolTip="Remove the saved entry for this unavailable video"/></WrapPanel>
       <TextBlock x:Name="DetailAvailability" Visibility="Collapsed" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="DetailSummary" Margin="0,16,0,0" Style="{StaticResource MutedText}" FontSize="15" LineHeight="24" MaxWidth="720" HorizontalAlignment="Left"/>
       <ComboBox x:Name="Episodes" DisplayMemberPath="Caption" SelectionChanged="EpisodeChanged" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      </StackPanel>
