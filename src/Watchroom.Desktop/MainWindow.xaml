   </ScrollViewer>

   <!-- Library -->
   <Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="LocalLibraryHeader"><TextBlock x:Name="GuestLibraryStatus" Visibility="Collapsed" Style="{StaticResource MutedText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
     <Border x:Name="HostLibraryActivity" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,6" Margin="0,0,0,12">
      <DockPanel><Button x:Name="BrowseWithGuestButton" DockPanel.Dock="Right" Click="BrowseWithGuest" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed"/><Button DockPanel.Dock="Right" Content="Permissions" Click="OpenLibraryPermissions" Padding="12,0" Margin="8,0,0,0"/><TextBlock Text="&#xE716;" DockPanel.Dock="Left" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock x:Name="HostLibraryActivityText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel>
     </Border>
     <Grid x:Name="LibraryToolbar" Height="40" Margin="0,0,0,14" SizeChanged="LibraryToolbarSizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="SearchFrame" MouseLeftButtonDown="SearchFrameClick" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="10" Padding="14,0,8,0" HorizontalAlignment="Stretch" Cursor="IBeam">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" IsHitTestVisible="False"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" MinHeight="0" TextChanged="SearchChanged" ToolTip="Search your library (Ctrl+F)" AutomationProperties.Name="Search library" VerticalContentAlignment="Center" Margin="0" Padding="0" Background="Transparent" BorderThickness="0">
         <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></TextBox.Template>
        </TextBox>
        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search your library" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Elevated}" CornerRadius="5" Padding="6,2" Margin="0,0,2,0" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Muted}"/></Border>
        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="&#xE711;" Click="ClearSearch" ToolTip="Clear search" AutomationProperties.Name="Clear search" Style="{StaticResource QuietIcon}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" MinHeight="0" Margin="0" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <ComboBox x:Name="LibraryStatusFilter" Grid.Column="1" Width="180" Height="40" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter library" ToolTip="Filter by artwork or watch progress" Margin="10,0,10,0"><ComboBoxItem Content="All watch states"/><ComboBoxItem Content="Needs artwork"/><ComboBoxItem Content="Continue watching"/><ComboBoxItem Content="Unwatched"/><ComboBoxItem Content="Watched"/><ComboBoxItem Content="Missing"/><ComboBoxItem Content="Upcoming"/></ComboBox>
      <Button x:Name="RescanButton" Grid.Column="2" Width="112" Height="40" MinHeight="0" Padding="12,0" Content="Rescan" Click="ScanClick" Margin="0" ToolTip="Check your folders for new videos"/>
