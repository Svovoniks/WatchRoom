      <WrapPanel><StackPanel Width="270" Margin="0,0,12,0"><TextBlock Text="Language"/><ComboBox x:Name="MetadataLanguage" AutomationProperties.Name="Metadata language" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/></StackPanel><StackPanel Width="270"><TextBlock Text="Country"/><ComboBox x:Name="MetadataCountry" AutomationProperties.Name="Metadata country" DisplayMemberPath="Name" SelectedValuePath="Code" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/></StackPanel></WrapPanel>
      <TextBlock Text="Type a country's or language's name while its selector is focused to find it." Style="{StaticResource MutedText}"/>
      <TextBlock x:Name="LocaleError" Style="{StaticResource FieldError}"/>
      <TextBlock Text="Refresh frequency" FontWeight="SemiBold" Margin="0,18,0,8"/>
